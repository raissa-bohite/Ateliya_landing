---
import Icon from "../components/Icon.astro";
import { features } from "../data/data";
import "../styles/global.css";
---

<section
  id="features"
  class="relative overflow-hidden"
  style="background-color: #D4F1F0; min-height: 100vh; display: flex; align-items: center;"
>
  <!-- African Mudcloth Pattern -->
  <div
    class="absolute inset-0 pointer-events-none opacity-[0.02]"
    style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 1200 600%22><defs><pattern id=%22features-pattern%22 patternUnits=%22userSpaceOnUse%22 width=%22120%22 height=%22120%22><circle cx=%2260%22 cy=%2260%22 r=%222%22 fill=%22%230D6B5F%22/><circle cx=%2290%22 cy=%2290%22 r=%221%22 fill=%22%23D4AF37%22/><line x1=%2260%22 y1=%2260%22 x2=%2290%22 y2=%2290%22 stroke=%22%2334C7B8%22 stroke-width=%220.5%22/></pattern></defs><rect width=%221200%22 height=%22600%22 fill=%22url(%23features-pattern)%22/></svg>');"
  >
  </div>

  <div
    class="absolute inset-0 pointer-events-none opacity-[0.03]"
    style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 1200 600%22><defs><pattern id=%22etapes-pattern%22 patternUnits=%22userSpaceOnUse%22 width=%22100%22 height=%22100%22><path d=%22M50,0 Q75,25 50,50 Q25,75 0,50 Q25,25 50,0%22 fill=%22none%22 stroke=%22%230D6B5F%22 stroke-width=%220.5%22/></pattern></defs><rect width=%221200%22 height=%22600%22 fill=%22url(%23etapes-pattern)%22/></svg>');"
  >
  </div>

  <!-- Animated Background Gradient Orbs -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div
      class="absolute top-0 right-1/3 w-96 h-96 bg-ateliya-primary/8 rounded-full blur-3xl"
    >
    </div>
    <div
      class="absolute bottom-0 left-1/4 w-96 h-96 bg-ateliya-primary/6 rounded-full blur-3xl"
    >
    </div>
    <div
      class="absolute top-1/2 right-0 w-80 h-80 bg-ateliya-accent/5 rounded-full blur-3xl"
    >
    </div>
  </div>

  <div class="container-wide relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-center">
      <!-- Left Section: Title & Description -->
      <div class="animate-fade-in space-y-8">
        <div class="space-y-4">
          <h2
            class="text-4xl md:text-5xl font-black text-ateliya-dark leading-tight"
          >
            Découvrez les <span
              class="text-transparent bg-clip-text bg-gradient-to-r from-ateliya-primary to-ateliya-secondary"
              >Fonctionnalités</span
            > d'<span
              class="text-transparent bg-clip-text bg-gradient-to-r from-ateliya-primary to-ateliya-secondary"
              >Ateliya</span
            >
          </h2>
        </div>

        <p class="text-lg text-ateliya-text-light leading-relaxed max-w-md">
          Tous les outils dont vous avez besoin pour gérer votre atelier
          efficacement. De la comptabilité aux paiements, en passant par la
          gestion des commandes et bien plus encore.
        </p>

        <!-- Voir Plus Button -->
        <a
          href="#download"
          class="group inline-flex items-center gap-3 px-8 py-4 rounded-full border-2 border-ateliya-primary/40 hover:border-ateliya-primary/80 hover:bg-ateliya-primary/10 transition-all duration-300 text-ateliya-dark hover:text-ateliya-primary font-bold w-fit"
        >
          <span>Voir Toutes les Fonctionnalités</span>
          <Icon
            name="arrowRight"
            size="md"
            class="group-hover:translate-x-1 transition-transform duration-300"
          />
        </a>
      </div>

      <!-- Center Section: Mockup -->
      <div
        class="animate-bounce flex items-center justify-center"
        style="animation-duration: 3s;"
      >
        <div class="group relative">
          <!-- Glow Effect -->
          <div
            class="absolute -inset-2 bg-gradient-to-br from-ateliya-primary/40 to-ateliya-accent/20 rounded-3xl blur-2xl opacity-60 group-hover:opacity-100 transition-all duration-500 -z-10"
          >
          </div>

          <!-- Mockup Placeholder -->
          <img
            src="/Accounting-mobile.webp"
            alt="Ateliya - Gestion complète d'atelier"
            class="w-full max-w-xs h-auto drop-shadow-2xl"
            style="filter: drop-shadow(0 0 40px rgba(0, 186, 255, 0.2));"
          />
        </div>
      </div>

      <!-- Right Section: Features Grid -->
      <div class="space-y-6">
        {
          features.map((solution, i) => (
            <div
              class="animate-slide-up group"
              style={{ animationDelay: `${i * 100}ms` }}
            >
              <div class="relative">
                <div class="absolute -inset-1 bg-gradient-to-r from-ateliya-primary/30 to-ateliya-primary/10 rounded-xl blur opacity-0 group-hover:opacity-100 transition-all duration-500 -z-10" />

                <div class="bg-white/80 backdrop-blur-lg border border-ateliya-primary/20 group-hover:border-ateliya-primary/50 rounded-xl p-6 transition-all duration-300 hover:shadow-lg hover:bg-white/90">
                  <div class="flex items-center gap-4 mb-3">
                    <div class="flex-shrink-0">
                      <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-gradient-to-br from-ateliya-primary to-ateliya-secondary text-white">
                        <Icon name={solution.icon} size="md" />
                      </div>
                    </div>

                    <h3 class="text-lg font-bold text-ateliya-dark group-hover:text-ateliya-primary transition-colors duration-300">
                      {solution.title}
                    </h3>
                  </div>

                  <p class="text-ateliya-text-light text-sm leading-relaxed">
                    {solution.description}
                  </p>

                  <div class="absolute bottom-0 left-0 h-0.5 w-0 bg-gradient-to-r from-ateliya-primary to-ateliya-secondary group-hover:w-full transition-all duration-500 rounded-full" />
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.8s ease-out;
  }

  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-slide-up {
    animation: slide-up 0.6s ease-out forwards;
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  .animate-bounce {
    animation: bounce 3s ease-in-out infinite;
  }

  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
