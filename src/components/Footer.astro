---
import { Image } from 'astro:assets';
import { socials, navLinks, legalLinks } from "../data/footer";
import logoImg from '../assets/ateliya.webp';
---

<footer
  class="relative overflow-hidden border-t border-ateliya-primary/10 bg-gray-50 text-gray-900"
>
  <div
    class="absolute right-0 top-0 h-72 w-72 rounded-full bg-ateliya-primary/[0.025]"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 h-64 w-64 rounded-full bg-ateliya-primary/[0.02]"
  >
  </div>
  <div
    class="absolute inset-0 opacity-[0.014]"
    style="background-image: radial-gradient(circle, #2FAFA4 1px, transparent 1px); background-size: 36px 36px;"
  >
  </div>

  <!-- Top accent -->
  <div
    class="relative z-10 h-px bg-ateliya-primary/10"
  >
  </div>

  <div
    class="container mx-auto px-6 lg:px-10 relative z-10 pt-16 md:pt-20 pb-8"
  >
    <!-- ---- MAIN GRID ---- -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8 mb-12 pb-12 border-b border-ateliya-primary/10"
    >
      <!-- Brand -->
      <div class="lg:col-span-4">
        <a href="/" class="inline-flex items-center gap-3 mb-6 group">
          <Image
            src={logoImg}
            alt="Ateliya"
            width={44}
            height={44}
            class="rounded-xl shadow-[0_6px_16px_rgba(18,63,59,0.045)] group-hover:scale-[1.01] transition-transform duration-300"
            loading="lazy"
          />
          <span
            class="text-2xl font-semibold tracking-tight text-gray-900 group-hover:text-ateliya-primary transition-colors duration-300"
          >
            Ateliya
          </span>
        </a>

        <p class="text-gray-500 leading-relaxed mb-8 max-w-sm text-sm tracking-wide">
          La solution moderne pour gerer votre atelier de couture efficacement
          et professionnellement.
        </p>

        <!-- Social -->
        <div class="flex gap-2.5">
          {
            socials.map((social) => (
              <a
                href={social.href}
                class="footer-social w-10 h-10 flex items-center justify-center rounded-xl bg-white/[0.94] border border-ateliya-border/[0.55] text-gray-500 shadow-[0_6px_16px_rgba(18,63,59,0.035)] hover:text-ateliya-primary hover:bg-white hover:border-ateliya-primary/[0.22] hover:-translate-y-px transition-all duration-300"
                aria-label={social.name}
                set:html={social.svg}
              />
            ))
          }
        </div>
      </div>

      <!-- Navigation -->
      <div class="lg:col-span-2">
        <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-[0.18em] mb-5">
          Navigation
        </h3>
        <ul class="space-y-3">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="group flex items-center gap-2.5 text-sm font-medium text-gray-500 hover:text-ateliya-primary transition-colors duration-300"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-ateliya-primary/20 group-hover:bg-ateliya-primary group-hover:scale-125 transition-all duration-300" />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Legal -->
      <div class="lg:col-span-2">
        <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-[0.18em] mb-5">
          Legal
        </h3>
        <ul class="space-y-3">
          {
            legalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="group flex items-center gap-2.5 text-sm font-medium text-gray-500 hover:text-ateliya-primary transition-colors duration-300"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-ateliya-primary/20 group-hover:bg-ateliya-primary group-hover:scale-125 transition-all duration-300" />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Newsletter -->
      <div class="lg:col-span-4">
        <div
          class="rounded-[1.5rem] border border-ateliya-border/[0.55] bg-white p-5 shadow-[0_8px_20px_rgba(18,63,59,0.035)]"
        >
        <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-[0.18em] mb-3">
          Newsletter
        </h3>
        <p class="text-sm text-gray-500 mb-5">
          Recevez nos conseils et offres exclusives.
        </p>

        <form class="space-y-3" id="newsletter-form">
          <div class="footer-newsletter-group relative">
            <input
              type="email"
              placeholder="Votre email"
              required
              class="footer-input"
              aria-label="Email pour newsletter"
            />
            <button type="submit" class="footer-submit" id="newsletter-btn">
              S'abonner
            </button>
          </div>
        </form>

        <p class="text-xs text-gray-400 mt-3">
          Desabonnement possible a tout moment.
        </p>
        </div>
      </div>
    </div>

    <!-- ---- BOTTOM ---- -->
    <div class="flex justify-center">
      <p class="text-sm text-gray-400">
        &copy; {new Date().getFullYear()} Ateliya. Tous droits reserves.
      </p>
    </div>
  </div>

</footer>

<style>
  /* ---- Newsletter input group ---- */
  .footer-newsletter-group {
    display: flex;
    gap: 0;
    border-radius: 0.875rem;
    border: 1.5px solid rgba(47, 175, 164, 0.34);
    background: rgba(255, 255, 255, 0.96);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.9) inset,
      0 10px 28px rgba(18, 63, 59, 0.05);
    overflow: hidden;
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      background 0.3s ease;
  }

  .footer-newsletter-group:focus-within {
    border-color: rgba(47, 175, 164, 0.62);
    background: #ffffff;
    box-shadow:
      0 0 0 4px rgba(47, 175, 164, 0.1),
      0 14px 32px rgba(18, 63, 59, 0.07);
  }

  .footer-input {
    flex: 1;
    padding: 0.75rem 1rem;
    background: transparent;
    border: none;
    color: #123f3b;
    font-size: 0.875rem;
    outline: none;
  }

  .footer-input::placeholder {
    color: #94a3b8;
  }

  .footer-submit {
    flex-shrink: 0;
    padding: 0.75rem 1.25rem;
    background: #2fafa4;
    color: white;
    font-size: 0.8rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition:
      filter 0.3s ease,
      transform 0.2s ease;
  }

  .footer-submit:hover {
    background: #279f95;
  }

  .footer-submit:active {
    transform: scale(0.97);
  }

  /* ---- Social hover ---- */
  .footer-social :global(svg) {
    width: 16px;
    height: 16px;
    transition: transform 0.3s ease;
  }

  .footer-social:hover :global(svg) {
    transform: scale(1.15);
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    /* Newsletter */
    const form = document.getElementById("newsletter-form");
    const btn = document.getElementById("newsletter-btn");

    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      const input = form.querySelector(
        'input[type="email"]',
      ) as HTMLInputElement;
      if (!btn || !input) return;

      const original = btn.textContent;
      btn.textContent = "Inscrit !";
      btn.style.opacity = "0.7";

      setTimeout(() => {
        input.value = "";
        btn.textContent = original;
        btn.style.opacity = "1";
      }, 2000);
    });

  });
</script>
