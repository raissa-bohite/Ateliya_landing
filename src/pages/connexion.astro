---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout
  title="Inscription — Ateliya"
  description="Créez votre compte Ateliya et commencez à gérer votre atelier de couture."
>
  <!-- Fond teal avec cercles décoratifs -->
  <div class="bg">
    <div class="deco deco-1"></div>
    <div class="deco deco-2"></div>
    <div class="deco deco-3"></div>
    <div class="deco deco-4"></div>

    <!-- ══ POPUP SUCCÈS ══ -->
  <div id="success-popup" class="popup-overlay hidden" role="dialog" aria-modal="true">
    <div class="popup-card">
      <div class="popup-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      </div>
      <h3 class="popup-title">Compte créé avec succès !</h3>
      <p class="popup-text">Votre compte a bien été créé. Téléchargez l'application mobile Ateliya pour vous connecter et commencer à gérer votre atelier.</p>
      <div class="popup-actions">
        <button id="popup-close" class="popup-btn-secondary">Fermer</button>
        <a href="/" class="popup-btn">
          Retour à l'accueil
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Barre logo -->
    <div class="top-bar">
      <a href="/" class="top-logo">
        <img src="/ateliya.webp" alt="Ateliya" width="26" height="26" />
        <span>Ateliya</span>
      </a>
    </div>

    <!-- Deux cartes côte à côte -->
    <div class="two-cols">

      <!-- CARTE GAUCHE : message d'accueil -->
      <div class="card card-left">
        <div class="welcome-inner">
          <div class="welcome-badge">✦ Essai gratuit 14 jours</div>
          <h2 class="welcome-title">Gérez votre atelier comme un pro.</h2>
          <p class="welcome-text">Rejoignez des centaines d'artisans qui font confiance à Ateliya pour piloter leur activité au quotidien.</p>
          <ul class="welcome-features">
            <li>
              <span class="wf-check">✓</span>
              Gestion clients & prises de mesures
            </li>
            <li>
              <span class="wf-check">✓</span>
              Suivi des commandes en temps réel
            </li>
            <li>
              <span class="wf-check">✓</span>
              Facturation & paiements simplifiés
            </li>
            <li>
              <span class="wf-check">✓</span>
              Application mobile incluse
            </li>
          </ul>
          <div class="welcome-footer">
            <div class="stars">★★★★★</div>
            <p class="stars-label">Noté 4.8 · Aucune carte bancaire requise</p>
          </div>
        </div>
      </div>

      <!-- CARTE DROITE : formulaire -->
      <div class="card card-right" id="form-wrap">

      <!-- Titre -->
      <h1 class="card-title">Créer votre compte</h1>

      <!-- Stepper -->
      <div class="stepper">
        <div class="step active" id="step-dot-1">
          <div class="step-circle"><span>1</span></div>
          <p class="step-label">Entreprise</p>
        </div>
        <div class="step-line" id="line-1"></div>
        <div class="step" id="step-dot-2">
          <div class="step-circle"><span>2</span></div>
          <p class="step-label">Administrateur</p>
        </div>
        <div class="step-line" id="line-2"></div>
        <div class="step" id="step-dot-3">
          <div class="step-circle"><span>3</span></div>
          <p class="step-label">Confirmation</p>
        </div>
      </div>

      <!-- Alertes erreur uniquement -->

      <div id="error-message" class="alert alert-err hidden">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
        <span id="error-text">Une erreur est survenue.</span>
      </div>

      <form id="register-form" novalidate>

        <!-- ══ ÉTAPE 1 : ENTREPRISE ══ -->
        <div class="form-step active" id="step-1">
          <h2 class="step-title">Informations entreprise</h2>

          <div class="field">
            <label for="denominationEntreprise" class="label">Nom de l'entreprise <em>*</em></label>
            <input id="denominationEntreprise" name="denominationEntreprise" type="text" class="input" placeholder="Ex: Fashion Boutique CI" required maxlength="100" autocomplete="organization" />
          </div>

          <div class="field">
            <label for="pays" class="label">Pays <em>*</em></label>
            <div class="select-wrap">
              <select id="pays" name="pays" class="input input-select" required>
                <option value="" disabled selected>Sélectionnez un pays</option>
              </select>
              <svg class="chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </div>
            <div id="pays-loading" class="hint hidden">
              <svg class="spin-icon" xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
              Chargement des pays…
            </div>
          </div>

          <div class="row-2">
            <div class="field">
              <label for="emailEntreprise" class="label">Email entreprise <em>*</em></label>
              <input id="emailEntreprise" name="emailEntreprise" type="email" class="input" placeholder="contact@boutique.com" required maxlength="100" autocomplete="email" />
            </div>
            <div class="field">
              <label for="numeroEntreprise" class="label">Téléphone <em>*</em></label>
              <div class="phone-wrap">
                <span id="phone-prefix" class="phone-code">+--</span>
                <input id="numeroEntreprise" name="numeroEntreprise" type="tel" class="input input-phone" placeholder="XX XX XX XX" required maxlength="20" autocomplete="tel-national" inputmode="tel" />
              </div>
            </div>
          </div>

          <!-- Code de parrainage -->
          <div class="field">
            <label for="codeParrain" class="label">
              Code de parrainage
              <span class="label-opt">(optionnel)</span>
            </label>
            <input
              id="codeParrain"
              name="codeParrain"
              type="text"
              class="input"
              placeholder="Ex: ATL-XXXX"
              maxlength="32"
              autocomplete="off"
            />
          </div>

          <div class="step-actions">
            <span></span>
            <button type="button" class="btn-next" id="btn-next-1">
              Suivant
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </button>
          </div>
        </div>

        <!-- ══ ÉTAPE 2 : ADMIN ══ -->
        <div class="form-step" id="step-2">
          <h2 class="step-title">Compte administrateur</h2>

          <div class="field">
            <label for="email" class="label">Email de connexion <em>*</em></label>
            <input id="email" name="email" type="email" class="input" placeholder="admin@boutique.com" required maxlength="100" autocomplete="username" />
          </div>

          <div class="row-2">
            <div class="field">
              <label for="password" class="label">Mot de passe <em>*</em></label>
              <div class="pw-wrap">
                <input id="password" name="password" type="password" class="input" placeholder="Min. 8 caractères" required minlength="8" maxlength="128" autocomplete="new-password" />
                <button type="button" class="eye-btn" data-target="password" aria-label="Afficher/masquer">
                  <svg class="eye-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
              </div>
            </div>
            <div class="field">
              <label for="confirmPassword" class="label">Confirmation <em>*</em></label>
              <div class="pw-wrap">
                <input id="confirmPassword" name="confirmPassword" type="password" class="input" placeholder="Confirmez" required maxlength="128" autocomplete="new-password" />
                <button type="button" class="eye-btn" data-target="confirmPassword" aria-label="Afficher/masquer">
                  <svg class="eye-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Force du mot de passe -->
          <div class="pw-meter">
            <div class="pw-track"><div class="pw-fill" id="pw-fill"></div></div>
            <span class="pw-label" id="pw-label">Min. 8 caractères</span>
          </div>

          <div class="step-actions">
            <button type="button" class="btn-back" id="btn-back-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
              Précédent
            </button>
            <button type="button" class="btn-next" id="btn-next-2">
              Suivant
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </button>
          </div>
        </div>

        <!-- ══ ÉTAPE 3 : CONFIRMATION ══ -->
        <div class="form-step" id="step-3">
          <h2 class="step-title">Vérification</h2>
          <p class="step-desc">Vérifiez vos informations avant de créer le compte.</p>

          <div class="recap">
            <div class="recap-group">
              <p class="recap-section">Entreprise</p>
              <div class="recap-row"><span class="recap-key">Nom</span><span class="recap-val" id="rc-nom">—</span></div>
              <div class="recap-row"><span class="recap-key">Pays</span><span class="recap-val" id="rc-pays">—</span></div>
              <div class="recap-row"><span class="recap-key">Email</span><span class="recap-val" id="rc-email-ent">—</span></div>
              <div class="recap-row"><span class="recap-key">Téléphone</span><span class="recap-val" id="rc-tel">—</span></div>
            </div>
            <div class="recap-group">
              <p class="recap-section">Administrateur</p>
              <div class="recap-row"><span class="recap-key">Email</span><span class="recap-val" id="rc-email-adm">—</span></div>
              <div class="recap-row"><span class="recap-key">Mot de passe</span><span class="recap-val">••••••••</span></div>
            </div>
          </div>

          <div class="step-actions">
            <button type="button" class="btn-back" id="btn-back-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
              Précédent
            </button>
            <button type="submit" id="submit-btn" class="btn-next">
              <span class="btn-shine"></span>
              <span id="submit-text">Créer mon compte</span>
              <svg id="submit-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              <svg id="submit-spinner" class="btn-spin hidden" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
            </button>
          </div>
        </div>

      </form>

      <!-- Legal -->
      <p class="legal">
        En créant un compte, vous acceptez nos
        <a href="/conditions">Conditions</a> et notre
        <a href="/politique">Politique de confidentialité</a>.
      </p>

    </div><!-- fin card-right -->
    </div><!-- fin two-cols -->
  </div><!-- fin bg -->
</Layout>

<script>
  interface PaysItem { id: number; libelle: string; code: string; indicatif: string; }
  let paysData: PaysItem[] = [];
  let isSubmitting = false;
  let currentStep = 1;

  const form        = document.getElementById("register-form") as HTMLFormElement;
  const paysSelect  = document.getElementById("pays") as HTMLSelectElement;
  const phonePrefix = document.getElementById("phone-prefix") as HTMLElement;
  const paysLoading = document.getElementById("pays-loading") as HTMLElement;
  const submitBtn   = document.getElementById("submit-btn") as HTMLButtonElement;
  const submitText  = document.getElementById("submit-text") as HTMLElement;
  const submitArrow = document.getElementById("submit-arrow") as HTMLElement;
  const submitSpinner = document.getElementById("submit-spinner") as HTMLElement;
  const successPopup = document.getElementById("success-popup") as HTMLElement;
  document.getElementById("popup-close")?.addEventListener("click", () => {
    successPopup.classList.add("hidden");
  });
  const errorMsg    = document.getElementById("error-message") as HTMLElement;
  const errorText   = document.getElementById("error-text") as HTMLElement;
  const pwFill      = document.getElementById("pw-fill") as HTMLElement;
  const pwLabel     = document.getElementById("pw-label") as HTMLElement;
  const pwInput     = document.getElementById("password") as HTMLInputElement;

  const EMAIL_RE = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$/;
  const PHONE_RE = /^\+?[\d\s\-().]{5,20}$/;

  // ── Stepper ──
  function goToStep(n: number) {
    document.querySelectorAll<HTMLElement>(".form-step").forEach(el => el.classList.remove("active"));
    document.querySelectorAll<HTMLElement>(".step").forEach(el => el.classList.remove("active", "done"));
    document.querySelectorAll<HTMLElement>(".step-line").forEach(el => el.classList.remove("done"));

    const target = document.getElementById(`step-${n}`);
    if (target) target.classList.add("active");

    for (let i = 1; i <= 3; i++) {
      const dot = document.getElementById(`step-dot-${i}`);
      if (!dot) continue;
      if (i < n)  { dot.classList.add("done"); }
      if (i === n){ dot.classList.add("active"); }
    }
    for (let i = 1; i <= 2; i++) {
      const line = document.getElementById(`line-${i}`);
      if (line && i < n) line.classList.add("done");
    }
    currentStep = n;
    hideMessages();
  }

  // ── Validation étape 1 ──
  function validateStep1(): string | null {
    const denom = (document.getElementById("denominationEntreprise") as HTMLInputElement).value.trim();
    const emailEnt = (document.getElementById("emailEntreprise") as HTMLInputElement).value.trim();
    const tel = (document.getElementById("numeroEntreprise") as HTMLInputElement).value.trim();
    const pays = (document.getElementById("pays") as HTMLSelectElement).value;
    if (!denom) return "Le nom de l'entreprise est obligatoire.";
    if (!emailEnt || !EMAIL_RE.test(emailEnt)) return "L'email de l'entreprise n'est pas valide.";
    if (!tel || !PHONE_RE.test(tel)) return "Le numéro de téléphone n'est pas valide.";
    if (!pays || isNaN(Number(pays))) return "Veuillez sélectionner un pays.";
    return null;
  }

  // ── Validation étape 2 ──
  function validateStep2(): string | null {
    const email = (document.getElementById("email") as HTMLInputElement).value.trim();
    const pw = (document.getElementById("password") as HTMLInputElement).value;
    const cpw = (document.getElementById("confirmPassword") as HTMLInputElement).value;
    if (!email || !EMAIL_RE.test(email)) return "L'email de connexion n'est pas valide.";
    if (!pw || pw.length < 8) return "Le mot de passe doit contenir au moins 8 caractères.";
    if (pw !== cpw) return "Les mots de passe ne correspondent pas.";
    return null;
  }

  // ── Recap étape 3 ──
  function fillRecap() {
    (document.getElementById("rc-nom") as HTMLElement).textContent =
      (document.getElementById("denominationEntreprise") as HTMLInputElement).value.trim() || "—";
    const selectedOpt = paysSelect.selectedOptions[0];
    (document.getElementById("rc-pays") as HTMLElement).textContent =
      selectedOpt?.textContent?.trim() || "—";
    (document.getElementById("rc-email-ent") as HTMLElement).textContent =
      (document.getElementById("emailEntreprise") as HTMLInputElement).value.trim() || "—";
    (document.getElementById("rc-tel") as HTMLElement).textContent =
      (phonePrefix.textContent || "") + " " +
      (document.getElementById("numeroEntreprise") as HTMLInputElement).value.trim() || "—";
    (document.getElementById("rc-email-adm") as HTMLElement).textContent =
      (document.getElementById("email") as HTMLInputElement).value.trim() || "—";
  }

  // ── Boutons navigation ──
  document.getElementById("btn-next-1")?.addEventListener("click", () => {
    const err = validateStep1();
    if (err) { showError(err); return; }
    goToStep(2);
  });
  document.getElementById("btn-next-2")?.addEventListener("click", () => {
    const err = validateStep2();
    if (err) { showError(err); return; }
    fillRecap();
    goToStep(3);
  });
  document.getElementById("btn-back-2")?.addEventListener("click", () => goToStep(1));
  document.getElementById("btn-back-3")?.addEventListener("click", () => goToStep(2));

  // ── Force du mot de passe ──
  pwInput?.addEventListener("input", () => {
    const v = pwInput.value;
    let s = 0;
    if (v.length >= 8)          s++;
    if (v.length >= 12)         s++;
    if (/[A-Z]/.test(v))        s++;
    if (/[0-9]/.test(v))        s++;
    if (/[^A-Za-z0-9]/.test(v)) s++;
    const c = ["#ef4444","#f97316","#eab308","#22c55e","#0d6b5f"];
    const l = ["Très faible","Faible","Moyen","Fort","Très fort"];
    const p = Math.min(s, 5) * 20;
    pwFill.style.width      = p + "%";
    pwFill.style.background = c[Math.min(s, 4)];
    pwLabel.textContent     = v.length === 0 ? "Min. 8 caractères" : l[Math.min(s, 4)];
    pwLabel.style.color     = v.length === 0 ? "#9ca3af" : c[Math.min(s, 4)];
  });

  // ── Oeil ──
  const EYE_OPEN = `<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>`;
  const EYE_SHUT = `<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" x2="23" y1="1" y2="23"/>`;
  document.querySelectorAll<HTMLButtonElement>(".eye-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      const tid = btn.dataset.target;
      if (!tid) return;
      const inp = document.getElementById(tid) as HTMLInputElement|null;
      if (!inp) return;
      const show = inp.type === "password";
      inp.type = show ? "text" : "password";
      const icon = btn.querySelector<SVGElement>(".eye-icon");
      if (icon) icon.innerHTML = show ? EYE_SHUT : EYE_OPEN;
    });
  });

  // ── Pays ──
  paysSelect.addEventListener("change", () => {
    phonePrefix.textContent = paysSelect.selectedOptions[0]?.dataset.indicatif || "+--";
  });

  async function loadPays() {
    paysLoading.classList.remove("hidden");
    try {
      const res  = await fetch("https://backend.ateliya.com/api/pays/actif");
      if (!res.ok) throw new Error();
      const json = await res.json();
      paysData   = (json.data || []) as PaysItem[];
      paysSelect.innerHTML = '<option value="" disabled selected>Sélectionnez un pays</option>';
      paysData.forEach(p => {
        const opt = document.createElement("option");
        opt.value = String(Number(p.id));
        opt.textContent = String(p.libelle).slice(0, 60);
        opt.dataset.indicatif = String(p.indicatif).slice(0, 10);
        paysSelect.appendChild(opt);
      });
    } catch {
      const opt = document.createElement("option");
      opt.value = ""; opt.textContent = "Erreur de chargement"; opt.disabled = true;
      paysSelect.appendChild(opt);
    } finally {
      paysLoading.classList.add("hidden");
    }
  }

  function showError(msg: string) {
    errorText.textContent = msg;
    errorMsg.classList.remove("hidden");
    errorMsg.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }
  function hideMessages() {
    errorMsg.classList.add("hidden");
  }

  function setLoading(on: boolean) {
    submitBtn.disabled = on;
    submitArrow.classList.toggle("hidden", on);
    submitSpinner.classList.toggle("hidden", !on);
    submitText.textContent = on ? "Création en cours…" : "Créer mon compte";
  }

  form.addEventListener("submit", async e => {
    e.preventDefault();
    if (isSubmitting) return;
    isSubmitting = true;
    setLoading(true);
    hideMessages();

    const data   = new FormData(form);
    const fields = {
      denominationEntreprise: ((data.get("denominationEntreprise") as string) ?? "").trim(),
      emailEntreprise:        ((data.get("emailEntreprise") as string) ?? "").trim().toLowerCase(),
      numeroEntreprise:       ((data.get("numeroEntreprise") as string) ?? "").trim(),
      pays:                   ((data.get("pays") as string) ?? "").trim(),
      email:                  ((data.get("email") as string) ?? "").trim().toLowerCase(),
      password:               (data.get("password") as string) ?? "",
      confirmPassword:        (data.get("confirmPassword") as string) ?? "",
      codeParrain:            ((data.get("codeParrain") as string) ?? "").trim().toUpperCase(),
    };

    try {
      const payload: Record<string, unknown> = {
        email:                  fields.email,
        password:               fields.password,
        confirmPassword:        fields.confirmPassword,
        denominationEntreprise: fields.denominationEntreprise,
        emailEntreprise:        fields.emailEntreprise,
        device:                 "web",
        numeroEntreprise:       fields.numeroEntreprise,
        pays:                   parseInt(fields.pays, 10),
      };
      if (fields.codeParrain) payload.codeParrain = fields.codeParrain;

      const res = await fetch("https://backend.ateliya.com/api/user/create", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      let json: any = {};
      try { json = await res.json(); } catch {}
      if (res.ok && json.code === 200) {
        form.reset();
        phonePrefix.textContent = "+--";
        goToStep(1);
        successPopup.classList.remove("hidden");
      } else {
        showError(
          (typeof json.message === "string" && json.message) ||
          (Array.isArray(json.errors) && typeof json.errors[0] === "string" && json.errors[0]) ||
          `Erreur ${res.status}. Veuillez réessayer.`
        );
      }
    } catch {
      showError("Impossible de contacter le serveur. Vérifiez votre connexion.");
    } finally {
      setLoading(false);
      isSubmitting = false;
    }
  });

  loadPays();
  requestAnimationFrame(() => document.querySelector<HTMLElement>(".two-cols")?.classList.add("visible"));
</script>

