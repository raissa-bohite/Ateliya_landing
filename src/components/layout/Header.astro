---
import { NAV_LINKS } from "../../data/nav";
---

<header
  id="site-header"
  class="site-header fixed inset-x-0 top-0 z-50 transition-[background-color,box-shadow] duration-300"
>
  <div
    class="mx-auto flex h-[72px] max-w-6xl items-center justify-between px-5 lg:px-8"
  >
    <a href="/" class="flex items-center gap-2.5">
      <img src="/ateliya.webp" alt="Ateliya" width="32" height="32" class="rounded-lg" />
      <span class="wordmark font-serif text-lg font-bold tracking-tight">Ateliya</span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex">
      {
        NAV_LINKS.map((link) => (
          <a href={link.href} class="nav-link text-sm font-medium transition-colors">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:block">
      <a
        href="/inscription"
        class="cta inline-flex h-9 items-center rounded-full px-4 text-xs font-semibold transition-colors"
      >
        S'inscrire
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="menu-btn flex h-10 w-10 items-center justify-center rounded-full lg:hidden"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="menu-open h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
      <svg class="menu-close hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M6 18 18 6"></path></svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-border bg-card px-5 py-4 lg:hidden">
    <nav class="flex flex-col gap-1">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="rounded-lg px-3 py-2.5 text-sm font-medium text-text-secondary hover:bg-primary-light/60 hover:text-primary"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <a
      href="/inscription"
      class="mt-3 inline-flex h-9 w-max items-center rounded-full bg-primary px-4 text-xs font-semibold text-white"
    >
      S'inscrire
    </a>
  </div>
</header>

<style>
  /* État "en haut de page" : transparent, texte blanc (sur le hero sombre). */
  .site-header .wordmark,
  .site-header .nav-link {
    color: #fff;
  }
  .site-header .nav-link:hover {
    color: rgba(255, 255, 255, 0.78);
  }
  .site-header .cta {
    background: var(--color-gold);
    color: var(--color-primary-dark);
  }
  .site-header .menu-btn {
    color: #fff;
  }

  /* État "scrollé" : carte opaque, texte foncé. */
  .site-header.is-scrolled {
    background: color-mix(in srgb, var(--color-card) 92%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 24px -8px rgba(7, 31, 20, 0.12);
  }
  .site-header.is-scrolled .wordmark {
    color: var(--color-primary-dark);
  }
  .site-header.is-scrolled .nav-link {
    color: var(--color-text-secondary);
  }
  .site-header.is-scrolled .nav-link:hover {
    color: var(--color-primary);
  }
  .site-header.is-scrolled .cta {
    background: var(--color-primary);
    color: #fff;
  }
  .site-header.is-scrolled .menu-btn {
    color: var(--color-primary-dark);
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const setScrolled = () =>
    header?.classList.toggle("is-scrolled", window.scrollY > 8);
  setScrolled();
  window.addEventListener("scroll", setScrolled, { passive: true });

  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(isOpen));
    toggle.setAttribute("aria-label", isOpen ? "Fermer le menu" : "Ouvrir le menu");
    toggle.querySelector(".menu-open")?.classList.toggle("hidden", isOpen);
    toggle.querySelector(".menu-close")?.classList.toggle("hidden", !isOpen);
  });
</script>
