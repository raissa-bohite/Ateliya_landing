---
import Menu from "lucide-astro/Menu";
import X from "lucide-astro/X";
import ChevronDown from "lucide-astro/ChevronDown";
import ChevronRight from "lucide-astro/ChevronRight";
import ChevronUp from "lucide-astro/ChevronUp";
import ChevronLeft from "lucide-astro/ChevronLeft";
import ArrowRight from "lucide-astro/ArrowRight";
import ArrowLeft from "lucide-astro/ArrowLeft";
import ArrowUp from "lucide-astro/ArrowUp";
import ArrowDown from "lucide-astro/ArrowDown";
import Download from "lucide-astro/Download";
import Upload from "lucide-astro/Upload";
import Search from "lucide-astro/Search";
import Check from "lucide-astro/Check";
import CheckCircle from "lucide-astro/CheckCircle";
import Bell from "lucide-astro/Bell";
import Mail from "lucide-astro/Mail";
import Phone from "lucide-astro/Phone";
import MapPin from "lucide-astro/MapPin";
import MessageCircle from "lucide-astro/MessageCircle";
import BarChart3 from "lucide-astro/BarChart3";
import TrendingUp from "lucide-astro/TrendingUp";
import TrendingDown from "lucide-astro/TrendingDown";
import CreditCard from "lucide-astro/CreditCard";
import ShoppingCart from "lucide-astro/ShoppingCart";
import Package from "lucide-astro/Package";
import Gift from "lucide-astro/Gift";
import Lock from "lucide-astro/Lock";
import Unlock from "lucide-astro/Unlock";
import Key from "lucide-astro/Key";
import Star from "lucide-astro/Star";
import Heart from "lucide-astro/Heart";
import Zap from "lucide-astro/Zap";
import Clock from "lucide-astro/Clock";
import Calendar from "lucide-astro/Calendar";
import User from "lucide-astro/User";
import Users from "lucide-astro/Users";
import UserPlus from "lucide-astro/UserPlus";
import Globe from "lucide-astro/Globe";
import Settings from "lucide-astro/Settings";
import Info from "lucide-astro/Info";
import HelpCircle from "lucide-astro/HelpCircle";
import Eye from "lucide-astro/Eye";
import EyeOff from "lucide-astro/EyeOff";
import AlertCircle from "lucide-astro/AlertCircle";
import AlertTriangle from "lucide-astro/AlertTriangle";
import FileText from "lucide-astro/FileText";
import File from "lucide-astro/File";
import Smartphone from "lucide-astro/Smartphone";
import Smile from "lucide-astro/Smile";
import Frown from "lucide-astro/Frown";
import Ruler from "lucide-astro/Ruler";
import Scissors from "lucide-astro/Scissors";
import BookOpen from "lucide-astro/BookOpen";
import Facebook from "lucide-astro/Facebook";
import Twitter from "lucide-astro/Twitter";
import Instagram from "lucide-astro/Instagram";
import Linkedin from "lucide-astro/Linkedin";
import Image from "lucide-astro/Image";
import PlayCircle from "lucide-astro/PlayCircle";
import Sparkles from "lucide-astro/Sparkles";
import Shield from "lucide-astro/Shield";
import RefreshCw from "lucide-astro/RefreshCw";
import Tag from "lucide-astro/Tag";
import MessageSquare from "lucide-astro/MessageSquare";
import Edit from "lucide-astro/Edit";
import Plus from "lucide-astro/Plus";
import Receipt from "lucide-astro/Receipt";
import PieChart from "lucide-astro/PieChart";
import Share2 from "lucide-astro/Share2";
import Printer from "lucide-astro/Printer";
import Cloud from "lucide-astro/Cloud";
import Activity from "lucide-astro/Activity";
import Headphones from "lucide-astro/Headphones";
import Quote from "lucide-astro/Quote";
import Rocket from "lucide-astro/Rocket";
import Compass from "lucide-astro/Compass";
import type { Props as LucideProps } from "lucide-astro";

export interface Props extends Omit<LucideProps, 'name'> {
  name: string;
  size?: "xs" | "sm" | "md" | "lg" | "xl" | "2xl";
  class?: string;
}

const {
  name,
  size = "md",
  class: customClass = "",
  ...rest
} = Astro.props;

// Size mapping
const sizeMap = {
  xs: 12,
  sm: 16,
  md: 24,
  lg: 32,
  xl: 40,
  "2xl": 48,
};

const iconSize = sizeMap[size as keyof typeof sizeMap] || 24;

// Icon component mapping (kebab-case to PascalCase)
const iconMap: Record<string, any> = {
  // Navigation
  menu: Menu,
  close: X,
  x: X,
  "chevron-down": ChevronDown,
  chevronDown: ChevronDown,
  "chevron-right": ChevronRight,
  chevronRight: ChevronRight,
  "chevron-up": ChevronUp,
  chevronUp: ChevronUp,
  "chevron-left": ChevronLeft,
  chevronLeft: ChevronLeft,
  "arrow-right": ArrowRight,
  arrowRight: ArrowRight,
  "arrow-left": ArrowLeft,
  arrowLeft: ArrowLeft,
  "arrow-up": ArrowUp,
  arrowUp: ArrowUp,
  "arrow-down": ArrowDown,
  arrowDown: ArrowDown,

  // Actions
  download: Download,
  upload: Upload,
  search: Search,
  check: Check,
  "check-circle": CheckCircle,
  checkCircle: CheckCircle,
  bell: Bell,
  mail: Mail,
  phone: Phone,
  "phone-call": Phone,
  "phone-incoming": Phone,
  "map-pin": MapPin,
  mapPin: MapPin,
  "message-circle": MessageCircle,
  messageCircle: MessageCircle,
  "message-square": MessageSquare,
  messageSquare: MessageSquare,

  // Data
  chart: BarChart3,
  "bar-chart": BarChart3,
  barChart: BarChart3,
  trending: TrendingUp,
  "trending-up": TrendingUp,
  trendingUp: TrendingUp,
  "trending-down": TrendingDown,
  trendingDown: TrendingDown,

  // Commerce
  "credit-card": CreditCard,
  creditCard: CreditCard,
  "dollar-sign": CreditCard,
  shoppingCart: ShoppingCart,
  package: Package,
  gift: Gift,
  tag: Tag,

  // Security
  lock: Lock,
  unlocked: Unlock,
  key: Key,
  shield: Shield,
  
  // Misc
  star: Star,
  heart: Heart,
  zap: Zap,
  clock: Clock,
  calendar: Calendar,
  refresh: RefreshCw,
  
  // User
  user: User,
  users: Users,
  "user-plus": UserPlus,
  userPlus: UserPlus,
  
  // System
  globe: Globe,
  settings: Settings,
  info: Info,
  "help-circle": HelpCircle,
  helpCircle: HelpCircle,
  eye: Eye,
  "eye-off": EyeOff,
  eyeOff: EyeOff,
  "alert-circle": AlertCircle,
  alertCircle: AlertCircle,
  "alert-triangle": AlertTriangle,
  "file-text": FileText,
  fileText: FileText,
  file: File,
  smartphone: Smartphone,
  image: Image,
  "play-circle": PlayCircle,
  playCircle: PlayCircle,
  sparkles: Sparkles,
  
  // Tools
  ruler: Ruler,
  measure: Ruler,
  scissors: Scissors,
  bookOpen: BookOpen,
  printer: Printer,
  cloud: Cloud,
  "share-2": Share2,
  activity: Activity,
  headphones: Headphones,
  edit: Edit,
  plus: Plus,
  rocket: Rocket,
  compass: Compass,
  
  // Finance
  receipt: Receipt,
  "pie-chart": PieChart,
  pieChart: PieChart,
  
  // Social
  facebook: Facebook,
  twitter: Twitter,
  instagram: Instagram,
  linkedin: Linkedin,
  
  // Misc Elements
  quote: Quote,
};

// Normalize name to handle potential inconsistencies
const normalizedName = name;
const IconComponent = iconMap[normalizedName] || iconMap[normalizedName.toLowerCase()] || Info;
---

<IconComponent size={iconSize} class={customClass} {...rest} />
