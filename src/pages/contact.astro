---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { contactMethods, socialLinks } from "../data/contact";

const faqContact = [
  {
    question: "Comment nous contacter rapidement ?",
    answer:
      "Le plus rapide : envoyez-nous un message WhatsApp au +225 05 01 24 29 29. Nous repondons generalement en moins d'une heure pendant nos horaires de disponibilite.",
  },
  {
    question: "Proposez-vous des demonstrations ?",
    answer:
      "Oui ! Contactez-nous sur WhatsApp et nous organisons une demo en ligne de l'application Ateliya selon vos disponibilites.",
  },
  {
    question: "Avez-vous un bureau physique ?",
    answer:
      "Non, Ateliya fonctionne entierement en ligne. Tout le support, les demonstrations et l'accompagnement se font via WhatsApp ou par telephone.",
  },
];
---

<Layout title="Contact - Ateliya">
  <Header />

  <main class="bg-white overflow-hidden">
    <section
      class="relative py-12 lg:py-16 overflow-hidden bg-gradient-to-b from-white via-gray-50/30 to-white"
    >
      <div
        class="absolute top-[5%] right-[15%] w-80 h-80 bg-ateliya-primary/[0.035] rounded-full blur-[120px]"
      >
      </div>
      <div
        class="absolute bottom-[10%] left-[10%] w-64 h-64 bg-ateliya-secondary/[0.025] rounded-full blur-[100px]"
      >
      </div>
      <div
        class="absolute inset-0 opacity-[0.014]"
        style="background-image: radial-gradient(circle, #2FAFA4 1px, transparent 1px); background-size: 36px 36px;"
      >
      </div>

      <div class="absolute right-8 top-[6%] grid grid-cols-5 gap-2 opacity-[0.16]">
        {
          [...Array(20)].map((_, i) => (
            <div
              class={`w-1.5 h-1.5 rounded-full ${i % 3 === 0 ? "bg-ateliya-primary" : i % 3 === 1 ? "bg-ateliya-secondary/50" : "bg-gray-300"}`}
            />
          ))
        }
      </div>
      <div
        class="absolute left-8 bottom-[8%] grid grid-cols-4 gap-2.5 opacity-[0.14]"
      >
        {
          [...Array(12)].map((_, i) => (
            <div
              class={`w-1.5 h-1.5 rounded-full ${i % 2 === 0 ? "bg-ateliya-primary/50" : "bg-gray-300"}`}
            />
          ))
        }
      </div>

      <div class="container mx-auto px-6 lg:px-12 max-w-5xl relative z-10">
        <div class="text-center space-y-4">
          <div
            class="inline-flex items-center gap-2 px-4 py-2 bg-ateliya-primary/10 rounded-full"
          >
            <div class="w-2 h-2 rounded-full bg-ateliya-primary animate-pulse">
            </div>
            <span class="text-sm font-bold text-ateliya-primary"
              >Disponible en ligne</span
            >
          </div>

          <h1
            class="text-3xl md:text-4xl lg:text-5xl font-serif font-extrabold tracking-tighter leading-tight text-gray-900"
          >
            <span class="block">Une question ?</span>
            <span
              class="text-transparent bg-clip-text bg-gradient-to-r from-ateliya-secondary to-ateliya-primary"
            >
              Parlons-en
            </span>
          </h1>

          <p class="text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed tracking-wide">
            Tout se passe en ligne. Contactez-nous sur <span
              class="font-bold text-ateliya-primary"
              >WhatsApp ou par telephone</span
            > — nous sommes la pour vous accompagner.
          </p>
        </div>
      </div>
    </section>

    <section class="relative py-4 -mt-6">
      <div class="container mx-auto px-6 lg:px-10 max-w-6xl">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-3xl mx-auto">
          {
            contactMethods.map((method) => (
              <a href={method.href} class="h-full">
                <div class="h-full p-4 rounded-2xl bg-white/[0.96] border border-ateliya-border/[0.55] relative overflow-hidden shadow-[0_6px_16px_rgba(18,63,59,0.035)]">
                  <div class="flex items-center gap-3">
                    <div
                      class={`flex-shrink-0 w-11 h-11 rounded-2xl bg-gradient-to-br ${method.gradient} flex items-center justify-center`}
                    >
                      <Icon name={method.icon} size="md" class="text-white" />
                    </div>
                    <div class="flex-1 min-w-0">
                      <h4 class="text-sm font-black text-gray-900">
                        {method.title}
                      </h4>
                      <p class="text-xs text-gray-500 mt-0.5">
                        {method.description}
                      </p>
                      <p class="text-sm font-bold text-ateliya-primary mt-0.5">
                        {method.value}
                      </p>
                    </div>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="relative py-12 lg:py-16 overflow-hidden">
      <div
        class="absolute top-[20%] right-[5%] w-72 h-72 bg-ateliya-primary/[0.025] rounded-full blur-[120px]"
      >
      </div>
      <div
        class="absolute bottom-[15%] left-[10%] w-56 h-56 bg-ateliya-secondary/[0.025] rounded-full blur-[100px]"
      >
      </div>

      <div class="container mx-auto px-6 lg:px-10 max-w-6xl relative z-10">
        <div class="grid lg:grid-cols-5 gap-8">
          <div class="lg:col-span-3">
            <div class="sticky top-24">
              <div
                class="p-6 md:p-8 rounded-3xl bg-white/[0.96] border border-ateliya-border/[0.55] relative overflow-hidden shadow-[0_12px_32px_rgba(18,63,59,0.055)]"
              >
                <div
                  class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-ateliya-primary via-ateliya-secondary to-ateliya-primary"
                >
                </div>

                <div class="space-y-1.5 mb-8">
                  <h2 class="text-2xl md:text-3xl font-serif font-extrabold tracking-tighter text-gray-900">
                    Contactez-nous directement
                  </h2>
                  <div
                    class="w-16 h-1 bg-gradient-to-r from-ateliya-primary to-ateliya-secondary rounded-full"
                  >
                  </div>
                  <p class="text-gray-500 text-sm leading-relaxed pt-1 tracking-wide">
                    Tout se passe en ligne. Choisissez la methode qui vous
                    convient pour nous joindre.
                  </p>
                </div>

                <div class="space-y-4">
                  <!-- WhatsApp -->
                  <a
                    href="https://wa.me/2250501242929?text=Bonjour%2C%20je%20voudrais%20en%20savoir%20plus%20sur%20Ateliya."
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-4 p-5 rounded-2xl border-2 border-green-100 bg-green-50/50 hover:bg-green-50 hover:border-green-200 transition-all duration-300 group"
                  >
                    <div
                      class="w-14 h-14 rounded-2xl bg-[#25D366] flex items-center justify-center flex-shrink-0 group-hover:-translate-y-0.5 transition-transform duration-300"
                    >
                      <svg
                        width="28"
                        height="28"
                        viewBox="0 0 24 24"
                        fill="white"
                      >
                        <path
                          d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7 8.5 7 9.71C7 10.93 7.89 12.1 8 12.27C8.14 12.44 9.76 14.94 12.25 16C12.84 16.27 13.3 16.42 13.66 16.53C14.25 16.72 14.79 16.69 15.22 16.63C15.7 16.56 16.68 16.03 16.89 15.45C17.1 14.87 17.1 14.38 17.04 14.27C16.97 14.17 16.81 14.11 16.56 14C16.31 13.86 15.09 13.26 14.87 13.18C14.64 13.1 14.5 13.06 14.31 13.3C14.15 13.55 13.67 14.11 13.53 14.27C13.38 14.44 13.24 14.46 13 14.34C12.74 14.21 11.94 13.95 11 13.11C10.26 12.45 9.77 11.64 9.62 11.39C9.5 11.15 9.61 11 9.73 10.89C9.84 10.78 10 10.6 10.1 10.45C10.23 10.31 10.27 10.2 10.35 10.04C10.43 9.87 10.39 9.73 10.33 9.61C10.27 9.5 9.77 8.26 9.56 7.77C9.36 7.29 9.16 7.35 9 7.34C8.86 7.34 8.7 7.33 8.53 7.33Z"
                        ></path>
                      </svg>
                    </div>
                    <div class="flex-1">
                      <div class="flex items-center gap-2 mb-0.5">
                        <p class="font-black text-gray-900">WhatsApp</p>
                        <span
                          class="text-xs font-bold px-2 py-0.5 bg-green-100 text-green-700 rounded-full"
                          >Recommande</span
                        >
                      </div>
                      <p class="text-sm font-bold text-green-600">
                        +225 05 01 24 29 29
                      </p>
                      <p class="text-xs text-gray-400 mt-0.5">
                        Reponse rapide — cliquez pour ouvrir la conversation
                      </p>
                    </div>
                    <Icon
                      name="arrow-right"
                      size="sm"
                      class="text-green-400 group-hover:translate-x-1 transition-transform"
                    />
                  </a>

                  <!-- Telephone -->
                  <a
                    href="tel:+2250501242929"
                    class="flex items-center gap-4 p-5 rounded-2xl border border-ateliya-border/[0.55] bg-gray-50/50 hover:bg-gray-50 hover:border-ateliya-primary/20 transition-all duration-300 group"
                  >
                    <div
                      class="w-14 h-14 rounded-2xl bg-gradient-to-br from-ateliya-primary to-ateliya-secondary flex items-center justify-center flex-shrink-0 group-hover:-translate-y-0.5 transition-transform duration-300"
                    >
                      <Icon name="phone" size="md" class="text-white" />
                    </div>
                    <div class="flex-1">
                      <p class="font-black text-gray-900 mb-0.5">Telephone</p>
                      <p class="text-sm font-bold text-ateliya-primary">
                        +225 05 01 24 29 29
                      </p>
                      <p class="text-xs text-gray-400 mt-0.5">
                        Appelez-nous directement
                      </p>
                    </div>
                    <Icon
                      name="arrow-right"
                      size="sm"
                      class="text-gray-300 group-hover:translate-x-1 group-hover:text-ateliya-primary transition-all"
                    />
                  </a>

                  <!-- Email -->
                  <a
                    href="mailto:support@ateliya.com"
                    class="flex items-center gap-4 p-5 rounded-2xl border border-ateliya-border/[0.55] bg-gray-50/50 hover:bg-gray-50 hover:border-ateliya-secondary/20 transition-all duration-300 group"
                  >
                    <div
                      class="w-14 h-14 rounded-2xl bg-gradient-to-br from-ateliya-secondary/[0.16] to-ateliya-secondary/[0.08] flex items-center justify-center flex-shrink-0 group-hover:-translate-y-0.5 transition-transform duration-300"
                    >
                      <Icon
                        name="mail"
                        size="md"
                        class="text-ateliya-secondary"
                      />
                    </div>
                    <div class="flex-1">
                      <p class="font-black text-gray-900 mb-0.5">Email</p>
                      <p class="text-sm font-bold text-ateliya-secondary">
                        support@ateliya.com
                      </p>
                      <p class="text-xs text-gray-400 mt-0.5">
                        Pour les demandes detaillees
                      </p>
                    </div>
                    <Icon
                      name="arrow-right"
                      size="sm"
                      class="text-gray-300 group-hover:translate-x-1 group-hover:text-ateliya-secondary transition-all"
                    />
                  </a>
                </div>

                <!-- Disponibilite note -->
                <div
                  class="mt-6 p-4 bg-ateliya-primary/5 rounded-2xl border border-ateliya-primary/10"
                >
                  <div class="flex items-center gap-2 mb-1">
                    <div
                      class="w-2 h-2 rounded-full bg-green-500 animate-pulse"
                    >
                    </div>
                    <span class="text-sm font-bold text-gray-800"
                      >Disponibles du lundi au samedi</span
                    >
                  </div>
                  <p class="text-xs text-gray-500">
                    De 8h a 20h GMT — hors horaires, laissez un message
                    WhatsApp.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Sidebar - 2 cols -->
          <div class="lg:col-span-2 space-y-4">
            <!-- Disponibilite -->
            <div class="relative">
              <div
                class="p-5 rounded-2xl bg-white/[0.96] border border-ateliya-border/[0.55] relative overflow-hidden shadow-[0_8px_20px_rgba(18,63,59,0.04)]"
              >
                <div class="flex items-center gap-3 mb-4">
                  <div
                    class="w-9 h-9 rounded-xl bg-gradient-to-br from-ateliya-primary/20 to-ateliya-primary/10 flex items-center justify-center"
                  >
                    <Icon name="clock" size="sm" class="text-ateliya-primary" />
                  </div>
                  <h3 class="font-serif font-extrabold tracking-tighter text-gray-900">Disponibilite</h3>
                </div>

                <div class="space-y-2">
                  {
                    [
                      { day: "Lun - Sam", hours: "8h - 20h", active: true },
                      { day: "Dimanche", hours: "Message WA", active: true },
                    ].map((row) => (
                      <div class="flex items-center justify-between py-2 border-b border-gray-50 last:border-0">
                        <span class="text-sm text-gray-500">{row.day}</span>
                        <span class="text-sm font-bold text-gray-900">
                          {row.hours}
                        </span>
                      </div>
                    ))
                  }
                </div>

                <div
                  class="mt-3 flex items-center gap-2 px-3 py-2 bg-green-50 rounded-lg border border-green-100"
                >
                  <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse">
                  </div>
                  <span class="text-xs font-bold text-green-700"
                    >Disponible en ligne</span
                  >
                </div>
              </div>
            </div>

            <!-- Social -->
            <div class="relative">
              <div
                class="p-5 rounded-2xl bg-white/[0.96] border border-ateliya-border/[0.55] relative overflow-hidden shadow-[0_8px_20px_rgba(18,63,59,0.04)]"
              >
                <div class="flex items-center gap-3 mb-4">
                  <div
                    class="w-9 h-9 rounded-xl bg-gradient-to-br from-ateliya-secondary/20 to-ateliya-secondary/10 flex items-center justify-center"
                  >
                    <Icon
                      name="users"
                      size="sm"
                      class="text-ateliya-secondary"
                    />
                  </div>
                  <h3 class="font-serif font-extrabold tracking-tighter text-gray-900">Suivez-nous</h3>
                </div>

                <div class="flex gap-2.5">
                  {
                    socialLinks.map((social) => (
                      <a
                        href={social.href}
                        aria-label={social.label}
                        class={`w-10 h-10 rounded-xl bg-white/[0.96] border border-ateliya-border/[0.55] flex items-center justify-center shadow-[0_6px_16px_rgba(18,63,59,0.035)] ${social.color}`}
                      >
                        <Icon name={social.icon} size="sm" />
                      </a>
                    ))
                  }
                </div>
              </div>
            </div>

            <!-- FAQ mini -->
            <div>
              <h3
                class="text-base font-serif font-extrabold tracking-tighter text-gray-900 mb-3 flex items-center gap-2"
              >
                <div
                  class="w-7 h-7 rounded-lg bg-gradient-to-br from-ateliya-primary/20 to-ateliya-primary/10 flex items-center justify-center"
                >
                  <Icon
                    name="help-circle"
                    size="xs"
                    class="text-ateliya-primary"
                  />
                </div>
                Questions frequentes
              </h3>

              <div class="space-y-2.5">
                {
                  faqContact.map((item, idx) => (
                    <div class="faq-item">
                      <div class="relative">
                        <div class="absolute -inset-0.5 bg-gradient-to-br from-ateliya-primary/[0.06] to-teal-400/[0.035] rounded-2xl blur-md opacity-0 faq-glow transition-all duration-700 -z-10" />

                        <div class="rounded-2xl bg-white/[0.96] border border-ateliya-border/[0.55] transition-all duration-500 faq-card relative overflow-hidden shadow-[0_6px_16px_rgba(18,63,59,0.035)]">
                          <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-transparent via-ateliya-primary to-transparent opacity-0 faq-accent transition-opacity duration-500" />

                          <button
                            class="w-full flex items-center justify-between gap-3 p-3.5 text-left"
                            aria-expanded="false"
                          >
                            <span class="font-bold text-gray-900 text-sm">
                              {item.question}
                            </span>
                            <div class="faq-chevron flex-shrink-0 w-6 h-6 rounded-full bg-gray-50 flex items-center justify-center transition-all duration-300">
                              <Icon
                                name="chevron-down"
                                size="xs"
                                class="text-gray-400 transition-transform duration-300"
                              />
                            </div>
                          </button>

                          <div class="faq-answer">
                            <div class="px-3.5 pb-3.5 text-gray-500 leading-relaxed text-xs">
                              {item.answer}
                            </div>
                          </div>

                          <div class="absolute bottom-0 left-0 right-0 h-0.5 bg-ateliya-primary/10 rounded-b-2xl overflow-hidden">
                            <div class="h-full w-0 bg-gradient-to-r from-ateliya-primary to-teal-400 faq-bar transition-all duration-1000" />
                          </div>
                        </div>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-item.is-open .faq-answer {
    max-height: 200px;
  }

  .faq-item.is-open .faq-card {
    border-color: rgba(52, 199, 184, 0.2);
  }

  .faq-item.is-open .faq-glow {
    opacity: 0.4;
  }

  .faq-item.is-open .faq-accent {
    opacity: 1;
  }

  .faq-item.is-open .faq-bar {
    width: 100%;
  }

  .faq-item.is-open .faq-chevron {
    background: rgba(52, 199, 184, 0.1);
  }

  .faq-item.is-open .faq-chevron :global(svg) {
    transform: rotate(180deg);
    color: #2fafa4;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".faq-item button").forEach((btn) => {
      btn.addEventListener("click", () => {
        const item = btn.closest(".faq-item");
        if (!item) return;
        const wasOpen = item.classList.contains("is-open");

        document.querySelectorAll(".faq-item").forEach((i) => {
          i.classList.remove("is-open");
          i.querySelector("button")?.setAttribute("aria-expanded", "false");
        });

        if (!wasOpen) {
          item.classList.add("is-open");
          btn.setAttribute("aria-expanded", "true");
        }
      });
    });
  });
</script>
