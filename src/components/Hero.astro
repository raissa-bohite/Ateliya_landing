---
import Icon from "../components/Icon.astro";

const phoneScreens = [
  {
    src: "/ateliya/app_images/accueil.png",
    alt: "Ecran d'accueil Ateliya",
  },
  {
    src: "/ateliya/app_images/gestion.png",
    alt: "Gestion des commandes dans Ateliya",
  },
  {
    src: "/ateliya/app_images/rendez-vous.png",
    alt: "Planning des rendez-vous dans Ateliya",
  },
  {
    src: "/ateliya/app_images/rapport.png",
    alt: "Rapports et statistiques dans Ateliya",
  },
];

const phoneScreensCount = phoneScreens.length;
---

<section
  id="hero"
  class="relative overflow-hidden min-h-[95vh] flex items-center bg-gradient-to-br from-gray-50 via-white to-teal-50/30"
>
  <!-- Background Decorations -->
  <div
    class="absolute right-0 top-0 w-[55%] h-full bg-gradient-to-bl from-ateliya-primary/6 via-ateliya-secondary/3 to-transparent rounded-bl-[140px]"
  >
  </div>
  <div
    class="absolute top-[15%] left-[8%] w-80 h-80 bg-ateliya-primary/8 rounded-full blur-[120px] hero-float-1"
  >
  </div>
  <div
    class="absolute top-[40%] right-[15%] w-96 h-96 bg-ateliya-secondary/6 rounded-full blur-[120px] hero-float-2"
  >
  </div>
  <div
    class="absolute bottom-[15%] left-[30%] w-64 h-64 bg-ateliya-primary/4 rounded-full blur-[100px]"
  >
  </div>
  <div
    class="absolute inset-0 opacity-[0.03]"
    style="background-image: radial-gradient(circle, #123F3B 1px, transparent 1px); background-size: 32px 32px;"
  >
  </div>
  <div class="absolute left-8 top-[22%] grid grid-cols-6 gap-2 opacity-35">
    {
      [...Array(30)].map((_, i) => (
        <div
          class={`w-2 h-2 rounded-full ${i % 5 === 0 ? "bg-ateliya-primary" : i % 5 === 1 ? "bg-ateliya-secondary/60" : i % 5 === 2 ? "bg-teal-400/40" : i % 5 === 3 ? "bg-amber-400/30" : "bg-white/40"}`}
        />
      ))
    }
  </div>

  <!-- Content -->
  <div class="container mx-auto px-6 lg:px-10 relative z-10 py-20">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-8 items-center">
      <!-- Left -->
      <div class="space-y-7 hero-content-entrance">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 bg-white/40 backdrop-blur-sm border border-white/50 rounded-full"
        >
          <Icon name="sparkles" size="sm" class="text-ateliya-primary" />
          <span class="text-sm font-bold text-gray-800"
            >Couture Africaine Connectee</span
          >
        </div>

        <h1
          class="text-4xl md:text-5xl lg:text-[3.5rem] xl:text-6xl font-serif font-extrabold tracking-tighter leading-[1.08] text-gray-900"
        >
          Transformez votre
          <span
            class="block mt-2 text-transparent bg-clip-text bg-gradient-to-r from-ateliya-primary via-teal-500 to-ateliya-secondary"
            >atelier de couture</span
          >
          <span class="block mt-2">des aujourd'hui</span>
        </h1>

        <p class="text-lg text-gray-600 leading-relaxed max-w-lg tracking-wide">
          Gerez vos commandes, clients et finances avec
          <span class="font-bold text-ateliya-primary"
            >un essai gratuit de 14 jours</span
          >
        </p>

        <!-- CTA Buttons — taille augmentee -->
        <div class="flex flex-col sm:flex-row gap-4 pt-1">
          <button
            id="open-register-modal"
            type="button"
            class="group relative overflow-hidden inline-flex items-center justify-center gap-3 px-9 py-5 rounded-2xl bg-gradient-to-r from-ateliya-primary to-ateliya-secondary text-white font-bold text-xl shadow-lg shadow-ateliya-primary/25 hover:shadow-xl hover:shadow-ateliya-primary/35 transition-all duration-300 hover:scale-105"
          >
            <span
              class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/15 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700"
            ></span>
            <Icon
              name="user-plus"
              size="md"
              class="relative z-10 group-hover:scale-110 transition-transform duration-300"
            />
            <span class="relative z-10">S'inscrire</span>
          </button>
          <a
            href="#demo"
            class="group inline-flex items-center justify-center gap-3 px-6 py-3 rounded-2xl bg-white/60 backdrop-blur-sm border border-white/70 text-gray-800 font-bold text-xl hover:bg-white/80 hover:border-ateliya-primary/30 transition-all duration-300 hover:scale-105"
          >
            <Icon
              name="play-circle"
              size="md"
              class="text-ateliya-primary group-hover:scale-110 transition-transform duration-300"
            />
            <span>Voir la Demo</span>
          </a>
        </div>

        <div class="flex items-center gap-4 pt-2">
          <div class="flex -space-x-2">
            {
              [1, 2, 3, 4].map((i) => (
                <div class="w-9 h-9 rounded-full border-2 border-white bg-gradient-to-br from-ateliya-primary to-ateliya-secondary flex items-center justify-center text-white font-bold text-xs shadow-md hover:scale-110 hover:z-10 transition-transform duration-300">
                  {i}
                </div>
              ))
            }
            <div
              class="w-9 h-9 rounded-full border-2 border-white bg-gray-800 flex items-center justify-center text-white font-bold text-[10px] shadow-md"
            >
              +500
            </div>
          </div>
          <div class="flex items-center gap-2">
            <div class="flex gap-0.5">
              {
                [...Array(5)].map(() => (
                  <Icon name="star" size="xs" class="text-amber-400" />
                ))
              }
            </div>
            <span class="text-sm text-gray-600 font-semibold"
              >500+ couturiers satisfaits</span
            >
          </div>
        </div>
      </div>

      <!-- Right: phone mockup -->
      <div
        class="relative min-h-[550px] md:min-h-[650px] flex items-center justify-center order-first lg:order-last"
      >
        <div class="scene">
          <!-- Circular photo for layered depth -->
          <div class="scene__photo" aria-hidden="true">
            <div class="scene__photo-arc">
              <svg viewBox="0 0 200 200" class="w-full h-full">
                <defs>
                  <linearGradient
                    id="heroPhoneArc"
                    x1="0%"
                    y1="0%"
                    x2="100%"
                    y2="100%"
                  >
                    <stop
                      offset="0%"
                      style="stop-color:#2FAFA4;stop-opacity:0.78"></stop>
                    <stop
                      offset="100%"
                      style="stop-color:#B99752;stop-opacity:0.48"></stop>
                  </linearGradient>
                </defs>
                <path
                  d="M 100,15 A 85,85 0 0,1 185,100"
                  fill="none"
                  stroke="url(#heroPhoneArc)"
                  stroke-width="32"
                  stroke-linecap="round"></path>
              </svg>
            </div>
            <div class="scene__photo-frame">
              <img
                src="/premium_seamstress.png"
                alt=""
                class="scene__photo-img"
                loading="eager"
                decoding="async"
              />
            </div>
          </div>

          <!-- Phone -->
          <div class="scene__phone">
            <div class="scene__phone-body">
              <div
                class="scene__phone-screen"
                style={`--screen-total: ${phoneScreensCount};`}
              >
                <div class="scene__phone-notch"></div>
                <div class="scene__phone-slides">
                  {
                    phoneScreens.map((screen, index) => (
                      <img
                        src={screen.src}
                        alt={screen.alt}
                        class="scene__phone-img"
                        loading={index === 0 ? "eager" : "lazy"}
                        fetchpriority={index === 0 ? "high" : "auto"}
                        decoding={index === 0 ? "sync" : "async"}
                        style={`--screen-index: ${index}; --screen-total: ${phoneScreensCount};`}
                      />
                    ))
                  }
                </div>
              </div>
            </div>
            <div class="scene__phone-sheen"></div>
          </div>

          <div class="scene__shadow"></div>

          <!-- Notification cards -->

          <div
            class="hero-stat hero-stat--trend hero-float-card"
            style="animation-delay: 0.6s"
          >
            <div
              class="bg-white/95 backdrop-blur-sm rounded-2xl shadow-xl shadow-gray-300/30 p-3.5 border border-white/60"
            >
              <div class="flex items-center gap-2.5">
                <div
                  class="w-9 h-9 rounded-lg bg-ateliya-secondary/15 flex items-center justify-center flex-shrink-0"
                >
                  <Icon
                    name="trending-up"
                    size="sm"
                    class="text-ateliya-secondary"
                  />
                </div>
              </div>
            </div>
          </div>
          <div
            class="hero-stat hero-stat--community hero-float-card"
            style="animation-delay: 0.7s"
          >
            <div
              class="bg-white/95 backdrop-blur-sm rounded-2xl shadow-xl shadow-gray-300/30 p-3.5 border border-white/60"
            >
              <div class="flex items-center gap-2.5">
                <div
                  class="w-9 h-9 rounded-lg bg-ateliya-primary/10 flex items-center justify-center flex-shrink-0"
                >
                  <Icon name="users" size="sm" class="text-ateliya-primary" />
                </div>
                <div>
                  <p class="text-[10px] text-gray-400 font-medium">
                    Communaute
                  </p><p class="text-xs font-bold text-gray-900">
                    500+ tailleurs
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Decorative -->
        <div
          class="absolute top-[10%] left-[20%] w-3.5 h-3.5 rounded-full bg-ateliya-primary/40 hero-bounce-1"
        >
        </div>
        <div
          class="absolute top-[45%] right-[5%] w-4 h-4 rounded-full bg-ateliya-secondary/35 hero-bounce-2"
        >
        </div>
        <div
          class="absolute bottom-[28%] left-[5%] w-3 h-3 rounded-full bg-africa-gold/25 hero-bounce-1"
        >
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 hidden lg:flex flex-col items-center gap-2 hero-scroll-pulse"
  >
    <a
      href="#features"
      class="flex flex-col items-center gap-1.5 text-gray-500 hover:text-ateliya-primary transition-colors duration-300 p-2"
      aria-label="Defiler vers le bas"
    >
      <span class="text-[10px] font-bold uppercase tracking-[0.15em]"
        >Decouvrir</span
      >
      <Icon name="chevron-down" size="sm" />
    </a>
  </div>
</section>

<style>
  @keyframes kente-slide {
    0% {
      background-position: 0% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }

  @keyframes heroContentEntrance {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes heroFloatCard {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes heroFloat1 {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-14px);
    }
  }
  @keyframes heroFloat2 {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
  @keyframes heroBounce1 {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-8px) scale(1.1);
    }
  }
  @keyframes heroBounce2 {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-5px) scale(0.9);
    }
  }
  @keyframes scrollPulse {
    0%,
    100% {
      opacity: 0.5;
      transform: translateX(-50%) translateY(0);
    }
    50% {
      opacity: 1;
      transform: translateX(-50%) translateY(4px);
    }
  }

  /* Entrances rapides — tout termine avant 1.2s */
  .hero-content-entrance {
    animation: heroContentEntrance 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  }
  .hero-float-card {
    animation: heroFloatCard 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-stat {
    position: absolute;
    z-index: 40;
  }

  .hero-stat--check {
    top: 24%;
    left: 0;
  }

  .hero-stat--trend {
    right: 18%;
    bottom: 22%;
  }

  .hero-stat--community {
    left: -12%;
    bottom: 3%;
  }

  /* Animations continues différées à 6s pour ne pas perturber Lighthouse */
  .hero-float-1 {
    animation: heroFloat1 4s ease-in-out 6s infinite;
  }
  .hero-float-2 {
    animation: heroFloat2 5s ease-in-out 6.5s infinite;
  }
  .hero-bounce-1 {
    animation: heroBounce1 3s ease-in-out 6s infinite;
  }
  .hero-bounce-2 {
    animation: heroBounce2 3.5s ease-in-out 6.5s infinite;
  }
  .hero-scroll-pulse {
    animation: scrollPulse 2s ease-in-out 4s infinite;
  }

  /* ======================================================
     3D SCENE
     ====================================================== */

  .scene {
    --phone-offset: -58px;
    --phone-y: 34px;
    position: relative;
    width: 520px;
    height: 640px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .scene__photo {
    position: absolute;
    top: 6%;
    right: 1%;
    width: 300px;
    height: 300px;
    z-index: 5;
    animation: photoEntrance 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
  }

  .scene__photo-arc {
    position: absolute;
    inset: -22px -24px auto auto;
    width: 330px;
    height: 330px;
    pointer-events: none;
  }

  .scene__photo-frame {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 999px;
    overflow: hidden;
    border: 6px solid rgba(255, 255, 255, 0.9);
    box-shadow:
      0 26px 70px rgba(18, 63, 59, 0.16),
      0 8px 24px rgba(18, 63, 59, 0.08);
  }

  .scene__photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @keyframes photoEntrance {
    from {
      opacity: 0;
      transform: translateX(26px) scale(0.9);
    }
    to {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }

  .scene__phone {
    position: relative;
    z-index: 10;
    transform: translateX(var(--phone-offset)) translateY(var(--phone-y));
    will-change: transform;
    animation: phoneSurge 1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }

  /* Suppression de filter:blur — propriété non-compositée */
  @keyframes phoneSurge {
    0% {
      opacity: 0;
      transform: translateX(var(--phone-offset))
        translateY(calc(var(--phone-y) + 30px)) scale(0.5);
    }
    30% {
      opacity: 1;
    }
    70% {
      transform: translateX(var(--phone-offset))
        translateY(calc(var(--phone-y) - 14px)) scale(1.04);
    }
    85% {
      transform: translateX(var(--phone-offset))
        translateY(calc(var(--phone-y) - 2px)) scale(0.99);
    }
    100% {
      opacity: 1;
      transform: translateX(var(--phone-offset)) translateY(var(--phone-y))
        scale(1);
    }
  }

  .scene__phone-body {
    position: relative;
    background: #111827;
    border-radius: 3rem;
    padding: 12px;
    box-shadow:
      0 25px 60px rgba(0, 0, 0, 0.2),
      0 0 0 1px rgba(255, 255, 255, 0.1) inset;
    /* Différé à 6s + uniquement transform (pas box-shadow) */
    animation: phoneBreathe 5s ease-in-out 6s infinite;
  }

  /* Correction: suppression de box-shadow dans keyframe — non-composité */
  @keyframes phoneBreathe {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-10px) scale(1.015);
    }
  }

  .scene__phone-screen {
    position: relative;
    background: white;
    border-radius: 2.5rem;
    overflow: hidden;
    width: 280px;
    height: 580px;
  }

  .scene__phone-notch {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 28px;
    background: #111827;
    border-radius: 0 0 20px 20px;
    z-index: 20;
  }

  .scene__phone-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.015);
    animation: phoneScreenFade calc(var(--screen-total) * 4s) ease-in-out
      infinite;
    animation-delay: calc(var(--screen-index) * 4s);
  }

  .scene__phone-slides {
    position: absolute;
    inset: 0;
  }

  @keyframes phoneScreenFade {
    0%,
    21% {
      opacity: 1;
      transform: scale(1);
    }
    26%,
    95% {
      opacity: 0;
      transform: scale(1.015);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Correction: transform au lieu de left — propriété non-compositée */
  .scene__phone-sheen {
    position: absolute;
    top: 0;
    left: 0;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      105deg,
      transparent 30%,
      rgba(255, 255, 255, 0.12) 45%,
      rgba(255, 255, 255, 0.25) 50%,
      rgba(255, 255, 255, 0.12) 55%,
      transparent 70%
    );
    border-radius: 3rem;
    transform: translateX(-200%);
    animation: sheenSlide 5s ease-in-out 6s infinite;
    pointer-events: none;
    z-index: 15;
  }

  @keyframes sheenSlide {
    0%,
    65% {
      transform: translateX(-200%);
    }
    80% {
      transform: translateX(250%);
    }
    100% {
      transform: translateX(250%);
    }
  }

  .scene__phone::after {
    content: "";
    position: absolute;
    inset: -20px;
    border-radius: 3.5rem;
    background: radial-gradient(
      ellipse at center,
      rgba(52, 199, 184, 0.2) 0%,
      transparent 70%
    );
    opacity: 0;
    animation: surgeGlow 1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
    pointer-events: none;
    z-index: -1;
  }

  @keyframes surgeGlow {
    0% {
      opacity: 0;
      transform: scale(0.5);
    }
    40% {
      opacity: 1;
      transform: scale(1.3);
    }
    100% {
      opacity: 0;
      transform: scale(1.6);
    }
  }

  /* Correction: scaleX au lieu de width — propriété non-compositée */
  .scene__shadow {
    position: absolute;
    bottom: -4%;
    left: 50%;
    width: 220px;
    height: 30px;
    background: radial-gradient(
      ellipse,
      rgba(0, 0, 0, 0.12) 0%,
      transparent 70%
    );
    border-radius: 50%;
    opacity: 0;
    transform: translateX(-50%) scaleX(0.36);
    animation:
      shadowAppear 1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both,
      shadowBreathe 5s ease-in-out 6s infinite;
    z-index: 1;
  }

  @keyframes shadowAppear {
    0% {
      opacity: 0;
      transform: translateX(-50%) scaleX(0.36);
    }
    100% {
      opacity: 0.8;
      transform: translateX(-50%) scaleX(0.82);
    }
  }

  @keyframes shadowBreathe {
    0%,
    100% {
      transform: translateX(-50%) scaleX(0.82);
      opacity: 0.8;
    }
    50% {
      transform: translateX(-50%) scaleX(1);
      opacity: 0.5;
    }
  }

  /* ======================================================
     RESPONSIVE
     ====================================================== */

  @media (max-width: 768px) {
    .scene {
      --phone-offset: -38px;
      --phone-y: 24px;
      width: 380px;
      height: 540px;
    }
    .scene__photo {
      top: 7%;
      right: 0;
      width: 220px;
      height: 220px;
    }
    .scene__photo-arc {
      width: 246px;
      height: 246px;
      inset: -16px -18px auto auto;
    }
    .scene__phone-screen {
      width: 230px;
      height: 470px;
    }
    .hero-stat--check {
      left: -2%;
    }
    .hero-stat--trend {
      right: 13%;
      bottom: 24%;
    }
    .hero-stat--community {
      left: -3%;
      bottom: 8%;
    }
  }

  @media (max-width: 480px) {
    .scene {
      --phone-offset: -26px;
      --phone-y: 18px;
      width: 320px;
      height: 480px;
    }
    .scene__photo {
      top: 10%;
      right: 4%;
      width: 170px;
      height: 170px;
    }
    .scene__photo-arc {
      width: 194px;
      height: 194px;
      inset: -14px -14px auto auto;
    }
    .scene__photo-frame {
      border-width: 4px;
    }
    .scene__phone-screen {
      width: 200px;
      height: 410px;
    }
    .scene__phone-body {
      border-radius: 2rem;
      padding: 8px;
    }
    .scene__phone-screen {
      border-radius: 1.8rem;
    }
    .scene__phone-notch {
      width: 100px;
      height: 22px;
      border-radius: 0 0 16px 16px;
    }
    .hero-stat--check {
      left: -2%;
      top: 25%;
    }
    .hero-stat--trend {
      right: 4%;
      bottom: 26%;
    }
    .hero-stat--community {
      left: -5%;
      bottom: 10%;
    }
  }

  @media (min-width: 1280px) {
    .scene {
      --phone-offset: -64px;
      --phone-y: 36px;
      width: 560px;
      height: 680px;
    }
    .scene__photo {
      width: 330px;
      height: 330px;
    }
    .scene__photo-arc {
      width: 360px;
      height: 360px;
    }
    .scene__phone-screen {
      width: 300px;
      height: 620px;
    }
  }

  @media (min-width: 1536px) {
    .scene {
      --phone-offset: -70px;
      --phone-y: 40px;
      width: 600px;
      height: 720px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }

    .scene__phone-img {
      animation: none !important;
      opacity: 0;
      transform: none;
    }

    .scene__phone-img:first-child {
      opacity: 1;
    }
  }
</style>
