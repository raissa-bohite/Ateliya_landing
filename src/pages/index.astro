---
import BaseLayout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import HeroSection from "../components/Hero.astro";
import StepsSection from "../components/StepsSection.astro";
import FeaturesGrid from "../components/Features.astro";
import AccountingPaymentSection from "../components/Pricing.astro";
import GalleryCarousel from "../components/appGallery.astro";
import TestimonialsStatsSection from "../components/TestimonialsStatsSection.astro";
import DownloadSection from "../components/DownloadSection.astro";
import BlogSection from "../components/BlogSection.astro";
import FinalCtaSection from "../components/FinalCtaSection.astro";
import "../styles/global.css";
import FeaturesDatails from "../components/FeaturesDatails.astro";
import Pricing from "../components/Pricing.astro";
import RegisterModal from "../components/RegisterModal.astro";
---

<BaseLayout
  title="Ateliya - Gestion d'Atelier Intelligente"
  description="Transformez votre atelier de couture avec Ateliya. Gestion des clients, commandes, mesures et paiements intégrés. Essai gratuit."
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/ateliya/app_images/accueil.png"
    fetchpriority="high"
  />

  <Header />
  <RegisterModal />

  <HeroSection client:load />
  <StepsSection />
  <FeaturesDatails />
  <GalleryCarousel client:visible />
  <TestimonialsStatsSection />
  <DownloadSection />
  <BlogSection />

  <Footer />
</BaseLayout>
