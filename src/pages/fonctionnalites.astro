---
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import StitchDivider from "../components/ui/StitchDivider.astro";
import Icon from "../components/ui/Icon.astro";
import accueil from "../assets/screens/mockup-accueil.png";
import boutique from "../assets/screens/mockup-boutique.png";
import activite from "../assets/screens/mockup-activite.png";

const BADGES = ["Clients", "Commandes", "Paiements"];
---

<BaseLayout
  title="Fonctionnalités — Ateliya"
  description="Découvrez les outils Ateliya pour gérer les clients, les mesures, les commandes et les paiements de votre atelier de couture."
>
  <Header />
  <main class="flex-1">
    {/* ------------------------------ Hero ------------------------------ */}
    <section class="overflow-hidden bg-hero px-5 pt-32 pb-16 sm:pt-40 sm:pb-20">
      <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[1fr_0.95fr] lg:gap-16">
        <div class="relative z-10">
          <StitchDivider align="left" class="mb-5" />
          <p class="text-xs font-bold tracking-[0.2em] text-primary uppercase">
            Une application pour votre atelier
          </p>
          <h1 class="mt-5 max-w-2xl font-serif text-4xl leading-[1.08] tracking-tight text-text sm:text-6xl">
            Tout votre atelier, à sa juste place.
          </h1>
          <p class="mt-5 max-w-xl text-base leading-7 text-text-secondary sm:text-lg">
            Clients, mesures, commandes et paiements réunis dans Ateliya, pour
            suivre votre travail depuis votre mobile.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="/tarifs"
              class="inline-flex min-h-12 items-center gap-2 rounded-full bg-primary px-6 text-sm font-semibold text-white transition-colors hover:bg-primary-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2"
            >
              Voir les tarifs
              <Icon name="arrow-up-right" class="h-[17px] w-[17px] rotate-45" />
            </a>
            <a
              href="/contact"
              class="inline-flex min-h-12 items-center gap-2 rounded-full border border-border px-6 text-sm font-semibold text-text transition-colors hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2"
            >
              Parler à l'équipe
            </a>
          </div>
          <div class="mt-9 flex flex-wrap gap-x-5 gap-y-2 text-xs font-semibold text-text-secondary">
            {
              BADGES.map((item) => (
                <span class="inline-flex items-center gap-2">
                  <Icon name="check" class="h-[14px] w-[14px] text-primary" strokeWidth={3} />
                  {item}
                </span>
              ))
            }
          </div>
        </div>

        <div class="relative mx-auto h-[420px] w-full max-w-[460px] sm:h-[500px]">
          <div class="absolute bottom-[-6rem] left-1/2 aspect-square w-[88%] -translate-x-1/2 rounded-full bg-gold/35"></div>
          <div class="absolute bottom-[-3.5rem] left-1/2 aspect-square w-[72%] -translate-x-1/2 rounded-full border border-primary/20"></div>
          <div
            data-reveal="scale"
            style="transition-delay:0ms"
            class="absolute bottom-0 left-[2%] z-10 w-[38%]"
          >
            <Picture
              src={boutique}
              alt=""
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              widths={[200, 400]}
              sizes="200px"
              class="w-full -rotate-[10deg] drop-shadow-[0_20px_35px_rgba(0,0,0,0.25)]"
            />
          </div>
          <div
            data-reveal="scale"
            style="transition-delay:160ms"
            class="absolute bottom-0 left-[34%] z-20 w-[56%]"
          >
            <Picture
              src={accueil}
              alt="Aperçu de l'application Ateliya"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              widths={[220, 440]}
              sizes="220px"
              class="w-full rotate-[3deg] drop-shadow-[0_30px_55px_rgba(0,0,0,0.35)]"
            />
          </div>
        </div>
      </div>
    </section>

    {/* --------------------------- Bento grid --------------------------- */}
    <section class="bg-card px-5 py-20 sm:py-28">
      <div class="mx-auto max-w-6xl">
        <header class="mb-12 max-w-2xl sm:mb-16">
          <StitchDivider align="left" class="mb-5" />
          <p class="text-xs font-bold tracking-[0.2em] text-primary uppercase">
            Votre atelier, en un seul espace
          </p>
          <h2 class="mt-4 font-serif text-4xl leading-tight tracking-tight text-text sm:text-5xl">
            Chaque détail trouve sa place.
          </h2>
          <p class="mt-4 max-w-xl text-base leading-7 text-text-secondary sm:text-lg">
            Une vue d'ensemble pour avancer sereinement, et les bons outils à
            portée de main quand vous en avez besoin.
          </p>
        </header>

        <div class="grid auto-rows-[minmax(220px,auto)] grid-cols-1 gap-4 sm:gap-5 lg:grid-cols-12">
          {/* 01 — Clients & mesures */}
          <article
            data-reveal
            style="transition-delay:0ms"
            class="relative isolate flex min-h-[440px] flex-col overflow-hidden rounded-[2rem] bg-primary-light/60 p-7 sm:p-10 lg:col-span-7 lg:row-span-2"
          >
            <div class="relative z-20 max-w-[62%] sm:max-w-[19rem]">
              <span class="text-xs font-bold tracking-[0.18em] text-primary uppercase">
                01 · Clients &amp; mesures
              </span>
              <h3 class="mt-4 font-serif text-3xl leading-tight text-text sm:text-4xl">
                Chaque client, connu par cœur.
              </h3>
              <p class="mt-3 text-sm leading-6 text-text-secondary sm:text-base">
                Coordonnées, préférences, commandes et mesures réunies dans
                une fiche facile à retrouver.
              </p>
            </div>
            <div class="absolute -right-8 -bottom-20 h-64 w-64 rounded-full bg-gold/35 sm:right-2 sm:-bottom-24 sm:h-80 sm:w-80"></div>
            <Picture
              src={accueil}
              alt="Fiche client et historique dans Ateliya"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              widths={[220, 440]}
              sizes="220px"
              class="absolute right-[8%] bottom-0 z-10 w-[36%] max-w-[230px] rotate-[3deg] drop-shadow-[0_20px_35px_rgba(0,0,0,0.25)] sm:right-[10%]"
            />
            <div class="absolute bottom-10 left-7 z-20 hidden rounded-full border border-primary/15 bg-card/90 px-4 py-2 text-xs font-semibold text-primary shadow-sm sm:left-10 sm:block">
              Mesures toujours accessibles
            </div>
          </article>

          {/* 02 — Commandes */}
          <article
            data-reveal
            style="transition-delay:90ms"
            class="relative flex min-h-[300px] flex-col justify-between overflow-hidden rounded-[2rem] bg-primary p-7 text-white sm:p-9 lg:col-span-5"
          >
            <div class="relative z-10 max-w-[65%]">
              <span class="text-xs font-bold tracking-[0.18em] text-white/65 uppercase">
                02 · Commandes
              </span>
              <h3 class="mt-3 font-serif text-3xl leading-tight">
                Le fil de chaque création, bien suivi.
              </h3>
              <p class="mt-3 max-w-sm text-sm leading-6 text-white/75">
                Gardez les détails, les échéances et l'avancement à portée de
                main.
              </p>
            </div>
            <div class="absolute -right-16 -bottom-20 h-52 w-52 rounded-full border border-white/15"></div>
            <Picture
              src={boutique}
              alt="Catalogue et suivi des commandes dans Ateliya"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              widths={[150, 300]}
              sizes="150px"
              class="absolute right-[7%] bottom-0 z-10 w-[32%] max-w-[150px] rotate-[3deg] drop-shadow-[0_20px_35px_rgba(0,0,0,0.3)]"
            />
            <span class="relative z-20 mt-5 text-xs font-medium text-white/80">
              En cours <span class="mx-2 text-gold">•</span> Terminées
            </span>
          </article>

          {/* 03 — Paiements */}
          <article
            data-reveal
            style="transition-delay:180ms"
            class="relative flex min-h-[300px] flex-col justify-between overflow-hidden rounded-[2rem] border border-border/80 bg-background p-7 sm:p-9 lg:col-span-5"
          >
            <div class="relative z-10 max-w-[65%]">
              <span class="text-xs font-bold tracking-[0.18em] text-primary uppercase">
                03 · Paiements
              </span>
              <h3 class="mt-3 font-serif text-2xl leading-tight text-text">
                Des règlements sans zone floue.
              </h3>
              <p class="mt-3 text-sm leading-6 text-text-secondary">
                Suivez les acomptes, les soldes et les transactions de
                l'atelier.
              </p>
            </div>
            <Picture
              src={accueil}
              alt="Solde et transactions de l'atelier dans Ateliya"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              widths={[150, 300]}
              sizes="150px"
              class="absolute right-[8%] bottom-0 z-10 w-[32%] max-w-[150px] rotate-[3deg] drop-shadow-[0_20px_35px_rgba(0,0,0,0.25)]"
            />
            <span class="relative z-20 mt-5 inline-flex w-fit items-center gap-2 rounded-full bg-primary-light px-3 py-2 text-xs font-semibold text-primary">
              <Icon name="wallet" class="h-[14px] w-[14px]" /> Transactions suivies
            </span>
          </article>

          {/* 04 — Vue d'ensemble */}
          <article
            data-reveal
            style="transition-delay:270ms"
            class="relative flex min-h-[320px] flex-col overflow-hidden rounded-[2rem] bg-gold-bg p-7 sm:p-9 lg:col-span-7"
          >
            <div class="relative z-10 max-w-[19rem]">
              <span class="text-xs font-bold tracking-[0.18em] text-primary uppercase">
                04 · Vue d'ensemble
              </span>
              <h3 class="mt-3 font-serif text-3xl leading-tight text-text">
                Votre activité, d'un seul regard.
              </h3>
              <p class="mt-3 text-sm leading-6 text-text-secondary">
                Retrouvez les indicateurs utiles et prenez le pouls de votre
                atelier.
              </p>
            </div>
            <Picture
              src={activite}
              alt="Statistiques et rapports de l'atelier dans Ateliya"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              widths={[160, 320]}
              sizes="160px"
              class="absolute right-[7%] bottom-0 z-10 w-[34%] max-w-[165px] rotate-[3deg] drop-shadow-[0_20px_35px_rgba(0,0,0,0.25)]"
            />
            <Icon
              name="trending-up"
              class="absolute bottom-8 left-8 h-14 w-14 text-gold/70"
              strokeWidth={1.2}
            />
          </article>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
