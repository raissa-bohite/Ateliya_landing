---
import { Image } from "astro:assets";
import Icon from "../components/Icon.astro";
import { features } from "../data/data";
import accueilImg from "../assets/app_images/accueil.png";
---

<section
  id="features"
  class="relative py-24 lg:py-28 overflow-hidden bg-gradient-to-br from-teal-50/70 via-white to-amber-50/20"
>
  <div
    class="absolute right-0 top-0 w-[50%] h-[70%] bg-gradient-to-bl from-ateliya-primary/4 to-transparent rounded-bl-[120px]"
  >
  </div>

  <div
    class="absolute top-[10%] right-[25%] w-80 h-80 bg-ateliya-primary/[0.035] rounded-full blur-[120px]"
  >
  </div>
  <div
    class="absolute bottom-[15%] left-[10%] w-64 h-64 bg-ateliya-secondary/[0.03] rounded-full blur-[100px]"
  >
  </div>
  <div
    class="absolute top-[50%] left-[40%] w-48 h-48 bg-ateliya-primary/[0.025] rounded-full blur-[80px]"
  >
  </div>

  <div
    class="absolute inset-0 opacity-[0.014]"
    style="background-image: radial-gradient(circle, #2FAFA4 1px, transparent 1px); background-size: 36px 36px;"
  >
  </div>

  <div class="absolute left-8 top-[8%] grid grid-cols-6 gap-2 opacity-[0.16]">
    {
      [...Array(30)].map((_, i) => (
        <div
          class={`w-1.5 h-1.5 rounded-full ${i % 4 === 0 ? "bg-ateliya-primary" : i % 4 === 1 ? "bg-ateliya-secondary/50" : i % 4 === 2 ? "bg-ateliya-secondary/20" : "bg-gray-300"}`}
        />
      ))
    }
  </div>

  <!-- Dot grid bottom-right -->
  <div
    class="absolute right-10 bottom-[6%] grid grid-cols-5 gap-3 opacity-[0.14]"
  >
    {
      [...Array(15)].map((_, i) => (
        <div
          class={`w-2 h-2 rounded-full ${i % 2 === 0 ? "bg-ateliya-primary/40" : "bg-ateliya-secondary/25"}`}
        />
      ))
    }
  </div>

  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full border-2 border-dashed border-ateliya-primary/6 feat-spin-slow hidden lg:block"
  >
  </div>

  <!-- ---- Content ---- -->
  <div class="container mx-auto px-6 lg:px-10 relative z-10">
    <div class="grid lg:grid-cols-3 gap-10 lg:gap-8 items-center">
      <!-- Left: Title & CTA -->
      <div class="space-y-7 feat-fade-in">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 bg-ateliya-primary/10 rounded-full"
        >
          <Icon name="sparkles" size="sm" class="text-ateliya-primary" />
          <span class="text-sm font-bold text-ateliya-primary"
            >Fonctionnalites</span
          >
        </div>

        <h2
          class="text-4xl md:text-5xl font-serif font-extrabold tracking-tighter text-gray-900 leading-tight"
        >
          Decouvrez les
          <span class="text-ateliya-primary"> Fonctionnalites </span>
          d'Ateliya
        </h2>

        <p class="text-lg text-gray-500 leading-relaxed max-w-md tracking-wide">
          Tous les outils dont vous avez besoin pour gerer votre atelier
          efficacement. Comptabilite, paiements, commandes et bien plus.
        </p>

        <a href="/featuresDetails" class="btn-action group">
          <span>Voir toutes les fonctionnalites</span>
          <Icon
            name="arrow-right"
            size="sm"
            class="group-hover:translate-x-1 transition-transform duration-300"
          />
        </a>

        <!-- Mini stats -->
        <div class="flex items-center gap-4 pt-2">
          <div
            class="flex items-center gap-2 px-4 py-2.5 bg-white/[0.94] backdrop-blur-sm rounded-xl border border-ateliya-border/[0.55] shadow-[0_6px_16px_rgba(18,63,59,0.035)]"
          >
            <div
              class="w-8 h-8 rounded-lg bg-ateliya-primary/10 flex items-center justify-center"
            >
              <Icon name="zap" size="sm" class="text-ateliya-primary" />
            </div>
            <div>
              <p class="text-lg font-black text-gray-900 leading-none">15+</p>
              <p class="text-[10px] text-gray-400 font-medium">
                Fonctionnalites
              </p>
            </div>
          </div>
          <div
            class="flex items-center gap-2 px-4 py-2.5 bg-white/[0.94] backdrop-blur-sm rounded-xl border border-ateliya-border/[0.55] shadow-[0_6px_16px_rgba(18,63,59,0.035)]"
          >
            <div
              class="w-8 h-8 rounded-lg bg-green-100 flex items-center justify-center"
            >
              <Icon name="check" size="sm" class="text-green-600" />
            </div>
            <div>
              <p class="text-lg font-black text-gray-900 leading-none">100%</p>
              <p class="text-[10px] text-gray-400 font-medium">Gratuit</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Center: Phone Mockup Composite -->
      <div class="relative min-h-[550px] flex items-center justify-center">
        <!-- BG circle -->
        <div
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[380px] h-[380px] rounded-full bg-gradient-to-br from-ateliya-primary/6 to-ateliya-secondary/3"
        >
        </div>

        <!-- Phone -->
        <div class="relative z-20 feat-phone-entrance">
          <div
            class="relative bg-gray-900 rounded-[3rem] p-3 shadow-[0_18px_44px_rgba(18,63,59,0.14)]"
          >
            <div
              class="relative bg-white rounded-[2.5rem] overflow-hidden w-64 h-[540px]"
            >
              <div
                class="absolute top-0 left-1/2 -translate-x-1/2 w-28 h-6 bg-gray-900 rounded-b-2xl z-20"
              >
              </div>
              <Image
                src={accueilImg}
                alt="Ateliya - Gestion complete d'atelier"
                class="w-full h-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>

        <!-- Arc decoration -->
        <div
          class="absolute -top-2 -right-2 w-[280px] h-[280px] feat-arc-entrance"
        >
          <svg viewBox="0 0 200 200" class="w-full h-full">
            <defs>
              <linearGradient id="featArc" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#2FAFA4;stop-opacity:0.6"
                ></stop>
                <stop offset="100%" style="stop-color:#B99752;stop-opacity:0.35"
                ></stop>
              </linearGradient>
            </defs>
            <path
              d="M 100,18 A 82,82 0 0,1 182,100"
              fill="none"
              stroke="url(#featArc)"
              stroke-width="28"
              stroke-linecap="round"></path>
          </svg>
        </div>

        <!-- Hatched circle -->
        <div class="absolute bottom-[8%] left-[5%] w-16 h-16 opacity-20">
          <div
            class="w-full h-full rounded-full"
            style="background: repeating-linear-gradient(45deg, transparent, transparent 2.5px, #2FAFA440 2.5px, #2FAFA440 5px);"
          >
          </div>
        </div>

        <!-- Bouncing dots -->
        <div
          class="absolute top-[8%] right-[15%] w-3 h-3 rounded-full bg-ateliya-primary/28 feat-bounce-1"
        >
        </div>
        <div
          class="absolute bottom-[20%] left-[10%] w-4 h-4 rounded-full bg-ateliya-secondary/24 feat-bounce-2"
        >
        </div>
        <div
          class="absolute top-[45%] -left-3 w-2.5 h-2.5 rounded-full bg-africa-gold/25 feat-bounce-1"
        >
        </div>

        <!-- Rotated square -->
        <div
          class="absolute top-[5%] left-[20%] w-7 h-7 rounded-lg rotate-45 bg-gradient-to-br from-ateliya-primary/[0.12] to-ateliya-secondary/[0.08]"
        >
        </div>
      </div>

      <!-- Right: Features List -->
      <div class="space-y-4">
        {
          features.map((solution, i) => (
            <div
              class="feat-slide-up group"
              style={`animation-delay: ${i * 80}ms`}
            >
              <div class="relative bg-white/[0.94] backdrop-blur-sm border border-ateliya-border/[0.55] group-hover:border-ateliya-primary/25 rounded-xl p-5 transition-[transform,background-color,border-color,box-shadow,color] duration-200 ease-out hover:shadow-[0_6px_16px_rgba(18,63,59,0.04)] hover:bg-white hover:-translate-y-px">
                {/* Top accent line */}
                <div class="absolute top-0 left-5 right-5 h-px rounded-full bg-ateliya-primary opacity-0 group-hover:opacity-100 transition-opacity duration-300" />

                <div class="flex items-start gap-4">
                  <div class="flex-shrink-0 w-11 h-11 rounded-xl bg-ateliya-primary/10 border border-ateliya-primary/15 flex items-center justify-center shadow-[0_8px_18px_rgba(47,175,164,0.06)] group-hover:-translate-y-px group-hover:bg-ateliya-primary/14 transition-[transform,background-color,border-color,box-shadow,color] duration-200 ease-out">
                    <Icon
                      name={solution.icon}
                      size="sm"
                      class="text-ateliya-primary"
                    />
                  </div>

                  <div class="flex-1 min-w-0">
                    <h3 class="text-base font-bold text-gray-900 group-hover:text-ateliya-primary transition-colors duration-300 mb-1">
                      {solution.title}
                    </h3>
                    <p class="text-sm text-gray-500 leading-relaxed">
                      {solution.description}
                    </p>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* ---- Animations ---- */
  @keyframes featPhoneEntrance {
    from {
      opacity: 0;
      transform: translateY(30px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes featArcEntrance {
    from {
      opacity: 0;
      transform: scale(0.85);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes featFloatCard {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes featFadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes featSlideUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes featSpinSlow {
    from {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  @keyframes featBounce1 {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-7px) scale(1.1);
    }
  }

  @keyframes featBounce2 {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-5px) scale(0.9);
    }
  }

  .feat-phone-entrance {
    animation: featPhoneEntrance 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }

  .feat-arc-entrance {
    animation: featArcEntrance 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
  }

  .feat-float-card {
    animation: featFloatCard 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .feat-fade-in {
    animation: featFadeIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .feat-slide-up {
    animation: featSlideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .feat-spin-slow {
    animation: featSpinSlow 35s linear infinite;
  }

  .feat-bounce-1 {
    animation: featBounce1 3s ease-in-out infinite;
  }

  .feat-bounce-2 {
    animation: featBounce2 3.5s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
