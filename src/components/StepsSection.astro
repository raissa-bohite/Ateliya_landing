---
import { Image } from "astro:assets";
import Icon from "../components/Icon.astro";
import { steps } from "../data/data";
import gestionImg from "../assets/app_images/gestion.png";
import rapportImg from "../assets/app_images/rapport.png";

const stepStyles = [
  {
    icon: "user-plus",
    color: "text-ateliya-primary",
    bgColor: "from-ateliya-primary/20 to-ateliya-primary/10",
  },
  {
    icon: "settings",
    color: "text-ateliya-secondary",
    bgColor: "from-ateliya-secondary/20 to-ateliya-secondary/10",
  },
  {
    icon: "upload",
    color: "text-ateliya-primary",
    bgColor: "from-ateliya-primary/[0.15] to-ateliya-primary/[0.08]",
  },
  {
    icon: "rocket",
    color: "text-amber-500",
    bgColor: "from-amber-500/20 to-amber-500/10",
  },
];

const appFeatures = [
  {
    icon: "cloud",
    title: "Gestion Cloud Complete",
    description:
      "Accedez a vos donnees depuis n'importe ou avec notre solution cloud securisee et synchronisee en temps reel",
  },
  {
    icon: "clock",
    title: "Gain de Temps Optimal",
    description:
      "Automatisez vos taches repetitives et reduisez le temps de saisie des donnees de 70%",
  },
  {
    icon: "dollar-sign",
    title: "Suivi Financier Precis",
    description:
      "Suivez vos revenus, depenses et marges en temps reel avec des rapports detailles",
  },
];
---

<section
  id="steps"
  class="relative py-24 lg:py-28 overflow-hidden bg-gradient-to-b from-white via-gray-50/30 to-white"
>
  <!-- ---- Background Decorations ---- -->
  <div
    class="absolute top-[5%] right-[20%] w-80 h-80 bg-ateliya-primary/[0.035] rounded-full blur-[120px]"
  >
  </div>
  <div
    class="absolute bottom-[15%] left-[15%] w-64 h-64 bg-ateliya-secondary/[0.025] rounded-full blur-[100px]"
  >
  </div>

  <div
    class="absolute inset-0 opacity-[0.014]"
    style="background-image: radial-gradient(circle, #2FAFA4 1px, transparent 1px); background-size: 36px 36px;"
  >
  </div>

  <!-- Dot grid top-right -->
  <div class="absolute right-8 top-[6%] grid grid-cols-5 gap-2 opacity-[0.16]">
    {
      [...Array(20)].map((_, i) => (
        <div
          class={`w-1.5 h-1.5 rounded-full ${i % 3 === 0 ? "bg-ateliya-primary" : i % 3 === 1 ? "bg-ateliya-secondary/50" : "bg-gray-300"}`}
        />
      ))
    }
  </div>

  <div class="container mx-auto px-6 lg:px-10 relative z-10">
    <!-- ---- Header ---- -->
    <div class="text-center mb-16 md:mb-20 space-y-5">
      <div
        class="inline-flex items-center gap-2 px-4 py-2 bg-ateliya-primary/10 rounded-full"
      >
        <Icon name="compass" size="sm" class="text-ateliya-primary" />
        <span class="text-sm font-bold text-ateliya-primary"
          >Guide de Demarrage</span
        >
      </div>

      <h3
        class="text-3xl md:text-4xl lg:text-5xl font-serif font-extrabold tracking-tighter leading-tight text-gray-900"
      >
        <span class="block">4 Etapes</span>
        <span
          class="text-ateliya-primary"
        >
          pour vous connecter
        </span>
      </h3>

      <p
        class="text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed tracking-wide"
      >
        Suivez notre processus <span class="font-bold text-ateliya-primary"
          >simple et efficace</span
        > pour optimiser votre gestion d'atelier
      </p>
    </div>

    <!-- ---- Steps Grid (KEPT AS-IS with Icon component) ---- -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8 mb-20 md:mb-28"
    >
      {
        steps.map((step, i) => (
          <div class="group/step h-full">
            <div class="h-full relative">
              <div
                class={`absolute -inset-1 bg-gradient-to-br ${stepStyles[i].bgColor} rounded-2xl blur-lg opacity-0 group-hover/step:opacity-24 transition-[transform,opacity,background-color,border-color,box-shadow] duration-500 ease-out -z-10`}
              />

              <div class="h-full p-6 md:p-8 rounded-2xl bg-white/[0.96] border border-ateliya-border/[0.55] group-hover/step:border-ateliya-primary/25 transition-[transform,opacity,background-color,border-color,box-shadow] duration-300 ease-out hover:shadow-[0_14px_34px_rgba(18,63,59,0.07)] relative overflow-hidden">
                <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-ateliya-primary/[0.55] to-transparent opacity-0 group-hover/step:opacity-100 transition-opacity duration-500" />

                <div class="relative z-10 flex flex-col h-full space-y-6">
                  <div class="flex items-start justify-between">
                    <div
                      class={`relative flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br ${stepStyles[i].bgColor} group-hover/step:-translate-y-px transition-[transform,opacity,background-color,border-color,box-shadow] duration-300 ease-out shadow-[0_10px_24px_rgba(18,63,59,0.07)]`}
                    >
                      <Icon
                        name={stepStyles[i].icon}
                        size="lg"
                        class={stepStyles[i].color}
                      />
                    </div>
                    <div class="text-6xl md:text-7xl font-black text-ateliya-primary/10 leading-none">
                      {step.number}
                    </div>
                  </div>

                  <div class="space-y-2">
                    <h3 class="text-xl md:text-2xl font-serif font-extrabold tracking-tighter text-gray-900 leading-tight">
                      {step.title}
                    </h3>
                    <div class="w-12 h-1 bg-gradient-to-r from-ateliya-primary to-transparent rounded-full group-hover/step:w-20 transition-[transform,opacity,background-color,border-color,box-shadow] duration-300 ease-out" />
                  </div>

                  <p class="text-gray-500 leading-relaxed text-sm md:text-base flex-grow tracking-wide">
                    {step.description}
                  </p>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- ============================================== -->
    <!-- ---- BOTTOM SECTION: Mockups + Features ---- -->
    <!-- ============================================== -->
    <div
      class="relative py-16 px-8 lg:px-12 rounded-3xl overflow-hidden bg-gradient-to-br from-teal-50/[0.55] via-white to-amber-50/[0.18] border border-ateliya-border/[0.55] shadow-[0_16px_44px_rgba(18,63,59,0.045)]"
    >
      <!-- Section bg decorations -->
      <div
        class="absolute right-0 top-0 w-[40%] h-[60%] bg-gradient-to-bl from-ateliya-primary/[0.025] to-transparent rounded-bl-[80px]"
      >
      </div>
      <div
        class="absolute top-[10%] right-[20%] w-56 h-56 bg-ateliya-primary/[0.03] rounded-full blur-[100px]"
      >
      </div>
      <div
        class="absolute bottom-[10%] left-[15%] w-48 h-48 bg-ateliya-secondary/[0.025] rounded-full blur-[80px]"
      >
      </div>

      <!-- Dot grid -->
      <div
        class="absolute left-6 top-[10%] grid grid-cols-5 gap-2 opacity-[0.16]"
      >
        {
          [...Array(20)].map((_, i) => (
            <div
              class={`w-1.5 h-1.5 rounded-full ${i % 3 === 0 ? "bg-ateliya-primary" : i % 3 === 1 ? "bg-ateliya-secondary/40" : "bg-gray-300"}`}
            />
          ))
        }
      </div>
      <div
        class="absolute right-6 bottom-[8%] grid grid-cols-4 gap-2.5 opacity-[0.14]"
      >
        {
          [...Array(12)].map((_, i) => (
            <div
              class={`w-1.5 h-1.5 rounded-full ${i % 2 === 0 ? "bg-ateliya-primary/50" : "bg-gray-300"}`}
            />
          ))
        }
      </div>

      <!-- Radial dots -->
      <div
        class="absolute inset-0 opacity-[0.012]"
        style="background-image: radial-gradient(circle, #2FAFA4 1px, transparent 1px); background-size: 32px 32px;"
      >
      </div>

      <div
        class="grid lg:grid-cols-2 gap-12 lg:gap-8 items-center relative z-10"
      >
        <!-- Left: Content -->
        <div class="space-y-7 order-2 lg:order-1">
          <div
            class="inline-flex items-center gap-2 px-4 py-2 bg-ateliya-secondary/10 rounded-full"
          >
            <Icon name="smartphone" size="sm" class="text-ateliya-secondary" />
            <span class="text-sm font-bold text-ateliya-secondary"
              >Multi-Plateformes</span
            >
          </div>

          <div class="space-y-3">
            <h3
              class="text-3xl md:text-4xl lg:text-5xl font-serif font-extrabold tracking-tighter leading-tight text-gray-900"
            >
              Suivez vos
              <span
                class="text-ateliya-primary"
              >
                depenses quotidiennes
              </span>
            </h3>
            <p
              class="text-lg text-gray-500 leading-relaxed max-w-lg tracking-wide"
            >
              Gerez votre atelier avec une <span
                class="font-bold text-ateliya-primary">solution moderne</span
              > qui centralise tout
            </p>
          </div>

          <!-- Feature list -->
          <div class="space-y-3">
            {
              appFeatures.map((feature, i) => (
                <div
                  class="group/feat flex items-start gap-4 p-4 bg-white/[0.94] backdrop-blur-sm rounded-xl border border-ateliya-border/[0.55] hover:border-ateliya-primary/25 hover:bg-white hover:shadow-[0_6px_16px_rgba(18,63,59,0.04)] hover:-translate-y-px transition-[transform,background-color,border-color,box-shadow,color] duration-200 ease-out"
                  style={`animation-delay: ${i * 80}ms`}
                >
                  <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-ateliya-primary/10 border border-ateliya-primary/15 flex items-center justify-center shadow-[0_8px_18px_rgba(47,175,164,0.06)] group-hover/feat:-translate-y-px group-hover/feat:bg-ateliya-primary/14 transition-[transform,background-color,border-color,box-shadow,color] duration-200 ease-out">
                    <Icon name={feature.icon} size="sm" class="text-ateliya-primary" />
                  </div>
                  <div class="flex-1 min-w-0">
                    <h4 class="text-base font-bold text-gray-900 group-hover/feat:text-ateliya-primary transition-colors duration-300 mb-0.5">
                      {feature.title}
                    </h4>
                    <p class="text-sm text-gray-500 leading-relaxed">
                      {feature.description}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>

          <!-- Trust indicators -->
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <div
              class="flex items-center gap-2 px-4 py-2.5 bg-white/[0.94] backdrop-blur-sm rounded-xl border border-ateliya-border/[0.55] shadow-[0_6px_16px_rgba(18,63,59,0.035)]"
            >
              <div class="flex gap-0.5">
                {
                  [...Array(5)].map(() => (
                    <Icon name="star" size="xs" class="text-amber-400" />
                  ))
                }
              </div>
              <span class="text-sm font-bold text-gray-600">4.9/5</span>
            </div>

            <div class="h-8 w-px bg-gray-200"></div>

            <div
              class="flex items-center gap-2 px-4 py-2.5 bg-white/[0.94] backdrop-blur-sm rounded-xl border border-ateliya-border/[0.55] shadow-[0_6px_16px_rgba(18,63,59,0.035)]"
            >
              <Icon name="users" size="sm" class="text-ateliya-primary" />
              <span class="text-sm font-bold text-gray-600"
                >500+ utilisateurs actifs</span
              >
            </div>
          </div>
        </div>

        <!-- Right: Mockup Composite -->
        <div class="relative min-h-[480px] md:min-h-[560px] order-1 lg:order-2">
          <!-- BG circle -->
          <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] rounded-full bg-gradient-to-br from-ateliya-primary/[0.035] to-ateliya-secondary/[0.02]"
          >
          </div>

          <!-- Dashed orbit -->
          <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[440px] h-[440px] rounded-full border border-dashed border-ateliya-primary/[0.07] steps-spin-slow hidden md:block"
          >
          </div>

          <!-- Device 1: Terminal (back) -->
          <div class="absolute left-[2%] top-[8%] z-10 steps-device-1">
            <div
              class="relative bg-gray-900 rounded-[2.5rem] p-2.5 shadow-[0_18px_44px_rgba(18,63,59,0.14)]"
            >
              <div
                class="relative bg-white rounded-[2rem] overflow-hidden w-56 md:w-64 h-[400px] md:h-[460px]"
              >
                <div
                  class="absolute top-0 left-1/2 -translate-x-1/2 w-24 h-5 bg-gray-900 rounded-b-2xl z-20"
                >
                </div>
                <Image
                  src={gestionImg}
                  alt="Terminal de paiement"
                  class="w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </div>

          <!-- Device 2: Mobile (front) -->
          <div class="absolute right-[2%] top-[18%] z-20 steps-device-2">
            <div
              class="relative bg-gray-900 rounded-[2.5rem] p-2.5 shadow-[0_18px_44px_rgba(18,63,59,0.14)]"
            >
              <div
                class="relative bg-white rounded-[2rem] overflow-hidden w-56 md:w-64 h-[400px] md:h-[460px]"
              >
                <div
                  class="absolute top-0 left-1/2 -translate-x-1/2 w-24 h-5 bg-gray-900 rounded-b-2xl z-20"
                >
                </div>
                <Image
                  src={rapportImg}
                  alt="Application mobile"
                  class="w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>

            <!-- Badge -->
            <div class="absolute -top-3 -left-3 z-30">
              <div
                class="bg-gradient-to-r from-ateliya-secondary to-amber-500 text-white text-[11px] font-bold px-3 py-1.5 rounded-full shadow-[0_8px_18px_rgba(185,151,82,0.16)] flex items-center gap-1.5"
              >
                <Icon name="smartphone" size="xs" class="text-white" />
                <span>Mobile</span>
              </div>
            </div>
          </div>

          <!-- Arc decoration -->
          <div
            class="absolute top-[3%] right-[5%] w-[240px] h-[240px] steps-arc-entrance"
          >
            <svg viewBox="0 0 200 200" class="w-full h-full">
              <defs>
                <linearGradient
                  id="stepsArc"
                  x1="0%"
                  y1="0%"
                  x2="100%"
                  y2="100%"
                >
                  <stop offset="0%" style="stop-color:#B99752;stop-opacity:0.5"
                  ></stop>
                  <stop
                    offset="100%"
                    style="stop-color:#2FAFA4;stop-opacity:0.3"></stop>
                </linearGradient>
              </defs>
              <path
                d="M 100,18 A 82,82 0 0,1 182,100"
                fill="none"
                stroke="url(#stepsArc)"
                stroke-width="25"
                stroke-linecap="round"></path>
            </svg>
          </div>

          <!-- Floating cards -->
          <div
            class="absolute top-[5%] left-[35%] z-30 steps-float-card"
            style="animation-delay: 0.5s"
          >
          </div>

          <div
            class="absolute bottom-[10%] right-[15%] z-30 steps-float-card"
            style="animation-delay: 0.9s"
          >
            <div
              class="bg-white/[0.96] backdrop-blur-sm rounded-xl shadow-[0_10px_24px_rgba(18,63,59,0.07)] p-3 border border-ateliya-border/[0.55]"
            >
              <div class="flex items-center gap-2">
                <div
                  class="w-8 h-8 rounded-lg bg-ateliya-primary/10 flex items-center justify-center"
                >
                  <Icon name="shield" size="xs" class="text-ateliya-primary" />
                </div>
                <span class="text-xs font-bold text-gray-900">Securise</span>
              </div>
            </div>
          </div>

          <!-- Bouncing dots -->
          <div
            class="absolute top-[15%] right-[30%] w-3 h-3 rounded-full bg-ateliya-primary/28 steps-bounce-1"
          >
          </div>
          <div
            class="absolute bottom-[20%] left-[25%] w-3.5 h-3.5 rounded-full bg-ateliya-secondary/24 steps-bounce-2"
          >
          </div>
          <div
            class="absolute top-[50%] right-[5%] w-2.5 h-2.5 rounded-full bg-africa-gold/18 steps-bounce-1"
          >
          </div>

          <!-- Hatched circle -->
          <div class="absolute bottom-[5%] left-[12%] w-16 h-16 opacity-20">
            <div
              class="w-full h-full rounded-full"
              style="background: repeating-linear-gradient(45deg, transparent, transparent 2.5px, #B9975240 2.5px, #B9975240 5px);"
            >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---- Animations ---- */
  @keyframes stepsDeviceEntrance1 {
    from {
      opacity: 0;
      transform: translateX(-30px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }

  @keyframes stepsDeviceEntrance2 {
    from {
      opacity: 0;
      transform: translateY(30px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes stepsArcEntrance {
    from {
      opacity: 0;
      transform: scale(0.85);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes stepsFloatCard {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes stepsSpinSlow {
    from {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  @keyframes stepsBounce1 {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-6px) scale(1.1);
    }
  }

  @keyframes stepsBounce2 {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-4px) scale(0.9);
    }
  }

  .steps-device-1 {
    animation: stepsDeviceEntrance1 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }

  .steps-device-2 {
    animation: stepsDeviceEntrance2 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
  }

  .steps-arc-entrance {
    animation: stepsArcEntrance 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
  }

  .steps-float-card {
    animation: stepsFloatCard 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .steps-spin-slow {
    animation: stepsSpinSlow 35s linear infinite;
  }

  .steps-bounce-1 {
    animation: stepsBounce1 3s ease-in-out infinite;
  }

  .steps-bounce-2 {
    animation: stepsBounce2 3.5s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
