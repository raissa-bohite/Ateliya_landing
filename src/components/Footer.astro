---
import Icon from "./Icon.astro";
import { socials, navLinks, legalLinks } from "../data/footer";
---

<footer class="relative overflow-hidden bg-ateliya-dark text-white">
  <!-- BG -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div
      class="absolute top-0 right-0 w-[500px] h-[500px] bg-ateliya-primary/6 rounded-full blur-[150px]"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-ateliya-secondary/5 rounded-full blur-[120px]"
    >
    </div>
    <div
      class="absolute inset-0 opacity-[0.015]"
      style="background-image: radial-gradient(circle, #34C7B8 1px, transparent 1px); background-size: 40px 40px;"
    >
    </div>
  </div>

  <!-- Kente accent top -->
  <div
    class="h-1 bg-gradient-to-r from-ateliya-primary via-ateliya-secondary to-ateliya-primary opacity-40"
  >
  </div>

  <div
    class="container mx-auto px-6 lg:px-12 relative z-10 pt-16 md:pt-20 pb-10"
  >
    <!-- ---- MAIN GRID ---- -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8 mb-16 pb-16 border-b border-white/10"
    >
      <!-- Brand -->
      <div class="lg:col-span-4">
        <a href="/" class="inline-flex items-center gap-3 mb-6 group">
          <div
            class="w-11 h-11 bg-gradient-to-br from-ateliya-primary to-ateliya-secondary rounded-xl flex items-center justify-center text-white font-black text-lg group-hover:scale-110 transition-transform duration-300"
          >
            A
          </div>
          <span
            class="text-2xl font-black bg-gradient-to-r from-ateliya-primary to-ateliya-secondary bg-clip-text text-transparent"
          >
            Ateliya
          </span>
        </a>

        <p class="text-white/50 leading-relaxed mb-8 max-w-sm text-sm">
          La solution moderne pour gerer votre atelier de couture efficacement
          et professionnellement.
        </p>

        <!-- Social -->
        <div class="flex gap-2.5">
          {
            socials.map((social) => (
              <a
                href={social.href}
                class="footer-social w-10 h-10 flex items-center justify-center rounded-xl bg-white/5 border border-white/10 text-white/50 hover:text-white hover:bg-ateliya-primary/20 hover:border-ateliya-primary/40 transition-all duration-300"
                aria-label={social.name}
                set:html={social.svg}
              />
            ))
          }
        </div>
      </div>

      <!-- Navigation -->
      <div class="lg:col-span-2">
        <h3 class="text-sm font-black text-white uppercase tracking-wider mb-5">
          Navigation
        </h3>
        <ul class="space-y-3">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="group flex items-center gap-2.5 text-sm text-white/50 hover:text-ateliya-primary transition-colors duration-300"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-white/20 group-hover:bg-ateliya-primary group-hover:scale-150 transition-all duration-300" />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Legal -->
      <div class="lg:col-span-2">
        <h3 class="text-sm font-black text-white uppercase tracking-wider mb-5">
          Legal
        </h3>
        <ul class="space-y-3">
          {
            legalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="group flex items-center gap-2.5 text-sm text-white/50 hover:text-ateliya-primary transition-colors duration-300"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-white/20 group-hover:bg-ateliya-primary group-hover:scale-150 transition-all duration-300" />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Newsletter -->
      <div class="lg:col-span-4">
        <h3 class="text-sm font-black text-white uppercase tracking-wider mb-3">
          Newsletter
        </h3>
        <p class="text-sm text-white/40 mb-5">
          Recevez nos conseils et offres exclusives.
        </p>

        <form class="space-y-3" id="newsletter-form">
          <div class="footer-newsletter-group relative">
            <input
              type="email"
              placeholder="Votre email"
              required
              class="footer-input"
              aria-label="Email pour newsletter"
            />
            <button type="submit" class="footer-submit" id="newsletter-btn">
              S'abonner
            </button>
          </div>
        </form>

        <p class="text-xs text-white/30 mt-3">
          Desabonnement possible a tout moment.
        </p>
      </div>
    </div>

    <!-- ---- BOTTOM ---- -->
    <div class="flex justify-center">
      <p class="text-sm text-white/40">
        &copy; {new Date().getFullYear()} Ateliya. Tous droits reserves.
      </p>
    </div>
  </div>

  <!-- Scroll to top -->
  <button
    id="scroll-to-top"
    class="fixed bottom-8 right-8 w-11 h-11 flex items-center justify-center bg-white/10 backdrop-blur-md border border-white/15 text-white/60 hover:text-white hover:bg-ateliya-primary/20 hover:border-ateliya-primary/40 rounded-xl opacity-0 pointer-events-none translate-y-4 transition-all duration-300 z-50"
    aria-label="Retour en haut"
  >
    <Icon name="chevron-up" size="sm" />
  </button>
</footer>

<style>
  /* ---- Newsletter input group ---- */
  .footer-newsletter-group {
    display: flex;
    gap: 0;
    border-radius: 0.875rem;
    border: 2px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.04);
    overflow: hidden;
    transition: border-color 0.3s ease;
  }

  .footer-newsletter-group:focus-within {
    border-color: rgba(52, 199, 184, 0.3);
    background: rgba(255, 255, 255, 0.06);
  }

  .footer-input {
    flex: 1;
    padding: 0.75rem 1rem;
    background: transparent;
    border: none;
    color: white;
    font-size: 0.875rem;
    outline: none;
  }

  .footer-input::placeholder {
    color: rgba(255, 255, 255, 0.3);
  }

  .footer-submit {
    flex-shrink: 0;
    padding: 0.75rem 1.25rem;
    background: linear-gradient(135deg, #34c7b8, #0d6b5f);
    color: white;
    font-size: 0.8rem;
    font-weight: 800;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .footer-submit:hover {
    filter: brightness(1.15);
  }

  .footer-submit:active {
    transform: scale(0.97);
  }

  /* ---- Social hover ---- */
  .footer-social :global(svg) {
    width: 16px;
    height: 16px;
    transition: transform 0.3s ease;
  }

  .footer-social:hover :global(svg) {
    transform: scale(1.15);
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    /* Newsletter */
    const form = document.getElementById("newsletter-form");
    const btn = document.getElementById("newsletter-btn");

    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      const input = form.querySelector(
        'input[type="email"]',
      ) as HTMLInputElement;
      if (!btn || !input) return;

      const original = btn.textContent;
      btn.textContent = "Inscrit !";
      btn.style.opacity = "0.7";

      setTimeout(() => {
        input.value = "";
        btn.textContent = original;
        btn.style.opacity = "1";
      }, 2000);
    });

    /* Scroll to top */
    const scrollBtn = document.getElementById("scroll-to-top");
    if (!scrollBtn) return;

    const toggle = () => {
      const show = window.scrollY > 400;
      scrollBtn.classList.toggle("opacity-0", !show);
      scrollBtn.classList.toggle("pointer-events-none", !show);
      scrollBtn.classList.toggle("translate-y-4", !show);
    };

    window.addEventListener("scroll", toggle, { passive: true });
    scrollBtn.addEventListener("click", () =>
      window.scrollTo({ top: 0, behavior: "smooth" }),
    );
    toggle();
  });
</script>
