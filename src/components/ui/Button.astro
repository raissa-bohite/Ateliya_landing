---
/**
 * Composant Button modulaire
 * @param variant - "primary" | "africa" | "earth" | "blend" | "outline" | "ghost"
 * @param size - "sm" | "md" | "lg"
 * @param class - Classes Tailwind additionnelles
 */

interface Props {
  variant?: "primary" | "africa" | "earth" | "blend" | "outline" | "ghost";
  size?: "sm" | "md" | "lg";
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  class?: string;
}

const {
  variant = "primary",
  size = "md",
  type = "button",
  disabled = false,
  class: className = "",
} = Astro.props;

// Classes de base communes
const baseClasses =
  "font-semibold rounded-xl transition-[transform,background-color,border-color,box-shadow,color] duration-200 ease-out hover:-translate-y-px active:translate-y-0 active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none focus:outline-none focus:ring-2 focus:ring-offset-2";

// Variantes de style
const variantClasses = {
  primary:
    "bg-ateliya-primary text-white shadow-[0_8px_18px_rgba(47,175,164,0.14)] hover:bg-[#279f95] hover:shadow-[0_8px_18px_rgba(47,175,164,0.12)] focus:ring-ateliya-primary",
  
  africa:
    "bg-ateliya-primary text-white shadow-[0_8px_18px_rgba(47,175,164,0.14)] hover:bg-[#279f95] hover:shadow-[0_8px_18px_rgba(47,175,164,0.12)] focus:ring-ateliya-primary",
  
  earth:
    "bg-ateliya-primary text-white shadow-[0_8px_18px_rgba(47,175,164,0.14)] hover:bg-[#279f95] hover:shadow-[0_8px_18px_rgba(47,175,164,0.12)] focus:ring-ateliya-primary",
  
  blend:
    "bg-ateliya-primary text-white shadow-[0_8px_18px_rgba(47,175,164,0.14)] hover:bg-[#279f95] hover:shadow-[0_8px_18px_rgba(47,175,164,0.12)] focus:ring-ateliya-primary",
  
  outline:
    "border border-ateliya-primary/30 text-ateliya-primary bg-white hover:bg-ateliya-primary/5 hover:border-ateliya-primary/45 hover:text-ateliya-primary focus:ring-ateliya-primary shadow-none",
  
  ghost:
    "text-ateliya-primary bg-transparent hover:bg-ateliya-primary/5 focus:ring-ateliya-primary shadow-none",
};

// Aucun style inline : les boutons restent en couleur unie.
const blendStyle = "";

// Tailles
const sizeClasses = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-3 md:px-8 md:py-4",
  lg: "px-8 py-4 md:px-10 md:py-5 text-lg",
};

const classes = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`;
---

<button
  type={type}
  disabled={disabled}
  class={classes}
  style={blendStyle}
>
  <slot />
</button>
