---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Icon from "../components/Icon.astro";
import { sections } from "../data/conditions";
import Layout from "../layouts/Layout.astro";


---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Conditions d'Utilisation - Ateliya</title>
</head>
<body>
    <Layout title="Conditions d'Utilisation - Ateliya">
<Header />
<section id="top" class="min-h-[100dvh] bg-white relative overflow-hidden">
  <!-- Background subtil -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute top-0 right-1/4 w-[600px] h-[600px] bg-ateliya-primary/[0.025] rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 left-1/4 w-[500px] h-[500px] bg-ateliya-primary/[0.025] rounded-full blur-3xl"></div>
  </div>

  <!-- Pattern subtil -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.014]" style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><circle cx=%2250%22 cy=%2250%22 r=%222%22 fill=%22%2334C7B8%22/></svg>');" aria-hidden="true"></div>

  <div class="container mx-auto max-w-5xl px-6 py-16 md:py-24 relative z-10">
    
    <!-- Header -->
    <div class="text-center mb-16 space-y-6">
      <!-- Badge -->
      <div class="inline-block">
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-ateliya-primary/[0.08] border border-ateliya-primary/20">
          <Icon name="fileText" size="sm" class="text-ateliya-primary" />
          <span class="text-sm font-bold text-ateliya-dark tracking-wide">
            Version 1.0 • Novembre 2025
          </span>
        </div>
      </div>

      <!-- Title -->
      <h1 class="page-title text-ateliya-dark">
        <span class="block">Conditions</span>
        <span class="relative inline-block mt-2">
          <span class="relative z-10 text-ateliya-primary">
            d'Utilisation
          </span>
          <span class="absolute -inset-1 bg-gradient-to-r from-ateliya-secondary/10 to-ateliya-primary/10 hidden -z-10"></span>
        </span>
      </h1>

      <p class="text-lg text-ateliya-text/70 max-w-3xl mx-auto">
        Lisez attentivement ces conditions avant d'utiliser l'application Ateliya
      </p>

      <!-- Quick Navigation -->
      <div class="flex flex-wrap justify-center gap-3 pt-6">
        {sections.slice(0, 8).map((section) => (
          <a 
            href={`#section-${section.number}`}
            class="px-4 py-2 rounded-xl bg-white/[0.96] border border-ateliya-primary/20 hover:border-ateliya-primary/35 text-sm font-semibold text-ateliya-dark hover:bg-ateliya-primary/[0.04] transition-[transform,background-color,border-color,box-shadow,color] duration-200 ease-out"
          >
            {section.number}. {section.title}
          </a>
        ))}
      </div>
    </div>

    <!-- Content Sections -->
    <div class="space-y-12">
      {sections.map((section, index) => (
        <article 
          id={`section-${section.number}`}
          class="group/section scroll-mt-24"
        >
          <!-- Section Card -->
          <div class="relative">
            <!-- Glow effect -->
            <div class="hidden"></div>

            <!-- Card -->
            <div class="bg-white/[0.96] rounded-3xl p-8 md:p-10 border border-ateliya-primary/[0.14] group-hover/section:border-ateliya-primary/25 transition-[background-color,border-color,box-shadow] duration-200 ease-out shadow-[0_6px_18px_rgba(18,63,59,0.035)] hover:shadow-[0_8px_22px_rgba(18,63,59,0.045)]">
              
              <!-- Header -->
              <div class="flex items-start gap-6 mb-6">
                <!-- Icon Badge -->
                <div class="flex-shrink-0 w-16 h-16 rounded-2xl bg-ateliya-primary/[0.10] border border-ateliya-primary/15 flex items-center justify-center group-hover/section:-translate-y-px transition-[transform,opacity,background-color,border-color,box-shadow] duration-300 ease-out">
                  <Icon name={section.icon} size="xl" class="text-ateliya-primary" />
                </div>

                <!-- Title -->
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-2">
                    <span class="text-5xl font-black text-ateliya-primary/20">
                      {section.number}
                    </span>
                    <h2 class="text-3xl md:text-4xl font-serif font-extrabold tracking-tighter text-ateliya-dark">
                      {section.title}
                    </h2>
                  </div>
                  <div class="w-20 h-1 bg-ateliya-primary/35 rounded-full"></div>
                </div>
              </div>

              <!-- Highlight (si présent) -->
              {section.highlight && (
                <div class="mb-6 p-4 rounded-xl bg-ateliya-primary/5 border-l-4 border-ateliya-primary">
                  <p class="text-ateliya-dark font-bold flex items-start gap-2">
                    <Icon name="alertCircle" size="md" class="text-amber-500 flex-shrink-0 mt-0.5" />
                    <span>{section.highlight}</span>
                  </p>
                </div>
              )}

              <!-- Content -->
              <div class="space-y-4">
                {section.content && (
                  <p class="text-lg text-ateliya-text/80 leading-relaxed">
                    {section.content}
                  </p>
                )}

                <!-- List (si présent) -->
                {section.list && (
                  <ul class="space-y-3 mt-6">
                    {section.list.map((item) => (
                      <li class="flex items-start gap-3 group/item">
                        <span class="flex-shrink-0 w-6 h-6 rounded-lg bg-ateliya-primary/10 flex items-center justify-center mt-0.5 group-hover/item:bg-ateliya-primary/20 transition-colors duration-300">
                          <Icon name="check" size="sm" class="text-ateliya-primary" />
                        </span>
                        <div class="flex-1">
                          {item.title && (
                            <p class="font-bold text-ateliya-dark mb-1">
                              {item.title}
                            </p>
                          )}
                          <p class="text-ateliya-text/70">
                            {item.text}
                          </p>
                        </div>
                      </li>
                    ))}
                  </ul>
                )}

                <!-- Subsections (pour section 11) -->
                {section.subsections && (
                  <div class="space-y-6 mt-6">
                    {section.subsections.map((sub) => (
                      <div>
                        <h4 class="text-xl font-bold text-ateliya-dark mb-3">{sub.title}</h4>
                        <ul class="space-y-3">
                          {sub.list.map((item) => (
                            <li class="flex items-start gap-3 group/item">
                              <span class="flex-shrink-0 w-6 h-6 rounded-lg bg-ateliya-primary/10 flex items-center justify-center mt-0.5 group-hover/item:bg-ateliya-primary/20 transition-colors duration-300">
                                <Icon name="check" size="sm" class="text-ateliya-primary" />
                              </span>
                              <p class="text-ateliya-text/70">{item.text}</p>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                )}

                <!-- Footer (si présent) -->
                {section.footer && (
                  <div class="mt-6 p-4 rounded-xl bg-ateliya-primary/5 border border-ateliya-primary/20">
                    <p class="text-sm text-ateliya-text/80 italic">
                      {section.footer}
                    </p>
                  </div>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Contact CTA -->
    <div class="mt-20 relative">
      <!-- Glow -->
      <div class="hidden"></div>
      
      <!-- Card -->
      <div class="relative bg-white/[0.96] rounded-3xl p-10 md:p-12 border border-ateliya-primary/20 shadow-[0_14px_34px_rgba(18,63,59,0.07)]">
        <div class="text-center space-y-6">
          <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-ateliya-primary/10 border border-ateliya-primary/15 mb-4">
            <Icon name="messageSquare" size="2xl" class="text-ateliya-primary" />
          </div>
          
          <h3 class="text-3xl md:text-4xl font-black text-ateliya-dark">
            Questions sur les conditions ?
          </h3>
          
          <p class="text-lg text-ateliya-text/70 max-w-2xl mx-auto">
            Notre équipe est disponible pour répondre à toutes vos questions concernant nos conditions d'utilisation.
          </p>

          <a
            href="mailto:support@ateliya.com"
            class="btn-action"
          >
            <Icon name="mail" size="md" />
            <span>support@ateliya.com</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Back to top -->
    <div class="text-center mt-12">
      <a
        href="#top"
        class="inline-flex items-center gap-2 text-ateliya-primary font-semibold transition-colors duration-200"
      >
        <Icon name="chevronUp" size="md" />
        <span>Retour en haut</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Smooth scroll */
  html {
    scroll-behavior: smooth;
  }

  /* Animation au scroll */
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  article {
    animation: fade-in-up 0.6s ease-out both;
  }

  article:nth-child(1) { animation-delay: 0.1s; }
  article:nth-child(2) { animation-delay: 0.15s; }
  article:nth-child(3) { animation-delay: 0.2s; }

  /* Accessibilité */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
<Footer />
</Layout>
</body>
</html>

