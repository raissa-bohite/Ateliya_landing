---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import StitchDivider from "../components/ui/StitchDivider.astro";
import Icon from "../components/ui/Icon.astro";
import { WHATSAPP_URL } from "../data/nav";

const CHANNELS = [
  {
    title: "WhatsApp",
    value: "+225 05 01 24 29 29",
    description: "Écrivez-nous directement",
    href: WHATSAPP_URL,
    icon: "message" as const,
    primary: true,
  },
  {
    title: "Téléphone",
    value: "+225 05 01 24 29 29",
    description: "Appelez l'équipe Ateliya",
    href: "tel:+2250501242929",
    icon: "phone" as const,
    primary: false,
  },
  {
    title: "E-mail",
    value: "support@ateliya.com",
    description: "Pour les demandes détaillées",
    href: "mailto:support@ateliya.com",
    icon: "mail" as const,
    primary: false,
  },
];

const FAQ = [
  {
    question: "Comment obtenir de l'aide rapidement ?",
    answer:
      "Écrivez-nous sur WhatsApp ou appelez-nous au +225 05 01 24 29 29 pendant les horaires de disponibilité.",
  },
  {
    question: "Puis-je demander une présentation de l'application ?",
    answer:
      "Oui. Contactez-nous et l'équipe Ateliya pourra vous renseigner sur l'application et ses fonctionnalités.",
  },
  {
    question: "Où se trouve Ateliya ?",
    answer:
      "Ateliya fonctionne en ligne. L'assistance et les renseignements sont disponibles par téléphone, WhatsApp et e-mail.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<BaseLayout
  title="Contact — Ateliya"
  description="Contactez l'équipe Ateliya par WhatsApp, téléphone ou e-mail pour une question sur l'application."
>
  <Header />
  <main class="flex-1">
    <section class="bg-background px-5 pt-32 pb-10 text-center sm:pt-40 sm:pb-14">
      <div class="mx-auto max-w-3xl">
        <StitchDivider class="mb-7" />
        <p class="text-xs font-bold tracking-[0.2em] text-primary uppercase">
          Contact Ateliya
        </p>
        <h1 class="mt-5 font-serif text-4xl leading-tight tracking-tight text-text sm:text-6xl">
          Parlons de votre atelier.
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-7 text-text-secondary sm:text-lg">
          Une question sur l'application ou ses fonctionnalités ? Choisissez
          le moyen de contact qui vous convient.
        </p>
      </div>
    </section>

    <section class="bg-card px-5 py-10 sm:py-16">
      <div class="mx-auto grid max-w-6xl gap-4 md:grid-cols-3 md:gap-5">
        {
          CHANNELS.map((channel) => (
            <a
              href={channel.href}
              target={channel.href.startsWith("https:") ? "_blank" : undefined}
              rel={
                channel.href.startsWith("https:")
                  ? "noopener noreferrer"
                  : undefined
              }
              class:list={[
                "group flex min-h-[190px] flex-col rounded-2xl p-6 transition-transform hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2 sm:p-7",
                channel.primary
                  ? "bg-primary text-white"
                  : "border border-border bg-background text-text",
              ]}
            >
              <div class="flex items-center justify-between">
                <span
                  class:list={[
                    "flex h-11 w-11 items-center justify-center rounded-full",
                    channel.primary
                      ? "bg-white/15 text-white"
                      : "bg-primary-light text-primary",
                  ]}
                >
                  <Icon name={channel.icon} class="h-5 w-5" />
                </span>
                <Icon
                  name="arrow-up-right"
                  class:list={[
                    "h-[19px] w-[19px] transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5",
                    channel.primary ? "text-white/70" : "text-primary/55",
                  ]}
                />
              </div>
              <span
                class:list={[
                  "mt-5 text-xs font-bold tracking-[0.16em] uppercase",
                  channel.primary ? "text-white/65" : "text-primary",
                ]}
              >
                {channel.title}
              </span>
              <span class="mt-1 font-serif text-xl font-semibold">
                {channel.value}
              </span>
              <span
                class:list={[
                  "mt-1 text-sm",
                  channel.primary ? "text-white/75" : "text-text-secondary",
                ]}
              >
                {channel.description}
              </span>
            </a>
          ))
        }
      </div>

      <div class="mx-auto mt-6 flex max-w-6xl items-start gap-3 rounded-xl border border-border/80 px-5 py-4 text-sm text-text-secondary">
        <Icon name="clock" class="mt-0.5 h-[18px] w-[18px] shrink-0 text-primary" />
        <p>
          Disponibilité : du lundi au samedi, de 8 h à 20 h GMT. En dehors de
          ces horaires, vous pouvez laisser un message sur WhatsApp.
        </p>
      </div>
    </section>

    <section class="bg-background px-5 py-16 sm:py-20">
      <div class="mx-auto max-w-3xl">
        <header class="mb-8 text-center">
          <p class="text-xs font-bold tracking-[0.2em] text-primary uppercase">
            Questions fréquentes
          </p>
          <h2 class="mt-3 font-serif text-3xl text-text sm:text-4xl">
            Avant de nous écrire
          </h2>
        </header>
        <div class="space-y-3">
          {
            FAQ.map((item) => (
              <details class="group rounded-2xl border border-border/70 bg-card px-5 open:shadow-[0_20px_50px_-40px_rgba(7,31,20,0.4)]">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium text-text [&::-webkit-details-marker]:hidden">
                  {item.question}
                  <Icon
                    name="plus"
                    class="h-[18px] w-[18px] shrink-0 text-primary transition-transform duration-200 group-[[open]]:rotate-45"
                    strokeWidth={2.2}
                  />
                </summary>
                <p class="pb-5 text-sm leading-7 text-text-secondary">
                  {item.answer}
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</BaseLayout>
