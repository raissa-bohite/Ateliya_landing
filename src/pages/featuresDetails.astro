    </section> -->


   

   <!-- ==================== CTA FINAL ==================== -->
    <section id="demo" class="py-24 bg-white relative overflow-hidden">
      
      <!-- Decorative -->
      <div class="absolute inset-0 bg-gradient-to-br from-ateliya-primary/5 via-transparent to-ateliya-primary/5"></div>
      <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-ateliya-primary/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-ateliya-primary/10 rounded-full blur-3xl"></div>
      
      <div class="container mx-auto px-6 lg:px-12 max-w-4xl relative z-10">
        
        <div class="text-center reveal-on-scroll">
          
          <!-- Badge -->
          <div class="inline-flex items-center gap-2 px-6 py-3 bg-ateliya-primary/10 rounded-full text-ateliya-primary text-sm font-bold mb-8">
            <Icon name="gift" size="sm" class="text-ateliya-primary" />
            <span>Gratuit pendant 30 jours • Sans carte bancaire</span>
          </div>

          <!-- Title -->
          <h2 class="text-4xl md:text-5xl lg:text-6xl font-black text-gray-900 mb-6 leading-tight">
            Prêt à changer
            <br />
            <span class="text-ateliya-primary">votre façon de travailler ?</span>
          </h2>

          <p class="text-xl text-gray-600 mb-12 max-w-2xl mx-auto">
            Rejoignez les centaines de tailleurs ivoiriens qui ont choisi Ateliya.
          </p>

          <!-- Download buttons -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
            
            <!-- App Store -->
            <a href="#" class="group inline-flex items-center justify-center gap-4 px-8 py-5 bg-ateliya-primary text-white rounded-2xl hover:bg-ateliya-dark transition-all shadow-lg hover:shadow-xl">
              <svg class="w-10 h-10" viewBox="0 0 24 24" fill="currentColor">
