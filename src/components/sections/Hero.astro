
---
import AppStoreBadges from "../ui/AppStoreBadges.astro";
import Icon from "../ui/Icon.astro";
---

<section class="hero relative isolate min-h-svh overflow-hidden bg-hero pt-[72px]">
  <!-- Photo de fond : la couturière reste à droite -->
  <img
    src="/hero-image.webp"
    alt="Créatrice dans son atelier, avec l’application Ateliya affichée sur un téléphone posé sur la table"
    class="hero-photo absolute inset-0 -z-20 h-full w-full"
    fetchpriority="high"
    loading="eager"
    decoding="async"
  />

  <div
    class="hero-inner relative mx-auto flex min-h-[calc(100svh-72px)] w-full items-center px-5 py-12 sm:px-8 lg:px-[5.1vw] lg:py-16"
  >
    <!-- Contenu éditorial -->
    <div class="hero-copy relative z-10 w-full max-w-[610px]">
      <p
        class="animate-fade-up mb-6 inline-flex max-w-full rounded-full bg-primary-light/80 px-4 py-2 text-[10px] leading-relaxed font-semibold tracking-wide text-primary-dark sm:text-xs"
      >
        L’APPLICATION PENSÉE POUR LES ATELIERS DE COUTURE
      </p>

      <h1
        class="animate-fade-up font-serif text-[clamp(3rem,5.2vw,5rem)] leading-[.9] font-semibold tracking-[-.045em] text-primary-dark"
        style="animation-delay:.1s"
      >
        Votre talent crée<br class="hidden sm:block" />
        la mode. Ateliya<br class="hidden sm:block" />
        <span class="text-primary">organise le reste.</span>
      </h1>

      <p
        class="animate-fade-up mt-6 max-w-[460px] text-base leading-relaxed text-text-secondary sm:text-lg"
        style="animation-delay:.25s"
      >
        Clients, mensurations, commandes et paiements :
        gérez votre atelier de couture depuis une seule application.
      </p>

      <!-- Téléchargement de l'application -->
      <div
        class="animate-fade-up mt-7 flex flex-wrap items-center gap-3"
        style="animation-delay:.4s"
      >
        <AppStoreBadges />
      </div>

      <!-- Bénéfices -->
      <div
        class="animate-fade-up mt-9 grid max-w-[490px] grid-cols-4 divide-x divide-primary/20"
        style="animation-delay:.52s"
      >
        {[
          { icon: "users" as const, label: "Vos clients" },
          { icon: "receipt" as const, label: "Vos commandes" },
          { icon: "wallet" as const, label: "Vos paiements" },
          { icon: "trending-up" as const, label: "Votre atelier" },
        ].map((item) => (
          <div
            class="flex flex-col items-center gap-2 px-1 text-center text-[10px] font-medium text-primary-dark sm:text-sm"
          >
            <Icon name={item.icon} class="h-6 w-6 text-primary sm:h-7 sm:w-7" />
            <span>{item.label}</span>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>

<style>
  .hero {
    background-color: var(--color-hero);
  }

  /* Cette image réunit déjà la couturière, le téléphone et l'espace de texte. */
  .hero .hero-photo {
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: right center;
  }

  .hero-copy {
    text-wrap: pretty;
  }

  @media (min-width: 1280px) {
    .hero-copy { transform: translateY(-24px); }
  }

  /* Ordinateurs portables et écrans intermédiaires */
  @media (min-width: 1280px) and (max-width: 1450px) {
    .hero-copy {
      max-width: 540px;
    }
  }

  /* Tablettes : le visuel reste unique et le texte garde son fond crème. */
  @media (max-width: 1279px) {
    .hero .hero-photo {
      object-fit: cover;
      object-position: 72% center;
      opacity: 0.2;
    }
  }

  /* Téléphones mobiles */
  @media (max-width: 640px) {
    .hero {
      min-height: 100svh;
    }

    .hero-inner {
      min-height: calc(100svh - 72px);
      align-items: center;
      padding-top: 3rem;
      padding-bottom: 3rem;
    }

    .hero .hero-photo {
      object-position: 74% center;
    }

    .hero-copy {
      max-width: 100%;
      transform: none;
    }

    .hero-copy h1 {
      font-size: clamp(2.65rem, 10.2vw, 3.8rem);
      line-height: 0.99;
    }
  }

  /* Respect des préférences d'accessibilité */
  @media (prefers-reduced-motion: reduce) {
    .hero .animate-fade-up {
      animation: none !important;
    }
  }
</style>
