---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import StitchDivider from "../components/ui/StitchDivider.astro";
import LegalSection from "../components/ui/LegalSection.astro";
import { POLITIQUE, POLITIQUE_UPDATED } from "../data/politique";
---

<BaseLayout
  title="Politique de confidentialité — Ateliya"
  description="Politique de confidentialité et de protection des données personnelles de l'application Ateliya."
>
  <Header />
  <main class="flex-1">
    <section class="bg-background px-5 pt-32 pb-8 text-center sm:pt-40 sm:pb-10">
      <div class="mx-auto max-w-3xl">
        <StitchDivider class="mb-7" />
        <p class="text-xs font-bold tracking-[0.2em] text-primary uppercase">
          Mis à jour en {POLITIQUE_UPDATED}
        </p>
        <h1 class="mt-5 font-serif text-4xl leading-tight tracking-tight text-text sm:text-5xl">
          Politique de confidentialité.
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-7 text-text-secondary">
          Comment nous collectons, utilisons et protégeons vos données
          personnelles.
        </p>
      </div>
    </section>

    <section class="bg-card px-5 pb-20">
      <div class="mx-auto max-w-3xl divide-y divide-border">
        {POLITIQUE.map((section) => <LegalSection section={section} />)}
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
