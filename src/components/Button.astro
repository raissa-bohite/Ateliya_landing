---
interface Props {
  variant?: "primary" | "secondary" | "outline" | "ghost" | "danger";
  size?: "sm" | "md" | "lg" | "xl";
  href?: string;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  fullWidth?: boolean;
  icon?: string;
  iconPosition?: "left" | "right";
  class?: string;
  [key: string]: any;
}

const {
  variant = "primary",
  size = "md",
  href,
  type = "button",
  disabled = false,
  fullWidth = false,
  icon,
  iconPosition = "left",
  class: className = "",
  ...rest
} = Astro.props;

// Size classes
const sizeClasses = {
  sm: "px-4 py-2 text-sm rounded-lg",
  md: "px-6 py-3 text-base rounded-xl",
  lg: "px-8 py-4 text-lg rounded-xl",
  xl: "px-10 py-5 text-xl rounded-2xl",
};

// Variant classes
const variantClasses = {
  primary: `
    bg-ateliya-primary hover:bg-[#279f95]
    text-white font-bold
    shadow-[0_8px_18px_rgba(47,175,164,0.14)] hover:shadow-[0_8px_18px_rgba(47,175,164,0.12)]
    hover:-translate-y-px active:translate-y-0 active:scale-[0.98]
    border-0
    relative overflow-hidden
    group/btn
  `,
  secondary: `
    bg-ateliya-primary hover:bg-[#279f95]
    text-white font-bold
    shadow-[0_8px_18px_rgba(47,175,164,0.14)] hover:shadow-[0_8px_18px_rgba(47,175,164,0.12)]
    hover:-translate-y-px active:translate-y-0 active:scale-[0.98]
    border-0
    relative overflow-hidden
    group/btn
  `,
  outline: `
    bg-white
    text-ateliya-dark font-bold
    border border-ateliya-primary/30 hover:border-ateliya-primary/45
    hover:bg-ateliya-primary/5 hover:text-ateliya-dark
    shadow-sm hover:shadow-sm
    hover:-translate-y-px active:translate-y-0 active:scale-[0.98]
    relative overflow-hidden
    group/btn
  `,
  ghost: `
    bg-transparent
    text-ateliya-primary font-bold
    border-0
    hover:bg-ateliya-primary/5
    hover:-translate-y-px active:translate-y-0 active:scale-[0.98]
    relative overflow-hidden
    group/btn
  `,
  danger: `
    bg-red-500 hover:bg-red-600
    text-white font-bold
    shadow-[0_8px_18px_rgba(239,68,68,0.14)] hover:shadow-[0_8px_18px_rgba(239,68,68,0.12)]
    hover:-translate-y-px active:translate-y-0 active:scale-[0.98]
    border-0
    relative overflow-hidden
    group/btn
  `,
};

// Disabled classes
const disabledClasses = disabled
  ? "opacity-50 cursor-not-allowed pointer-events-none"
  : "cursor-pointer";

// Full width
const widthClasses = fullWidth ? "w-full" : "inline-flex";

// Classes finales
const buttonClasses = `
  ${sizeClasses[size]}
  ${variantClasses[variant]}
  ${disabledClasses}
  ${widthClasses}
  ${className}
  items-center justify-center gap-3
  transition-[transform,background-color,border-color,box-shadow,color] duration-200 ease-out
  focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ateliya-primary focus-visible:ring-offset-2
  select-none
`;

const Tag = href && !disabled ? "a" : "button";
const linkProps = href && !disabled ? { href } : {};
const buttonProps = !href ? { type, disabled } : {};
---

<Tag
  class={buttonClasses}
  {...linkProps}
  {...buttonProps}
  {...rest}
>
  <!-- Ripple effect au hover -->
  <span class="absolute inset-0 rounded-[inherit] bg-white/0 group-hover/btn:bg-white/10 scale-0 group-hover/btn:scale-100 transition-[transform,background-color] duration-300 ease-out" />

  <!-- Content -->
  <span class="relative z-10 flex items-center gap-3">
    {icon && iconPosition === "left" && (
      <span class="flex-shrink-0">
        <slot name="icon-left" />
      </span>
    )}
    
    <slot />
    
    {icon && iconPosition === "right" && (
      <span class="flex-shrink-0 group-hover/btn:translate-x-0.5 transition-transform duration-200 ease-out">
        <slot name="icon-right" />
      </span>
    )}
  </span>

</Tag>

<style>
  /* Empêcher la sélection du texte */
  button,
  a {
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
  }
</style>

