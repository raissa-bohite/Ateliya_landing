---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { stats, contactMethods, socialLinks } from "../data/contact";
---

<Layout title="Contact - Ateliya">
  <Header />

  <main class="bg-gradient-to-b from-white to-gray-50">
    <!-- Hero Section -->
    <section class="relative overflow-hidden py-20 md:py-24">
      <!-- Background -->
      <div class="absolute inset-0 pointer-events-none">
        <div
          class="absolute top-0 right-0 w-[600px] h-[600px] bg-ateliya-primary/3 rounded-full blur-3xl"
        >
        </div>
        <div
          class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-ateliya-secondary/2 rounded-full blur-3xl"
        >
        </div>
      </div>

      <div class="container mx-auto max-w-7xl px-6 relative z-10">
        <div class="text-center max-w-4xl mx-auto space-y-8">
          <!-- Badge -->
          <div class="inline-block">
            <div
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-ateliya-primary/8 border border-ateliya-primary/20"
            >
              <div
                class="w-2 h-2 rounded-full bg-ateliya-primary animate-pulse"
              >
              </div>
              <span class="text-sm font-bold text-ateliya-dark"
                >Support 24/7</span
              >
            </div>
          </div>

          <!-- Title -->
          <h1
            class="text-5xl md:text-4xl lg:text-6xl font-black text-ateliya-dark leading-[1.1]"
          >
            Une question ?
            <span
              class="mt-2 bg-gradient-to-r from-ateliya-primary via-ateliya-secondary to-ateliya-primary bg-clip-text text-transparent"
            >
              Parlons-en
            </span>
          </h1>

          <!-- Subtitle -->
          <p class="text-xl text-ateliya-text/70 leading-relaxed">
            Notre équipe d'experts est là pour vous aider à réussir
          </p>

          <!-- Stats -->
          <div class="flex flex-wrap justify-center gap-8 pt-6">
            {
              stats.map((stat) => (
                <div class="text-center">
                  <div class="text-4xl font-black bg-gradient-to-r from-ateliya-primary to-ateliya-secondary bg-clip-text text-transparent">
                    {stat.value}
                  </div>
                  <div class="text-sm text-ateliya-text/60 font-semibold mt-1">
                    {stat.label}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Main Contact Section -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto max-w-7xl px-6">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
          <!-- Contact Form - 3 cols -->
          <div class="lg:col-span-3">
            <div class="sticky top-24">
              <div
                class="bg-white rounded-3xl p-8 md:p-10 border border-gray-100 shadow-xl"
              >
                <div class="flex items-center justify-between mb-8">
                  <h2 class="text-3xl font-black text-ateliya-dark">
                    Envoyez-nous un message
                  </h2>
                  <div
                    class="flex items-center gap-2 text-sm text-ateliya-text/60"
                  >
                    <Icon name="lock" size="sm" />
                    <span>Sécurisé</span>
                  </div>
                </div>

                <form id="contactForm" class="space-y-6">
                  <!-- Name & Email -->
                  <div class="grid md:grid-cols-2 gap-6">
                    <div>
                      <label
                        for="name"
                        class="block text-sm font-bold text-ateliya-dark mb-2"
                      >
                        Nom complet *
                      </label>
                      <input
                        type="text"
                        id="name"
                        name="name"
                        required
                        class="w-full px-4 py-3.5 rounded-xl border border-gray-200 focus:border-ateliya-primary focus:outline-none focus:ring-4 focus:ring-ateliya-primary/10 transition-all"
                        placeholder="Jean Kouassi"
                      />
                    </div>
                    <div>
                      <label
                        for="email"
                        class="block text-sm font-bold text-ateliya-dark mb-2"
                      >
                        Email *
                      </label>
                      <input
                        type="email"
                        id="email"
                        name="email"
                        required
                        class="w-full px-4 py-3.5 rounded-xl border border-gray-200 focus:border-ateliya-primary focus:outline-none focus:ring-4 focus:ring-ateliya-primary/10 transition-all"
                        placeholder="jean@exemple.com"
                      />
                    </div>
                  </div>

                  <!-- Phone & Subject -->
                  <div class="grid md:grid-cols-2 gap-6">
                    <div>
                      <label
                        for="phone"
                        class="block text-sm font-bold text-ateliya-dark mb-2"
                      >
                        Téléphone
                      </label>
                      <input
                        type="tel"
                        id="phone"
                        name="phone"
                        class="w-full px-4 py-3.5 rounded-xl border border-gray-200 focus:border-ateliya-primary focus:outline-none focus:ring-4 focus:ring-ateliya-primary/10 transition-all"
                        placeholder="+225 XX XX XX XX"
                      />
                    </div>
                    <div>
                      <label
                        for="subject"
                        class="block text-sm font-bold text-ateliya-dark mb-2"
                      >
                        Sujet *
                      </label>
                      <select
                        id="subject"
                        name="subject"
                        required
                        class="w-full px-4 py-3.5 rounded-xl border border-gray-200 focus:border-ateliya-primary focus:outline-none focus:ring-4 focus:ring-ateliya-primary/10 transition-all"
                      >
                        <option value="">Choisissez...</option>
                        <option value="support">Support technique</option>
                        <option value="billing">Facturation</option>
                        <option value="feature">Nouvelle fonctionnalité</option>
                        <option value="partnership">Partenariat</option>
                        <option value="other">Autre</option>
                      </select>
                    </div>
                  </div>

                  <!-- Message -->
                  <div>
                    <label
                      for="message"
                      class="block text-sm font-bold text-ateliya-dark mb-2"
                    >
                      Message *
                    </label>
                    <textarea
                      id="message"
                      name="message"
                      required
                      rows="5"
                      class="w-full px-4 py-3.5 rounded-xl border border-gray-200 focus:border-ateliya-primary focus:outline-none focus:ring-4 focus:ring-ateliya-primary/10 transition-all resize-none"
                      placeholder="Décrivez votre demande en détail..."
                    ></textarea>
                    <div class="text-xs text-ateliya-text/60 mt-2">
                      <span id="charCount">0</span> / 500 caractères
                    </div>
                  </div>

                  <!-- Consent -->
                  <div class="flex items-start gap-3">
                    <input
                      type="checkbox"
                      id="consent"
                      name="consent"
                      required
                      class="w-5 h-5 rounded border-gray-300 text-ateliya-primary focus:ring-ateliya-primary mt-0.5"
                    />
                    <label for="consent" class="text-sm text-ateliya-text/70">
                      J'accepte que mes données soient utilisées pour répondre à
                      ma demande. <a
                        href="/privacy"
                        class="text-ateliya-primary font-semibold hover:underline"
                        >Politique de confidentialité</a
                      >
                    </label>
                  </div>

                  <!-- Submit -->
                  <button
                    type="submit"
                    class="w-full px-8 py-4 rounded-xl bg-gradient-to-r from-ateliya-primary to-ateliya-secondary text-white font-bold shadow-lg hover:shadow-xl hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-3 group"
                  >
                    <span>Envoyer le message</span>
                    <Icon
                      name="send"
                      size="md"
                      class="group-hover:translate-x-1 transition-transform"
                    />
                  </button>

                  <!-- Success Message -->
                  <div
                    id="successMsg"
                    class="hidden p-4 rounded-xl bg-green-50 border border-green-200"
                  >
                    <div class="flex items-center gap-3">
                      <div
                        class="w-10 h-10 rounded-full bg-green-500 flex items-center justify-center flex-shrink-0"
                      >
                        <Icon name="check" size="md" class="text-white" />
                      </div>
                      <div>
                        <p class="font-bold text-green-900">Message envoyé !</p>
                        <p class="text-sm text-green-700">
                          Nous vous répondrons sous 24h.
                        </p>
                      </div>
                    </div>
                  </div>
                </form>
              </div>
            </div>
          </div>

          <!-- Sidebar - 2 cols -->
          <div class="lg:col-span-2 space-y-6">
            <!-- Contact Methods -->
            <div class="space-y-4">
              <h3 class="text-xl font-black text-ateliya-dark mb-4">
                Autres moyens de contact
              </h3>

              {
                contactMethods.map((method) => (
                  <a
                    href={method.href}
                    class="group block p-6 rounded-2xl bg-white border border-gray-100 hover:border-ateliya-primary/30 hover:shadow-lg transition-all"
                  >
                    <div class="flex items-center gap-4">
                      <div
                        class={`w-12 h-12 rounded-xl bg-gradient-to-br ${method.gradient} flex items-center justify-center group-hover:scale-110 transition-transform`}
                      >
                        <Icon name={method.icon} size="md" class="text-white" />
                      </div>
                      <div class="flex-1">
                        <h4 class="font-bold text-ateliya-dark">
                          {method.title}
                        </h4>
                        <p class="text-sm text-ateliya-text/60">
                          {method.description}
                        </p>
                        <p class="text-sm font-bold text-ateliya-primary mt-1">
                          {method.value}
                        </p>
                      </div>
                      <Icon
                        name="arrowRight"
                        size="sm"
                        class="text-ateliya-primary opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all"
                      />
                    </div>
                  </a>
                ))
              }
            </div>

            <!-- Office Hours -->
            <div class="p-6 rounded-2xl bg-white border border-gray-100">
              <div class="flex items-center gap-3 mb-4">
                <div
                  class="w-10 h-10 rounded-xl bg-ateliya-accent/10 flex items-center justify-center"
                >
                  <Icon name="clock" size="md" class="text-ateliya-accent" />
                </div>
                <h3 class="font-black text-ateliya-dark">Horaires</h3>
              </div>
              <div class="space-y-2 text-sm">
                <div class="flex justify-between">
                  <span class="text-ateliya-text/70">Lun - Ven</span>
                  <span class="font-bold text-ateliya-dark">9h - 18h</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-ateliya-text/70">Samedi</span>
                  <span class="font-bold text-ateliya-dark">10h - 16h</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-ateliya-text/70">Dimanche</span>
                  <span class="font-bold text-red-500">Fermé</span>
                </div>
              </div>
            </div>

            <!-- Social Links -->
            <div
              class="p-6 rounded-2xl bg-gradient-to-br from-ateliya-primary/5 to-ateliya-secondary/5 border border-ateliya-primary/10"
            >
              <h3 class="font-black text-ateliya-dark mb-4">Suivez-nous</h3>
              <div class="flex gap-3">
                {
                  socialLinks.map((social) => (
                    <a
                      href={social.href}
                      aria-label={social.label}
                      class={`w-12 h-12 rounded-xl bg-white border border-gray-200 ${social.color} hover:text-white flex items-center justify-center transition-all hover:scale-110`}
                    >
                      <Icon name={social.icon} size="md" />
                    </a>
                  ))
                }
              </div>
            </div>

            <!-- Trust Badge -->
            <div
              class="p-6 rounded-2xl bg-gradient-to-br from-ateliya-dark to-ateliya-primary text-white"
            >
              <div class="flex items-center gap-3 mb-3">
                <Icon name="shield" size="lg" />
                <h3 class="font-black">100% Sécurisé</h3>
              </div>
              <p class="text-sm text-white/80">
                Vos données sont protégées par un chiffrement SSL/TLS de niveau
                bancaire
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->

    <!-- Location Section (Optional) -->
    <section class="py-20 md:py-24 bg-gray-50">
      <div class="container mx-auto max-w-6xl px-6">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <!-- Info -->
          <div class="space-y-6">
            <div
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-ateliya-primary/10"
            >
              <Icon name="mapPin" size="sm" class="text-ateliya-primary" />
              <span class="text-sm font-bold text-ateliya-dark"
                >Notre Bureau</span
              >
            </div>

            <h2 class="text-4xl font-black text-ateliya-dark">
              Venez nous rendre visite
            </h2>

            <p class="text-lg text-ateliya-text/70 leading-relaxed">
              Notre équipe vous accueille dans nos bureaux à Abidjan pour
              discuter de vos besoins et vous présenter Ateliya en détail.
            </p>

            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <div
                  class="w-10 h-10 rounded-xl bg-ateliya-primary/10 flex items-center justify-center flex-shrink-0"
                >
                  <Icon name="mapPin" size="md" class="text-ateliya-primary" />
                </div>
                <div>
                  <h4 class="font-bold text-ateliya-dark mb-1">Adresse</h4>
                  <p class="text-ateliya-text/70">
                    Plateau, Abidjan<br />Côte d'Ivoire
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div
                  class="w-10 h-10 rounded-xl bg-ateliya-primary/10 flex items-center justify-center flex-shrink-0"
                >
                  <Icon name="phone" size="md" class="text-ateliya-primary" />
                </div>
                <div>
                  <h4 class="font-bold text-ateliya-dark mb-1">Téléphone</h4>
                  <p class="text-ateliya-text/70">+225 27 XX XX XX XX</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div
                  class="w-10 h-10 rounded-xl bg-ateliya-primary/10 flex items-center justify-center flex-shrink-0"
                >
                  <Icon name="mail" size="md" class="text-ateliya-primary" />
                </div>
                <div>
                  <h4 class="font-bold text-ateliya-dark mb-1">Email</h4>
                  <p class="text-ateliya-text/70">support@ateliya.com</p>
                </div>
              </div>
            </div>

            <a
              href="#"
              class="inline-flex items-center gap-2 text-ateliya-primary font-bold hover:gap-3 transition-all"
            >
              <span>Obtenir l'itinéraire</span>
              <Icon name="arrowRight" size="sm" />
            </a>
          </div>

          <!-- Map Placeholder -->
          <div
            class="relative h-[400px] rounded-3xl overflow-hidden bg-gray-200"
          >
            <div
              class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-ateliya-primary/10 to-ateliya-secondary/10"
            >
              <div class="text-center">
                <Icon
                  name="mapPin"
                  size="3xl"
                  class="text-ateliya-primary mx-auto mb-4"
                />
                <p class="text-ateliya-dark font-bold">Carte interactive</p>
                <p class="text-sm text-ateliya-text/60">Bientôt disponible</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  select {
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
    background-position: right 0.75rem center;
    background-repeat: no-repeat;
    background-size: 1.5em 1.5em;
    padding-right: 2.5rem;
    appearance: none;
  }

  .faq-answer {
    display: none;
  }

  .faq-item.active .faq-answer {
    display: block;
  }

  .faq-item.active svg {
    transform: rotate(180deg);
  }

  /* Smooth scroll */
  html {
    scroll-behavior: smooth;
  }
</style>

<script>
  // Character counter
  const messageInput = document.getElementById(
    "message"
  ) as HTMLTextAreaElement;
  const charCount = document.getElementById("charCount");

  messageInput?.addEventListener("input", () => {
    const count = messageInput.value.length;
    if (charCount) {
      charCount.textContent = count.toString();
      charCount.style.color = count > 500 ? "#EF4444" : "";
    }
  });

  // Form submission
  const form = document.getElementById("contactForm");
  const successMsg = document.getElementById("successMsg");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const formData = new FormData(form as HTMLFormElement);
    const data = Object.fromEntries(formData.entries());

    // TODO: Replace with your API endpoint
    console.log("Form data:", data);

    // Show success message
    if (successMsg) {
      successMsg.classList.remove("hidden");
      (form as HTMLFormElement).reset();
      if (charCount) charCount.textContent = "0";

      setTimeout(() => {
        successMsg.classList.add("hidden");
      }, 5000);

      successMsg.scrollIntoView({ behavior: "smooth", block: "center" });
    }
  });

  // FAQ accordion
  document.querySelectorAll(".faq-item button").forEach((button) => {
    button.addEventListener("click", () => {
      const faqItem = button.closest(".faq-item");
      const allItems = document.querySelectorAll(".faq-item");

      // Close all other items
      allItems.forEach((item) => {
        if (item !== faqItem) {
          item.classList.remove("active");
        }
      });

      // Toggle current item
      faqItem?.classList.toggle("active");
    });
  });

  // Smooth scroll to form
  document.querySelectorAll('a[href="#contactForm"]').forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      form?.scrollIntoView({ behavior: "smooth", block: "start" });
      const firstInput = form?.querySelector("input");
      firstInput?.focus();
    });
  });
</script>
