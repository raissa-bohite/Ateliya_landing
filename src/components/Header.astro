---
import { navItems } from "../data/header";
import Icon from "./Icon.astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<header
  id="header"
  class:list={["fixed inset-x-0 top-0 z-50 transition-all duration-300", className]}
>
  <!-- Background -->
  <div class="absolute inset-0 bg-white/85 backdrop-blur-xl border-b border-gray-100 header-bg"></div>

  <!-- Kente accent -->
  <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-ateliya-primary via-ateliya-secondary to-ateliya-primary opacity-0 header-kente transition-opacity duration-500"></div>

  <!-- Bottom accent -->
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-ateliya-primary/15 to-transparent"></div>

  <nav
    class="container mx-auto px-6 lg:px-12 relative z-10 flex items-center justify-between h-16 md:h-[68px]"
    aria-label="Navigation principale"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 group" aria-label="Retour a l'accueil">
      <div class="relative w-9 h-9 md:w-10 md:h-10 bg-gradient-to-br from-ateliya-primary to-ateliya-secondary rounded-xl flex items-center justify-center text-white font-black text-base md:text-lg overflow-hidden group-hover:scale-105 transition-transform duration-300">
        <span class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700"></span>
        <span class="relative z-10">A</span>
      </div>
      <span class="hidden sm:inline text-xl font-black text-gray-900 group-hover:text-ateliya-primary transition-colors duration-300">
        Ateliya
      </span>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-0.5 bg-gray-50/60 border border-gray-100 rounded-full px-1 py-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="nav-link relative px-4 py-1.5 text-[13px] font-semibold text-gray-500 hover:text-ateliya-primary rounded-full transition-all duration-300 hover:bg-white/80"
        >
          {item.label}
        </a>
      ))}
    </div>

    <!-- Right -->
    <div class="flex items-center gap-2">

      <!-- Store buttons - Desktop -->
      <div class="hidden lg:flex items-center gap-1.5">
        <a
          href="#"
          class="store-btn flex items-center gap-2 px-3.5 py-1.5 bg-white text-gray-700 rounded-full border border-gray-100 hover:border-ateliya-primary/25 transition-all duration-300 group/store"
        >
          <svg class="w-4 h-4 text-gray-500 group-hover/store:text-ateliya-primary transition-colors duration-300" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
          </svg>
          <div class="flex flex-col items-start">
            <span class="text-[8px] leading-none text-gray-400 font-medium">Disponible sur</span>
            <span class="text-[11px] font-bold leading-tight text-gray-700">App Store</span>
          </div>
        </a>

        <a
          href="#"
          class="store-btn flex items-center gap-2 px-3.5 py-1.5 bg-gradient-to-r from-ateliya-primary to-ateliya-secondary text-white rounded-full transition-all duration-300 group/store"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.5,12.92 20.16,13.19L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/>
          </svg>
          <div class="flex flex-col items-start">
            <span class="text-[8px] leading-none opacity-70 font-medium">Disponible sur</span>
            <span class="text-[11px] font-bold leading-tight">Google Play</span>
          </div>
        </a>
      </div>

      <!-- Mobile toggle -->
      <button
        id="menu-toggle"
        class="md:hidden relative w-9 h-9 flex items-center justify-center rounded-xl hover:bg-gray-50 transition-colors duration-300"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
      >
        <div class="hamburger-icon" aria-hidden="true">
          <span class="hamburger-line hamburger-line-1"></span>
          <span class="hamburger-line hamburger-line-2"></span>
          <span class="hamburger-line hamburger-line-3"></span>
        </div>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="mobile-menu hidden md:hidden absolute top-full left-0 right-0 bg-white/98 backdrop-blur-xl border-b border-gray-100"
  >
    <div class="container mx-auto px-6 py-4 space-y-1">
      {navItems.map((item, index) => (
        <a
          href={item.href}
          class="mobile-nav-link group flex items-center gap-3 px-3 py-2.5 text-gray-600 font-semibold text-sm hover:text-ateliya-primary hover:bg-ateliya-primary/[0.04] rounded-xl transition-all duration-300"
          style={`animation-delay: ${index * 40}ms`}
        >
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-gray-50 border border-gray-100 group-hover:bg-ateliya-primary/8 group-hover:border-ateliya-primary/20 transition-all duration-300">
            <span class="text-sm">{item.icon}</span>
          </span>
          <span class="flex-1">{item.label}</span>
          <Icon name="chevron-right" size="xs" class="text-gray-300 group-hover:text-ateliya-primary group-hover:translate-x-0.5 transition-all duration-300" />
        </a>
      ))}

      <!-- Mobile store -->
      <div class="pt-3 grid grid-cols-2 gap-2">
        <a
          href="#"
          class="flex items-center justify-center gap-2 px-3 py-2.5 bg-gray-50 text-gray-600 rounded-xl border border-gray-100 hover:border-ateliya-primary/20 transition-all duration-300"
        >
          <svg class="w-4 h-4 text-gray-500" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
          </svg>
          <div class="flex flex-col items-start">
            <span class="text-[8px] leading-none text-gray-400">Disponible sur</span>
            <span class="text-[11px] font-bold leading-tight">App Store</span>
          </div>
        </a>
        <a
          href="#"
          class="flex items-center justify-center gap-2 px-3 py-2.5 bg-gradient-to-r from-ateliya-primary to-ateliya-secondary text-white rounded-xl transition-all duration-300"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.5,12.92 20.16,13.19L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/>
          </svg>
          <div class="flex flex-col items-start">
            <span class="text-[8px] leading-none opacity-70">Disponible sur</span>
            <span class="text-[11px] font-bold leading-tight">Google Play</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</header>

<!-- Spacer -->
<div class="h-16 md:h-[68px]" aria-hidden="true"></div>

<script>
  const initHeader = () => {
    const menuToggle = document.querySelector<HTMLButtonElement>("#menu-toggle");
    const mobileMenu = document.querySelector<HTMLDivElement>("#mobile-menu");
    const header = document.querySelector<HTMLElement>("#header");

    if (!menuToggle || !mobileMenu || !header) return;

    const toggleMenu = (show?: boolean) => {
      const shouldShow = show !== undefined ? show : mobileMenu.classList.contains("hidden");
      mobileMenu.classList.toggle("hidden", !shouldShow);
      menuToggle.classList.toggle("menu-open", shouldShow);
      menuToggle.setAttribute("aria-expanded", shouldShow.toString());
      menuToggle.setAttribute("aria-label", shouldShow ? "Fermer le menu" : "Ouvrir le menu");
      document.body.style.overflow = shouldShow ? "hidden" : "";
    };

    menuToggle.addEventListener("click", () => toggleMenu());

    document.querySelectorAll<HTMLAnchorElement>(".mobile-nav-link").forEach((link) => {
      link.addEventListener("click", () => toggleMenu(false));
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !mobileMenu.classList.contains("hidden")) toggleMenu(false);
    });

    let ticking = false;
    const updateHeader = () => {
      const scrolled = window.scrollY > 10;
      header.classList.toggle("is-scrolled", scrolled);
      ticking = false;
    };

    window.addEventListener("scroll", () => {
      if (!ticking) { window.requestAnimationFrame(updateHeader); ticking = true; }
    }, { passive: true });

    updateHeader();
  };

  document.addEventListener("astro:page-load", initHeader);
  document.addEventListener("DOMContentLoaded", initHeader);
</script>

<style>
  /* ---- Scroll state ---- */
  #header.is-scrolled .header-bg {
    background: rgba(255, 255, 255, 0.95);
    border-color: rgba(229, 231, 235, 0.5);
  }

  #header.is-scrolled .header-kente {
    opacity: 0.35;
  }

  /* ---- Hamburger ---- */
  .hamburger-line {
    @apply block absolute left-1/2 -translate-x-1/2 h-[1.5px] w-[18px] bg-gray-600 rounded-full transition-all duration-300;
  }

  .hamburger-line-1 { top: calc(50% - 5px); }
  .hamburger-line-2 { top: 50%; transform: translate(-50%, -50%); }
  .hamburger-line-3 { bottom: calc(50% - 5px); }

  .menu-open .hamburger-line-1 {
    top: 50%;
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .menu-open .hamburger-line-2 {
    opacity: 0;
    transform: translate(-50%, -50%) scaleX(0);
  }

  .menu-open .hamburger-line-3 {
    bottom: auto;
    top: 50%;
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  /* ---- Nav link ---- */
  .nav-link {
    position: relative;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 2px;
    left: 50%;
    width: 0;
    height: 1.5px;
    background: linear-gradient(90deg, var(--color-ateliya-primary), var(--color-ateliya-secondary));
    transform: translateX(-50%);
    border-radius: 999px;
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    width: 50%;
  }

  /* ---- Store buttons ---- */
  .store-btn {
    transition: transform 0.2s ease, border-color 0.3s ease;
  }

  .store-btn:hover {
    transform: translateY(-1px);
  }

  .store-btn:active {
    transform: translateY(0) scale(0.98);
  }

  /* ---- Mobile menu ---- */
  #mobile-menu:not(.hidden) {
    animation: menuSlideDown 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-nav-link {
    animation: menuItemReveal 0.25s cubic-bezier(0.4, 0, 0.2, 1) both;
  }

  @keyframes menuSlideDown {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes menuItemReveal {
    from { opacity: 0; transform: translateX(-8px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>