---
import { TESTIMONIALS } from "../../data/testimonials";
import StitchDivider from "../ui/StitchDivider.astro";
import Icon from "../ui/Icon.astro";

const TONES = [
  { card: "bg-primary text-white", quote: "text-white/15", avatar: "bg-white/15 text-white", meta: "text-white/65" },
  { card: "bg-gold text-primary-dark", quote: "text-primary-dark/15", avatar: "bg-primary-dark/15 text-primary-dark", meta: "text-primary-dark/65" },
  { card: "bg-primary-dark text-white", quote: "text-white/15", avatar: "bg-white/15 text-white", meta: "text-white/60" },
];
---

<section id="temoignages" class="bg-primary-light py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <header class="mx-auto mb-14 max-w-2xl text-center">
      <StitchDivider class="mb-7" />
      <p class="text-xs font-bold tracking-[0.2em] text-primary uppercase">
        La parole aux ateliers
      </p>
      <h2
        class="mt-4 font-serif text-4xl leading-tight tracking-tight text-text sm:text-5xl"
      >
        Ateliya au quotidien.
      </h2>
      <p class="mt-4 text-base leading-7 text-text-secondary sm:text-lg">
        Les retours de celles qui font vivre leur atelier chaque jour.
      </p>
    </header>

    <div class="grid gap-5 sm:gap-6 md:grid-cols-3">
      {
        TESTIMONIALS.map((testimonial, index) => {
          const initials = testimonial.author
            .split(" ")
            .map((word) => word[0])
            .join("")
            .slice(0, 2)
            .toUpperCase();
          const t = TONES[index % TONES.length];
          return (
            <figure
              class:list={[
                "relative flex flex-col overflow-hidden rounded-3xl p-7 shadow-[0_24px_60px_-40px_rgba(7,31,20,0.45)] transition-transform duration-300 hover:-translate-y-1.5 sm:p-8",
                t.card,
              ]}
            >
              <Icon
                name="quote"
                class:list={["absolute -top-3 right-6 h-20 w-20 sm:h-24 sm:w-24", t.quote]}
              />
              <blockquote class="relative mt-2 flex-1 font-serif text-lg leading-relaxed sm:text-xl">
                {testimonial.quote}
              </blockquote>
              <figcaption class="relative mt-7 flex items-center gap-3">
                <span
                  class:list={[
                    "flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-sm font-bold",
                    t.avatar,
                  ]}
                  aria-hidden="true"
                >
                  {initials}
                </span>
                <div>
                  <p class="font-semibold">{testimonial.author}</p>
                  <p class:list={["mt-0.5 text-sm", t.meta]}>
                    {testimonial.role}
                  </p>
                </div>
              </figcaption>
            </figure>
          );
        })
      }
    </div>
  </div>
</section>
