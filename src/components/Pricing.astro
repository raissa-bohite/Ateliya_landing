---
// components/PricingCard.astro
// Composant pour afficher un plan de tarification

interface Props {
  plan: string;
  price: string;
  period: string;
  features: string[];
  isPopular?: boolean;
  cta?: string;
  icon?: string;
  class?: string;
}

const {
  plan = "Plan",
  price = "0",
  period = "Par mois",
  features = [],
  isPopular = false,
  cta = "Commencer",
  icon = "✨",
  class: className = "",
} = Astro.props;
---

<div class={`group h-full transition-all duration-300 ${className}`}>
  <!-- Card Container -->
  <div
    class={`
      h-full rounded-2xl transition-all duration-300 relative overflow-hidden
      ${
        isPopular
          ? "card-featured shadow-glow-primary-lg border-2 border-ateliya-primary scale-105 md:scale-100 md:hover:scale-[1.01]"
          : "card-solid hover:shadow-medium hover:border-ateliya-primary"
      }
    `}
  >
    <!-- Popular Badge -->
    {isPopular && (
      <div class="absolute -top-4 -right-4 w-24 h-24 bg-gradient-primary/20 rounded-full blur-2xl" />
    )}

    {isPopular && (
      <div class="absolute top-4 right-4">
        <span class="badge-primary text-xs px-4 py-2">
          ⭐ Plus Populaire
        </span>
      </div>
    )}

    <!-- Content -->
    <div class="p-8 md:p-10 relative z-10 flex flex-col h-full">
      <!-- Icon & Plan Name -->
      <div class="mb-6">
        <div class="text-4xl mb-3 group-hover:scale-110 transition-transform">{icon}</div>
        <h3 class="text-2xl md:text-3xl font-bold text-ateliya-text">
          {plan}
        </h3>
      </div>

      <!-- Price -->
      <div class="mb-8">
        <div class="flex items-baseline gap-2">
          <span class="text-5xl md:text-6xl font-black text-ateliya-primary">
            {price}
          </span>
          {price !== "Gratuit" && <span class="text-ateliya-text-light font-medium">€</span>}
        </div>
        <p class="text-ateliya-text-light mt-2">{period}</p>
      </div>

      <!-- Features List -->
      <ul class="space-y-4 mb-8 flex-grow">
        {features.map((feature) => (
          <li class="flex items-start gap-3">
            <!-- Check Icon -->
            <div class="flex-shrink-0 w-5 h-5 rounded-full bg-ateliya-primary/20 flex items-center justify-center mt-0.5">
              <svg class="w-3 h-3 text-ateliya-primary" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"
                />
              </svg>
            </div>
            <!-- Feature Text -->
            <span class="text-ateliya-text-light">{feature}</span>
          </li>
        ))}
      </ul>

      <!-- CTA Button -->
      <button
        class={`
          w-full py-4 px-6 font-semibold rounded-lg transition-all duration-300 focus-ring
          ${
            isPopular
              ? "bg-ateliya-primary text-white hover:bg-[#279f95] shadow-[0_8px_18px_rgba(47,175,164,0.14)] hover:shadow-[0_8px_18px_rgba(47,175,164,0.12)] transform hover:-translate-y-1"
              : "border-2 border-ateliya-primary text-ateliya-primary hover:bg-ateliya-primary hover:text-white"
          }
        `}
      >
        {cta}
      </button>

      <!-- Footer Note -->
      <p class="text-xs text-ateliya-text-light text-center mt-6">
        Pas de carte de crédit requise
      </p>
    </div>

    <!-- Background Gradient (pour Popular) -->
    {isPopular && (
      <div class="absolute inset-0 bg-gradient-to-br from-ateliya-primary/5 to-transparent pointer-events-none" />
    )}
  </div>
</div>

<style>
  /* Badge styling */
  .badge-primary {
    @apply inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold bg-ateliya-primary text-white;
  }

  /* Card Featured */
  .card-featured {
    @apply bg-white border border-ateliya-border rounded-2xl transition-all duration-300 p-8 md:p-10;
  }

  /* Card Solid */
  .card-solid {
    @apply bg-white border border-ateliya-border rounded-2xl transition-all duration-300 p-8 md:p-10;
  }

  /* Focus Ring */
  .focus-ring {
    @apply focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-ateliya-primary;
  }
</style>
