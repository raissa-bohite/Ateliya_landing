---
import { Image } from "astro:assets";
import { navItems } from "../data/header";
import Icon from "./Icon.astro";
import logoImg from "../assets/ateliya.webp";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<header
  id="header"
  class:list={[
    "fixed inset-x-0 top-0 z-50 px-4 transition-all duration-300",
    className,
  ]}
>
  <!-- Background -->
  <div
    class="header-bg absolute inset-y-0 left-4 right-4 rounded-b-[1.35rem] border border-t-0 border-white/70 bg-white/55 shadow-[0_18px_55px_rgba(18,63,59,0.08)] backdrop-blur-2xl transition-all duration-300 lg:left-1/2 lg:right-auto lg:w-[min(calc(100%-2rem),76rem)] lg:-translate-x-1/2"
  >
  </div>

  <!-- Kente accent -->
  <div
    class="header-kente absolute left-8 right-8 top-0 h-px rounded-full bg-gradient-to-r from-transparent via-ateliya-primary/45 to-transparent opacity-0 transition-opacity duration-500 lg:left-1/2 lg:right-auto lg:w-[min(calc(100%-4rem),72rem)] lg:-translate-x-1/2"
  >
  </div>

  <!-- Bottom accent -->
  <div
    class="absolute bottom-0 left-8 right-8 h-px bg-gradient-to-r from-transparent via-ateliya-primary/10 to-transparent lg:left-1/2 lg:right-auto lg:w-[min(calc(100%-4rem),72rem)] lg:-translate-x-1/2"
  >
  </div>

  <nav
    class="container mx-auto px-3 sm:px-4 lg:px-6 relative z-10 flex items-center justify-between h-14 md:h-16"
    aria-label="Navigation principale"
  >
    <!-- Logo -->
    <a
      href="/"
      class="flex items-center gap-1.5 group"
      aria-label="Retour a l'accueil"
    >
      <Image
        src={logoImg}
        alt="logo Ateliya"
        class="h-9 w-auto object-contain group-hover:scale-[1.03] transition-transform duration-300"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
      <span
        class="hidden sm:inline text-lg font-semibold tracking-tight text-gray-900
           group-hover:text-ateliya-primary transition-colors duration-300"
      >
        Ateliya
      </span>
    </a>

    <!-- Desktop Navigation -->
    <div
      class="hidden md:flex items-center gap-0.5 rounded-full border border-white/60 bg-white/35 px-1 py-1 shadow-[inset_0_1px_0_rgba(255,255,255,0.65)]"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="nav-link relative px-3.5 py-1.5 text-[13px] font-medium text-gray-600 hover:text-ateliya-primary rounded-full transition-all duration-300 hover:bg-white/70"
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <!-- Right -->
    <div class="flex items-center gap-2">
      <!-- Register link - Desktop -->
      <a
        href="/connexion"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:inline-flex nav-link relative px-3.5 py-1.5 text-[13px] font-medium text-ateliya-primary hover:text-ateliya-secondary rounded-full transition-all duration-300 hover:bg-white/70"
      >
        S'inscrire
      </a>

      <!-- Store buttons - Desktop -->
      <div class="hidden lg:flex items-center gap-2">
        <a
          href="https://apps.apple.com/us/app/ateliya/id6755125319"
          target="_blank"
          rel="noopener noreferrer"
          class="store-btn flex items-center gap-2 px-3 py-1.5 bg-white/70 text-gray-800 rounded-xl border border-ateliya-primary/25 transition-all duration-300 group/store shadow-[inset_0_1px_0_rgba(255,255,255,0.7)]"
        >
          <svg
            class="w-5 h-5 flex-shrink-0"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"
            ></path>
          </svg>
          <div class="flex flex-col items-start">
            <span class="text-[8px] leading-none opacity-55 font-medium"
              >Disponible sur</span
            >
            <span class="text-[12px] font-semibold leading-tight">App Store</span>
          </div>
        </a>

        <a
          href="https://play.google.com/store/apps/details?id=com.ateliya.app"
          target="_blank"
          rel="noopener noreferrer"
          class="store-btn flex items-center gap-2 px-3 py-1.5 bg-gradient-to-r from-ateliya-primary to-ateliya-secondary text-white rounded-xl transition-all duration-300 shadow-sm shadow-ateliya-primary/20"
        >
          <svg
            class="w-5 h-5 flex-shrink-0"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.5,12.92 20.16,13.19L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"
            ></path>
          </svg>
          <div class="flex flex-col items-start">
            <span class="text-[8px] leading-none opacity-70 font-medium"
              >Disponible sur</span
            >
            <span class="text-[12px] font-semibold leading-tight">Google Play</span>
          </div>
        </a>
      </div>

      <!-- Mobile toggle -->
      <button
        id="menu-toggle"
        class="md:hidden relative w-9 h-9 flex items-center justify-center rounded-xl bg-white/45 hover:bg-white/70 transition-colors duration-300"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
      >
        <div class="hamburger-icon" aria-hidden="true">
          <span class="hamburger-line hamburger-line-1"></span>
          <span class="hamburger-line hamburger-line-2"></span>
          <span class="hamburger-line hamburger-line-3"></span>
        </div>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="mobile-menu hidden md:hidden absolute top-[calc(100%+0.5rem)] left-4 right-4 rounded-3xl border border-white/70 bg-white/92 backdrop-blur-xl shadow-[0_18px_55px_rgba(18,63,59,0.12)]"
  >
    <div class="container mx-auto px-4 py-3 space-y-1">
      {
        navItems.map((item, index) => (
          <a
            href={item.href}
            class="mobile-nav-link flex items-center gap-3 px-4 py-3 text-gray-800 font-semibold text-sm rounded-xl hover:bg-ateliya-primary/[0.06] transition-all duration-200"
            style={`animation-delay: ${index * 40}ms`}
          >
            <span
              class={`flex items-center justify-center w-8 h-8 rounded-lg bg-gray-100 ${item.color}`}
            >
              <Icon name={item.icon} size="sm" />
            </span>
            <span class="flex-1 text-gray-900">{item.label}</span>
            <Icon name="chevron-right" size="xs" class="text-gray-400" />
          </a>
        ))
      }

      <!-- Mobile register -->
      <a
        href="/connexion"
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-nav-link flex items-center gap-3 px-4 py-3 text-ateliya-primary font-semibold text-sm rounded-xl hover:bg-ateliya-primary/[0.06] transition-all duration-200"
      >
        <span
          class="flex items-center justify-center w-8 h-8 rounded-lg bg-ateliya-primary/10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle
              cx="9"
              cy="7"
              r="4"></circle><line x1="19" x2="19" y1="8" y2="14"></line><line
              x1="22"
              x2="16"
              y1="11"
              y2="11"></line></svg
          >
        </span>
        <span class="flex-1 text-ateliya-primary">S'inscrire</span>
        <Icon name="chevron-right" size="xs" class="text-gray-400" />
      </a>

      <!-- Mobile store -->
      <div class="pt-2 grid grid-cols-2 gap-2">
        <a
          href="https://apps.apple.com/us/app/ateliya/id6755125319"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2.5 px-4 py-3 bg-white/75 text-gray-800 rounded-xl border border-ateliya-primary/25 transition-all duration-300"
        >
          <svg
            class="w-5 h-5 flex-shrink-0"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"
            ></path>
          </svg>
          <div class="flex flex-col items-start">
            <span class="text-[9px] leading-none opacity-60 font-medium"
              >Disponible sur</span
            >
            <span class="text-[13px] font-bold leading-tight">App Store</span>
          </div>
        </a>
        <a
          href="https://play.google.com/store/apps/details?id=com.ateliya.app"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2.5 px-4 py-3 bg-gradient-to-r from-ateliya-primary to-ateliya-secondary text-white rounded-xl transition-all duration-300 shadow-md shadow-ateliya-primary/20"
        >
          <svg
            class="w-5 h-5 flex-shrink-0"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.5,12.92 20.16,13.19L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"
            ></path>
          </svg>
          <div class="flex flex-col items-start">
            <span class="text-[9px] leading-none opacity-70 font-medium"
              >Disponible sur</span
            >
            <span class="text-[13px] font-bold leading-tight">Google Play</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</header>

<!-- Spacer intentionally disabled: the floating header overlays the hero/page content. -->
<div class="h-0" aria-hidden="true"></div>

<script>
  const initHeader = () => {
    const menuToggle =
      document.querySelector<HTMLButtonElement>("#menu-toggle");
    const mobileMenu = document.querySelector<HTMLDivElement>("#mobile-menu");
    const header = document.querySelector<HTMLElement>("#header");

    if (!menuToggle || !mobileMenu || !header) return;

    const toggleMenu = (show?: boolean) => {
      const shouldShow =
        show !== undefined ? show : mobileMenu.classList.contains("hidden");
      mobileMenu.classList.toggle("hidden", !shouldShow);
      menuToggle.classList.toggle("menu-open", shouldShow);
      menuToggle.setAttribute("aria-expanded", shouldShow.toString());
      menuToggle.setAttribute(
        "aria-label",
        shouldShow ? "Fermer le menu" : "Ouvrir le menu",
      );
      document.body.style.overflow = shouldShow ? "hidden" : "";
    };

    menuToggle.addEventListener("click", () => toggleMenu());

    document
      .querySelectorAll<HTMLAnchorElement>(".mobile-nav-link")
      .forEach((link) => {
        link.addEventListener("click", () => toggleMenu(false));
      });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !mobileMenu.classList.contains("hidden"))
        toggleMenu(false);
    });

    let ticking = false;
    const updateHeader = () => {
      const scrolled = window.scrollY > 10;
      header.classList.toggle("is-scrolled", scrolled);
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateHeader);
          ticking = true;
        }
      },
      { passive: true },
    );

    updateHeader();
  };

  document.addEventListener("astro:page-load", initHeader);
  document.addEventListener("DOMContentLoaded", initHeader);
</script>

<style>
  /* ---- Scroll state ---- */
  #header.is-scrolled .header-bg {
    background: rgba(255, 255, 255, 0.88);
    border-color: rgba(255, 255, 255, 0.85);
    box-shadow: 0 18px 55px rgba(18, 63, 59, 0.11);
  }

  #header.is-scrolled .header-kente {
    opacity: 0.45;
  }

  /* ---- Hamburger ---- */
  .hamburger-line {
    @apply block absolute left-1/2 -translate-x-1/2 h-[1.5px] w-[18px] bg-gray-600 rounded-full transition-all duration-300;
  }

  .hamburger-line-1 {
    top: calc(50% - 5px);
  }
  .hamburger-line-2 {
    top: 50%;
    transform: translate(-50%, -50%);
  }
  .hamburger-line-3 {
    bottom: calc(50% - 5px);
  }

  .menu-open .hamburger-line-1 {
    top: 50%;
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .menu-open .hamburger-line-2 {
    opacity: 0;
    transform: translate(-50%, -50%) scaleX(0);
  }

  .menu-open .hamburger-line-3 {
    bottom: auto;
    top: 50%;
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  /* ---- Nav link ---- */
  .nav-link {
    position: relative;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 2px;
    left: 50%;
    width: 0;
    height: 1.5px;
    background: linear-gradient(
      90deg,
      var(--color-ateliya-primary),
      var(--color-ateliya-secondary)
    );
    transform: translateX(-50%);
    border-radius: 999px;
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    width: 50%;
  }

  /* ---- Store buttons ---- */
  .store-btn {
    transition:
      transform 0.2s ease,
      border-color 0.3s ease;
  }

  .store-btn:hover {
    transform: translateY(-1px);
    border-color: rgba(47, 175, 164, 0.22);
  }

  .store-btn:active {
    transform: translateY(0) scale(0.98);
  }

  /* ---- Mobile menu ---- */
  #mobile-menu:not(.hidden) {
    animation: menuSlideDown 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-nav-link {
    animation: menuItemReveal 0.25s cubic-bezier(0.4, 0, 0.2, 1) both;
  }

  @keyframes menuSlideDown {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes menuItemReveal {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
