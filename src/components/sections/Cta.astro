---
import { Picture } from "astro:assets";
import ctaImg from "../../assets/cta.webp";
import { APP_STORE_URL, GOOGLE_PLAY_URL } from "../../data/nav";
---

<section id="contact" class="bg-primary-dark px-4 py-10 sm:px-6 sm:py-14">
  <div
    class="relative mx-auto flex min-h-[520px] max-w-6xl items-center justify-center overflow-hidden rounded-[2rem] text-center sm:min-h-[600px]"
  >
    <Picture
      src={ctaImg}
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      widths={[640, 1024, 1536]}
      sizes="(min-width: 1200px) 1152px, 100vw"
      alt="Rejoignez la communauté des ateliers Ateliya"
      pictureAttributes={{ class: "absolute inset-0 h-full w-full" }}
      class="h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-primary-dark/55"></div>

    <div class="relative z-10 flex flex-col items-center px-6 py-16">
      <h2
        class="max-w-3xl font-serif text-5xl leading-[1.02] font-bold text-white sm:text-6xl lg:text-7xl"
        style="text-shadow:0 2px 24px rgba(0,0,0,.55)"
      >
        Rejoignez Ateliya maintenant.
      </h2>
      <p
        class="mt-5 max-w-xl text-base text-white/85 sm:text-lg"
        style="text-shadow:0 1px 10px rgba(0,0,0,.55)"
      >
        Téléchargez l'application et gérez tout votre atelier de couture depuis
        votre mobile.
      </p>

      <div
        class="mt-9 inline-flex items-center gap-4 rounded-full bg-gold py-2.5 pr-2.5 pl-6 text-primary-dark shadow-xl"
      >
        <span class="text-sm font-semibold sm:text-base">Télécharger l'app</span>
        <a
          href={APP_STORE_URL}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Télécharger sur l'App Store"
          class="transition-transform hover:-translate-y-0.5"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"></path></svg>
        </a>
        <a
          href={GOOGLE_PLAY_URL}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Disponible sur Google Play"
          class="transition-transform hover:-translate-y-0.5"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true"><path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.5,12.92 20.16,13.19L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"></path></svg>
        </a>
        <span class="h-9 w-px bg-primary-dark/25"></span>
        <div class="rounded-xl bg-white p-1.5">
          <img
            src="/qr-download.png"
            alt="QR code pour télécharger Ateliya"
            width="44"
            height="44"
            class="h-11 w-11"
          />
        </div>
      </div>
    </div>
  </div>
</section>
