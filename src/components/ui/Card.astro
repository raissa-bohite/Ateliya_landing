---
/**
 * Composant Card modulaire avec glassmorphism
 * @param variant - "glass" | "africa" | "solid"
 * @param hover - Active l'effet hover
 * @param padding - "none" | "sm" | "md" | "lg"
 * @param class - Classes Tailwind additionnelles
 */

interface Props {
  variant?: "glass" | "africa" | "solid";
  hover?: boolean;
  padding?: "none" | "sm" | "md" | "lg";
  class?: string;
}

const {
  variant = "glass",
  hover = true,
  padding = "md",
  class: className = "",
} = Astro.props;

// Classes de base
const baseClasses =
  "rounded-2xl transition-[transform,background-color,border-color,box-shadow] duration-200 ease-out";

// Variantes de style
const variantClasses = {
  glass:
    "bg-white/[0.92] border border-ateliya-border/[0.55] shadow-[0_6px_18px_rgba(18,63,59,0.035)]",
  
  africa:
    "border border-ateliya-border/[0.55] relative overflow-hidden bg-white/[0.94] shadow-[0_6px_18px_rgba(18,63,59,0.035)]",
  
  solid:
    "bg-white border border-ateliya-border",
};

// Effets hover
const hoverClasses = hover
  ? {
      glass: "hover:shadow-md hover:bg-white/95",
      africa: "hover:shadow-md hover:border-ateliya-primary/25 hover:bg-white/95",
      solid: "hover:shadow-md hover:-translate-y-px",
    }[variant]
  : "";

// Padding
const paddingClasses = {
  none: "",
  sm: "p-4",
  md: "p-6",
  lg: "p-8",
};

const classes = `${baseClasses} ${variantClasses[variant]} ${hoverClasses} ${paddingClasses[padding]} ${className}`;
---

<div class={classes}>
  <slot />
</div>

<style>
  /* Pattern africain pour variant africa */
  .variant-africa {
    background-image: linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.85) 0%,
        rgba(212, 175, 116, 0.05) 100%
      ),
      linear-gradient(
        45deg,
        transparent 48%,
        rgba(212, 175, 116, 0.03) 49%,
        rgba(212, 175, 116, 0.03) 51%,
        transparent 52%
      );
    background-size: 100% 100%, 20px 20px;
  }
</style>
