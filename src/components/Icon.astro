---
import {
  Menu,
  X,
  ChevronDown,
  ChevronRight,
  ChevronUp,
  ChevronLeft,
  ArrowRight,
  ArrowLeft,
  ArrowUp,
  ArrowDown,
  Download,
  Upload,
  Search,
  Check,
  CheckCircle,
  Bell,
  Mail,
  Phone,
  MapPin,
  MessageCircle,
  BarChart3,
  TrendingUp,
  TrendingDown,
  CreditCard,
  ShoppingCart,
  Package,
  Gift,
  Lock,
  Unlock,
  Key,
  Star,
  Heart,
  Zap,
  Clock,
  Calendar,
  User,
  Users,
  UserPlus,
  Globe,
  Settings,
  Info,
  HelpCircle,
  Eye,
  EyeOff,
  AlertCircle,
  AlertTriangle,
  FileText,
  File,
  Smartphone,
  Smile,
  Frown,
  Ruler,
  Scissors,
  BookOpen,
  Facebook,
  Twitter,
  Instagram,
  Linkedin,
  Image,
  PlayCircle,
  Sparkles,
  Shield,
  RefreshCw,
  Tag,
  MessageSquare,
  Edit,
  Plus,
  Receipt,
  PieChart,
  Share2,
  Printer,
  Cloud,
  Activity,
  Headphones,
  Quote,
  Rocket,
  Compass,
  type LucideProps
} from "lucide-astro";

export interface Props extends Omit<LucideProps, 'name'> {
  name: string;
  size?: "xs" | "sm" | "md" | "lg" | "xl" | "2xl";
  class?: string;
}

const {
  name,
  size = "md",
  class: customClass = "",
  ...rest
} = Astro.props;

// Size mapping
const sizeMap = {
  xs: 12,
  sm: 16,
  md: 24,
  lg: 32,
  xl: 40,
  "2xl": 48,
};

const iconSize = sizeMap[size as keyof typeof sizeMap] || 24;

// Icon component mapping (kebab-case to PascalCase)
const iconMap: Record<string, any> = {
  // Navigation
  menu: Menu,
  close: X,
  x: X,
  "chevron-down": ChevronDown,
  chevronDown: ChevronDown,
  "chevron-right": ChevronRight,
  chevronRight: ChevronRight,
  "chevron-up": ChevronUp,
  chevronUp: ChevronUp,
  "chevron-left": ChevronLeft,
  chevronLeft: ChevronLeft,
  "arrow-right": ArrowRight,
  arrowRight: ArrowRight,
  "arrow-left": ArrowLeft,
  arrowLeft: ArrowLeft,
  "arrow-up": ArrowUp,
  arrowUp: ArrowUp,
  "arrow-down": ArrowDown,
  arrowDown: ArrowDown,

  // Actions
  download: Download,
  upload: Upload,
  search: Search,
  check: Check,
  "check-circle": CheckCircle,
  checkCircle: CheckCircle,
  bell: Bell,
  mail: Mail,
  phone: Phone,
  "phone-call": Phone,
  "phone-incoming": Phone,
  "map-pin": MapPin,
  mapPin: MapPin,
  "message-circle": MessageCircle,
  messageCircle: MessageCircle,
  "message-square": MessageSquare,
  messageSquare: MessageSquare,

  // Data
  chart: BarChart3,
  "bar-chart": BarChart3,
  barChart: BarChart3,
  trending: TrendingUp,
  "trending-up": TrendingUp,
  trendingUp: TrendingUp,
  "trending-down": TrendingDown,
  trendingDown: TrendingDown,

  // Commerce
  "credit-card": CreditCard,
  creditCard: CreditCard,
  "dollar-sign": CreditCard,
  shoppingCart: ShoppingCart,
  package: Package,
  gift: Gift,
  tag: Tag,

  // Security
  lock: Lock,
  unlocked: Unlock,
  key: Key,
  shield: Shield,
  
  // Misc
  star: Star,
  heart: Heart,
  zap: Zap,
  clock: Clock,
  calendar: Calendar,
  refresh: RefreshCw,
  
  // User
  user: User,
  users: Users,
  "user-plus": UserPlus,
  userPlus: UserPlus,
  
  // System
  globe: Globe,
  settings: Settings,
  info: Info,
  "help-circle": HelpCircle,
  helpCircle: HelpCircle,
  eye: Eye,
  "eye-off": EyeOff,
  eyeOff: EyeOff,
  "alert-circle": AlertCircle,
  alertCircle: AlertCircle,
  "alert-triangle": AlertTriangle,
  "file-text": FileText,
  fileText: FileText,
  file: File,
  smartphone: Smartphone,
  image: Image,
  "play-circle": PlayCircle,
  playCircle: PlayCircle,
  sparkles: Sparkles,
  
  // Tools
  ruler: Ruler,
  measure: Ruler,
  scissors: Scissors,
  bookOpen: BookOpen,
  printer: Printer,
  cloud: Cloud,
  "share-2": Share2,
  activity: Activity,
  headphones: Headphones,
  edit: Edit,
  plus: Plus,
  rocket: Rocket,
  compass: Compass,
  
  // Finance
  receipt: Receipt,
  "pie-chart": PieChart,
  pieChart: PieChart,
  
  // Social
  facebook: Facebook,
  twitter: Twitter,
  instagram: Instagram,
  linkedin: Linkedin,
  
  // Misc Elements
  quote: Quote,
};

// Normalize name to handle potential inconsistencies
const normalizedName = name;
const IconComponent = iconMap[normalizedName] || iconMap[normalizedName.toLowerCase()] || Info;
---

<IconComponent size={iconSize} class={customClass} {...rest} />
