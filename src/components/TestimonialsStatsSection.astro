---
import Icon from "../components/Icon.astro";
import { testimonials, stats } from "../data/data";

// Configuration des stats avec icônes
const statsConfig = stats.slice(0, 4).map((stat, index) => ({
  ...stat,
  icon: index === 0 ? "users" : index === 1 ? "trendingUp" : index === 2 ? "star" : "heart",
  color: index % 2 === 0 ? "text-ateliya-primary" : "text-ateliya-secondary"
}));
---

<section 
  id="testimonials"
  class="section-padding-lg relative overflow-hidden" 
  style="background: linear-gradient(135deg, #D4F1F0 0%, #e8f9f8 50%, #D4F1F0 100%);"
>
  <!-- Patterns subtils -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.02]" style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 1200 600%22><defs><pattern id=%22features-pattern%22 patternUnits=%22userSpaceOnUse%22 width=%22120%22 height=%22120%22><circle cx=%2260%22 cy=%2260%22 r=%222%22 fill=%22%230D6B5F%22/><circle cx=%2290%22 cy=%2290%22 r=%221%22 fill=%22%23D4AF37%22/><line x1=%2260%22 y1=%2260%22 x2=%2290%22 y2=%2290%22 stroke=%22%2334C7B8%22 stroke-width=%220.5%22/></pattern></defs><rect width=%221200%22 height=%22600%22 fill=%22url(%23features-pattern)%22/></svg>');" aria-hidden="true"></div>
  
  <div class="absolute inset-0 pointer-effects-none opacity-[0.03]" style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 1200 600%22><defs><pattern id=%22etapes-pattern%22 patternUnits=%22userSpaceOnUse%22 width=%22100%22 height=%22100%22><path d=%22M50,0 Q75,25 50,50 Q25,75 0,50 Q25,25 50,0%22 fill=%22none%22 stroke=%22%230D6B5F%22 stroke-width=%220.5%22/></pattern></defs><rect width=%221200%22 height=%22600%22 fill=%22url(%23etapes-pattern)%22/></svg>');" aria-hidden="true"></div>

  <!-- Background gradients -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute top-0 right-1/3 w-[500px] h-[500px] bg-ateliya-primary/5 rounded-full blur-3xl animate-float" style="animation-delay: 0s;"></div>
    <div class="absolute bottom-0 left-1/4 w-[600px] h-[600px] bg-ateliya-secondary/4 rounded-full blur-3xl animate-float" style="animation-delay: 2s;"></div>
  </div>

  <div class="container-wide relative z-10">
    <!-- Main Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-15 items-center mb-20">
      
      <!-- Left Section: Content -->
      <div class="space-y-2 animate-fade-in-up" data-animate style="animation-delay: 100ms; ">
        
        <!-- Badge -->
        <div class="inline-block p-10">
          <div class="inline-flex items-center gap-1.5 px-2 py-2 rounded-full bg-gradient-to-r from-ateliya-primary/10 via-ateliya-primary/15 to-ateliya-primary/10 border border-ateliya-primary/30 backdrop-blur-sm group/badge hover:border-ateliya-primary/50 hover:shadow-lg hover:shadow-ateliya-primary/10 transition-all duration-500">
            <Icon name="messageSquare" size="sm" class="text-ateliya-primary group-hover/badge:rotate-12 transition-transform duration-300" />
            <span class="text-sm font-bold text-ateliya-dark tracking-wide">
              Témoignages Clients
            </span>
          </div>
        </div>

        <!-- Title -->
        <div class="space-y-2 top-4">
          <h2 class="text-4xl md:text-4xl lg:text-5xl font-black leading-tight text-ateliya-dark">
            <span class="block">Ce que nos</span>
            <span class="relative inline-block mt-2">
              <span class="relative z-10 bg-gradient-to-r from-ateliya-primary via-ateliya-secondary to-ateliya-primary bg-clip-text text-transparent bg-[length:200%_auto] animate-gradient-x">
                clients
              </span>
              <span class="absolute -inset-1 bg-gradient-to-r from-ateliya-primary/20 to-ateliya-secondary/20 blur-xl -z-10 animate-pulse-slow" />
            </span>
            <span class="block mt-2">disent de nous</span>
          </h2>

          <!-- Description -->
          <p class="text-lg md:text-xl text-ateliya-text/70 max-w-xl leading-relaxed">
            Plus de <span class="font-bold text-ateliya-primary">500 ateliers</span> en Afrique font confiance à Ateliya pour transformer leur gestion quotidienne.
          </p>
        </div>

        <!-- Trust indicators -->
        <div class="flex flex-wrap items-center gap-6">
          <div class="flex items-center gap-2">
            <div class="flex">
              {[...Array(5)].map(() => (
                <Icon name="star" size="sm" class="text-[#D4AF37] fill-current" />
              ))}
            </div>
            <span class="text-sm font-bold text-ateliya-text/70">4.9/5 sur 500+ avis</span>
          </div>
          
          <div class="h-8 w-px bg-ateliya-primary/20"></div>
          
          <div class="flex -space-x-2">
            {[1, 2, 3, 4].map((i) => (
              <div class="w-10 h-10 rounded-full border-2 border-white bg-gradient-to-br from-ateliya-primary to-ateliya-secondary flex items-center justify-center text-white font-bold text-sm shadow-lg hover:scale-110 hover:z-10 transition-transform duration-300">
                {i}
              </div>
            ))}
            <div class="w-10 h-10 rounded-full border-2 border-white bg-ateliya-dark flex items-center justify-center text-white font-bold text-xs shadow-lg">
              +500
            </div>
          </div>
        </div>

        <!-- CTA Button -->
        
          <a href="#all-testimonials"
          class="inline-flex items-center gap-3 px-8 py-4 rounded-2xl bg-white border-2 border-ateliya-primary/30 hover:border-ateliya-primary text-ateliya-dark font-bold hover:bg-ateliya-primary/5 transition-all duration-300 hover:scale-105 active:scale-95 shadow-md hover:shadow-xl group/cta"
        >
          <span>Voir tous les témoignages</span>
          <Icon
            name="arrowRight"
            size="md"
            class="text-ateliya-primary group-hover/cta:translate-x-1 transition-transform duration-300"
          />
        </a>
     
    <div class="mt-15 pt-20 border-t-2 border-ateliya-primary/20">
      <!-- Stats Header -->
     

      <!-- Stats Grid - CHANGÉ EN 3 COLONNES -->
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-6">
        {statsConfig.map((stat, i) => (
          <div
            class="animate-fade-in-up group/stat"
            data-animate
            style={`animation-delay: ${500 + i * 100}ms`}
          >
            <div class="relative">
              <!-- Glow Background -->
              <div class="absolute -inset-1 bg-gradient-to-br from-ateliya-primary/20 to-ateliya-secondary/10 rounded-2xl blur-lg opacity-0 group-hover/stat:opacity-70 transition-all duration-700 -z-10"></div>

              <!-- Stat Card -->
              <div class="relative bg-white/90 backdrop-blur-sm border-2 border-ateliya-primary/20 group-hover/stat:border-ateliya-primary/40 rounded-2xl p-6 text-center transition-all duration-500 hover:shadow-2xl hover:-translate-y-1">
                
                <!-- Icon -->
                <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl bg-gradient-to-br from-ateliya-primary/15 to-ateliya-primary/5 mb-4 group-hover/stat:scale-110 group-hover/stat:rotate-6 transition-all duration-300">
                  <Icon name={stat.icon} size="lg" class="text-ateliya-primary" />
                </div>

                <!-- Value -->
                <p class="text-4xl md:text-5xl font-black bg-gradient-to-r from-ateliya-primary to-ateliya-secondary bg-clip-text text-transparent mb-2 group-hover/stat:scale-110 transition-transform duration-300">
                  {stat.value}
                </p>

                <!-- Label -->
                <p class="text-sm md:text-base text-ateliya-text/70 font-bold">
                  {stat.label}
                </p>

                <!-- Progress bar -->
                <div class="absolute bottom-0 left-0 right-0 h-1 bg-ateliya-primary/10 rounded-b-2xl overflow-hidden">
                  <div class="h-full w-0 bg-gradient-to-r from-ateliya-primary to-ateliya-secondary group-hover/stat:w-full transition-all duration-1000 ease-out"></div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
      </div>

      <!-- Right Section: Featured Testimonial -->
      <div class="animate-fade-in-up" data-animate style="animation-delay: 300ms;">
        <div class="group/card relative">
          <!-- Glow Background -->
          <div class="absolute -inset-1 bg-gradient-to-br from-ateliya-primary/30 via-ateliya-secondary/20 to-ateliya-accent/30 rounded-3xl blur-xl opacity-60 group-hover/card:opacity-100 transition-all duration-700 -z-10"></div>

          <!-- Card -->
          <div class="relative bg-white rounded-3xl p-8 md:p-10 border-2 border-ateliya-primary/20 group-hover/card:border-ateliya-primary/40 transition-all duration-500 hover:shadow-2xl overflow-hidden">
            
            <!-- Quote icon decorative -->
            <div class="absolute top-6 right-6 w-16 h-16 rounded-2xl bg-gradient-to-br from-ateliya-primary/10 to-ateliya-primary/5 flex items-center justify-center opacity-50">
              <Icon name="quote" size="xl" class="text-ateliya-primary" />
            </div>

            <!-- Stars Rating -->
            <div class="flex gap-1 mb-6">
              {[...Array(5)].map(() => (
                <Icon
                  name="star"
                  size="md"
                  class="text-[#D4AF37] fill-current"
                />
              ))}
            </div>

            <!-- Quote Text -->
            <blockquote class="text-ateliya-dark text-lg md:text-xl leading-relaxed mb-8 font-medium">
              "{testimonials[0]?.text || 'Ateliya a complètement transformé la façon dont nous gérons notre atelier. Nous avons gagné un temps précieux et nos clients sont plus satisfaits que jamais.'}"
            </blockquote>

            <!-- Divider -->
            <div class="h-px bg-gradient-to-r from-ateliya-primary/50 via-ateliya-primary/20 to-transparent mb-8"></div>

            <!-- Author Section -->
            <div class="flex items-center gap-4">
              <!-- Avatar avec initiales -->
              <div class="relative">
                <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-ateliya-primary to-ateliya-secondary flex items-center justify-center font-black text-white text-xl shadow-xl group-hover/card:shadow-2xl group-hover/card:scale-110 transition-all duration-300">
                  {testimonials[0]?.author.charAt(0) || 'A'}{testimonials[0]?.author.split(' ')[1]?.charAt(0) || 'S'}
                </div>
                <!-- Badge verified -->
                <div class="absolute -bottom-1 -right-1 w-6 h-6 rounded-full bg-green-500 border-2 border-white flex items-center justify-center">
                  <Icon name="check" size="xs" class="text-white" />
                </div>
              </div>

              <!-- Author Info -->
              <div class="flex-1">
                <p class="font-black text-ateliya-dark text-lg group-hover/card:text-ateliya-primary transition-colors duration-300">
                  {testimonials[0]?.author || 'Artisan Ateliya'}
                </p>
                <p class="text-ateliya-primary text-sm font-bold">
                  {testimonials[0]?.role || 'Propriétaire de Boutique'}
                </p>
                <div class="flex items-center gap-1 mt-1">
                  <Icon name="mapPin" size="xs" class="text-ateliya-text/50" />
                  <span class="text-xs text-ateliya-text/50 font-semibold">
                    {testimonials[0]?.location || 'Abidjan, Côte d\'Ivoire'}
                  </span>
                </div>
              </div>
            </div>

            <!-- Shine effect -->
            <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/0 to-transparent group-hover/card:via-white/10 transition-all duration-1000 -translate-x-full group-hover/card:translate-x-full pointer-events-none"></div>
          </div>
        </div>
      </div>
    </div>

    


  </div>
</section>

<style>
  /* Animations */
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0) translateX(0);
    }
    25% {
      transform: translateY(-20px) translateX(10px);
    }
    50% {
      transform: translateY(-40px) translateX(-10px);
    }
    75% {
      transform: translateY(-20px) translateX(10px);
    }
  }

  @keyframes pulse-slow {
    0%, 100% {
      opacity: 0.3;
      transform: scale(1);
    }
    50% {
      opacity: 0.7;
      transform: scale(1.05);
    }
  }

  @keyframes gradient-x {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  /* Classes */
  .animate-fade-in-up {
    animation: fade-in-up 0.8s cubic-bezier(0.4, 0, 0.2, 1) both;
  }

  .animate-float {
    animation: float 10s ease-in-out infinite;
  }

  .animate-pulse-slow {
    animation: pulse-slow 4s ease-in-out infinite;
  }

  .animate-gradient-x {
    animation: gradient-x 3s linear infinite;
  }

  /* Performance */
  .animate-float {
    will-change: transform;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .animate-float {
      animation: none;
    }
  }

  /* Accessibilité */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  // Intersection Observer pour animations
  const initScrollAnimations = () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-fade-in-up');
          }
        });
      },
      { 
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      }
    );

    document.querySelectorAll('[data-animate]').forEach(el => {
      observer.observe(el);
    });
  };

  // Init
  document.addEventListener('astro:page-load', () => {
    initScrollAnimations();
  });
</script>