---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { stats, contactMethods, socialLinks } from "../data/contact";

const faqContact = [
  {
    question: "Quel est le delai de reponse ?",
    answer:
      "Nous repondons a toutes les demandes sous 24h en jours ouvres. Les demandes urgentes de support sont traitees en priorite.",
  },
  {
    question: "Puis-je appeler directement ?",
    answer:
      "Oui, notre equipe est joignable par telephone du lundi au vendredi de 9h a 18h et le samedi de 10h a 16h.",
  },
  {
    question: "Proposez-vous des demonstrations ?",
    answer:
      "Absolument ! Vous pouvez reserver une demo personnalisee de 30 minutes avec un de nos experts pour decouvrir Ateliya en detail.",
  },
];
---

<Layout title="Contact - Ateliya">
  <Header />

  <main class="bg-white overflow-hidden">
    <section
      class="relative py-12 lg:py-16 overflow-hidden bg-gradient-to-b from-white via-gray-50/30 to-white"
    >
      <div
        class="absolute top-[5%] right-[15%] w-80 h-80 bg-ateliya-primary/5 rounded-full blur-[120px]"
      >
      </div>
      <div
        class="absolute bottom-[10%] left-[10%] w-64 h-64 bg-ateliya-secondary/4 rounded-full blur-[100px]"
      >
      </div>
      <div
        class="absolute inset-0 opacity-[0.02]"
        style="background-image: radial-gradient(circle, #34C7B8 1px, transparent 1px); background-size: 36px 36px;"
      >
      </div>

      <div class="absolute right-8 top-[6%] grid grid-cols-5 gap-2 opacity-25">
        {
          [...Array(20)].map((_, i) => (
            <div
              class={`w-1.5 h-1.5 rounded-full ${i % 3 === 0 ? "bg-ateliya-primary" : i % 3 === 1 ? "bg-ateliya-secondary/50" : "bg-gray-300"}`}
            />
          ))
        }
      </div>
      <div
        class="absolute left-8 bottom-[8%] grid grid-cols-4 gap-2.5 opacity-20"
      >
        {
          [...Array(12)].map((_, i) => (
            <div
              class={`w-1.5 h-1.5 rounded-full ${i % 2 === 0 ? "bg-ateliya-primary/50" : "bg-gray-300"}`}
            />
          ))
        }
      </div>

      <div class="container mx-auto px-6 lg:px-12 max-w-5xl relative z-10">
        <div class="text-center space-y-4">
          <div
            class="inline-flex items-center gap-2 px-4 py-2 bg-ateliya-primary/10 rounded-full"
          >
            <div class="w-2 h-2 rounded-full bg-ateliya-primary animate-pulse">
            </div>
            <span class="text-sm font-bold text-ateliya-primary"
              >Support 24/7</span
            >
          </div>

          <h1
            class="text-3xl md:text-4xl lg:text-5xl font-black leading-tight text-gray-900"
          >
            <span class="block">Une question ?</span>
            <span
              class="text-transparent bg-clip-text bg-gradient-to-r from-ateliya-secondary to-ateliya-primary"
            >
              Parlons-en
            </span>
          </h1>

          <p class="text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">
            Notre equipe d'experts est la pour vous aider a <span
              class="font-bold text-ateliya-primary">reussir</span
            >
          </p>

          <!-- Stats -->
          <div class="flex flex-wrap justify-center gap-4 pt-3">
            {
              stats.map((stat) => (
                <div class="flex items-center gap-3 px-4 py-2.5 bg-white/80 backdrop-blur-sm rounded-xl border border-gray-100">
                  <span class="text-xl font-black bg-gradient-to-r from-ateliya-primary to-ateliya-secondary bg-clip-text text-transparent">
                    {stat.value}
                  </span>
                  <span class="text-sm text-gray-500 font-semibold">
                    {stat.label}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="relative py-4 -mt-6">
      <div class="container mx-auto px-6 lg:px-12 max-w-7xl">
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {
            contactMethods.map((method) => (
              <a href={method.href} class="h-full">
                <div class="h-full p-4 rounded-2xl bg-white border-2 border-gray-100 relative overflow-hidden">
                  <div class="flex items-center gap-3">
                    <div
                      class={`flex-shrink-0 w-11 h-11 rounded-2xl bg-gradient-to-br ${method.gradient} flex items-center justify-center`}
                    >
                      <Icon name={method.icon} size="md" class="text-white" />
                    </div>
                    <div class="flex-1 min-w-0">
                      <h4 class="text-sm font-black text-gray-900">
                        {method.title}
                      </h4>
                      <p class="text-xs text-gray-500 mt-0.5">
                        {method.description}
                      </p>
                      <p class="text-sm font-bold text-ateliya-primary mt-0.5">
                        {method.value}
                      </p>
                    </div>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="relative py-12 lg:py-16 overflow-hidden">
      <div
        class="absolute top-[20%] right-[5%] w-72 h-72 bg-ateliya-primary/3 rounded-full blur-[120px]"
      >
      </div>
      <div
        class="absolute bottom-[15%] left-[10%] w-56 h-56 bg-ateliya-secondary/3 rounded-full blur-[100px]"
      >
      </div>

      <div class="container mx-auto px-6 lg:px-12 max-w-7xl relative z-10">
        <div class="grid lg:grid-cols-5 gap-8">
          <div class="lg:col-span-3">
            <div class="sticky top-24">
              <div class="relative">
                <div
                  class="p-6 md:p-8 rounded-3xl bg-white border-2 border-gray-100 relative overflow-hidden"
                >
                  <div
                    class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-ateliya-primary via-ateliya-secondary to-ateliya-primary"
                  >
                  </div>

                  <div class="flex items-center justify-between mb-6">
                    <div class="space-y-1.5">
                      <h2 class="text-2xl md:text-3xl font-black text-gray-900">
                        Envoyez-nous un message
                      </h2>
                      <div
                        class="w-16 h-1 bg-gradient-to-r from-ateliya-primary to-ateliya-secondary rounded-full"
                      >
                      </div>
                    </div>
                    <div
                      class="flex items-center gap-2 px-3 py-1.5 bg-gray-50 rounded-lg text-xs text-gray-500 font-semibold"
                    >
                      <Icon name="lock" size="xs" class="text-gray-400" />
                      <span>Securise</span>
                    </div>
                  </div>

                  <form id="contactForm" class="space-y-4">
                    <div class="grid md:grid-cols-2 gap-4">
                      <div>
                        <label
                          for="name"
                          class="block text-sm font-bold text-gray-900 mb-1.5"
                          >Nom complet *</label
                        >
                        <input
                          type="text"
                          id="name"
                          name="name"
                          required
                          class="form-input"
                          placeholder="Jean Kouassi"
                        />
                      </div>
                      <div>
                        <label
                          for="email"
                          class="block text-sm font-bold text-gray-900 mb-1.5"
                          >Email *</label
                        >
                        <input
                          type="email"
                          id="email"
                          name="email"
                          required
                          class="form-input"
                          placeholder="jean@exemple.com"
                        />
                      </div>
                    </div>

                    <div class="grid md:grid-cols-2 gap-4">
                      <div>
                        <label
                          for="phone"
                          class="block text-sm font-bold text-gray-900 mb-1.5"
                          >Telephone</label
                        >
                        <input
                          type="tel"
                          id="phone"
                          name="phone"
                          class="form-input"
                          placeholder="+225 XX XX XX XX"
                        />
                      </div>
                      <div>
                        <label
                          for="subject"
                          class="block text-sm font-bold text-gray-900 mb-1.5"
                          >Sujet *</label
                        >
                        <select
                          id="subject"
                          name="subject"
                          required
                          class="form-input form-select"
                        >
                          <option value="">Choisissez...</option>
                          <option value="support">Support technique</option>
                          <option value="billing">Facturation</option>
                          <option value="feature"
                            >Nouvelle fonctionnalite</option
                          >
                          <option value="partnership">Partenariat</option>
                          <option value="other">Autre</option>
                        </select>
                      </div>
                    </div>

                    <div>
                      <label
                        for="message"
                        class="block text-sm font-bold text-gray-900 mb-1.5"
                        >Message *</label
                      >
                      <textarea
                        id="message"
                        name="message"
                        required
                        rows="5"
                        class="form-input resize-none"
                        placeholder="Decrivez votre demande en detail..."
                      ></textarea>
                      <div class="text-xs text-gray-400 mt-1 font-medium">
                        <span id="charCount">0</span> / 500 caracteres
                      </div>
                    </div>

                    <div class="flex items-start gap-3">
                      <input
                        type="checkbox"
                        id="consent"
                        name="consent"
                        required
                        class="w-4 h-4 rounded border-gray-300 text-ateliya-primary focus:ring-ateliya-primary/30 mt-0.5"
                      />
                      <label
                        for="consent"
                        class="text-sm text-gray-500 leading-relaxed"
                      >
                        J'accepte que mes donnees soient utilisees pour repondre
                        a ma demande.
                        <a
                          href="/privacy"
                          class="text-ateliya-primary font-semibold hover:underline"
                          >Politique de confidentialite</a
                        >
                      </label>
                    </div>

                    <button
                      type="submit"
                      class="w-full px-8 py-3.5 rounded-2xl bg-gradient-to-r from-ateliya-primary to-ateliya-secondary text-white font-bold hover:scale-[1.01] active:scale-[0.98] transition-all flex items-center justify-center gap-3 group relative overflow-hidden"
                    >
                      <span
                        class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/15 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700"
                      ></span>
                      <span class="relative z-10">Envoyer le message</span>
                      <Icon
                        name="send"
                        size="md"
                        class="relative z-10 group-hover:translate-x-1 transition-transform"
                      />
                    </button>

                    <div
                      id="successMsg"
                      class="hidden p-4 rounded-xl bg-green-50 border border-green-200"
                    >
                      <div class="flex items-center gap-3">
                        <div
                          class="w-8 h-8 rounded-full bg-green-500/10 flex items-center justify-center flex-shrink-0"
                        >
                          <Icon name="check" size="sm" class="text-green-600" />
                        </div>
                        <div>
                          <p class="font-bold text-green-900 text-sm">
                            Message envoye !
                          </p>
                          <p class="text-xs text-green-700">
                            Nous vous repondrons sous 24h.
                          </p>
                        </div>
                      </div>
                    </div>
                  </form>

                </div>
              </div>
            </div>
          </div>

          <!-- Sidebar - 2 cols -->
          <div class="lg:col-span-2 space-y-4">
            <!-- Office Hours -->
            <div class="relative">
              <div
                class="p-5 rounded-2xl bg-white border-2 border-gray-100 relative overflow-hidden"
              >
                <div class="flex items-center gap-3 mb-4">
                  <div
                    class="w-9 h-9 rounded-xl bg-gradient-to-br from-ateliya-primary/20 to-ateliya-primary/10 flex items-center justify-center"
                  >
                    <Icon name="clock" size="sm" class="text-ateliya-primary" />
                  </div>
                  <h3 class="font-black text-gray-900">Horaires</h3>
                </div>

                <div class="space-y-2">
                  {
                    [
                      { day: "Lun - Ven", hours: "9h - 18h", active: true },
                      { day: "Samedi", hours: "10h - 16h", active: true },
                      { day: "Dimanche", hours: "Ferme", active: false },
                    ].map((row) => (
                      <div class="flex items-center justify-between py-2 border-b border-gray-50 last:border-0">
                        <span class="text-sm text-gray-500">{row.day}</span>
                        <span
                          class={`text-sm font-bold ${row.active ? "text-gray-900" : "text-red-400"}`}
                        >
                          {row.hours}
                        </span>
                      </div>
                    ))
                  }
                </div>

                <div
                  class="mt-3 flex items-center gap-2 px-3 py-2 bg-green-50 rounded-lg border border-green-100"
                >
                  <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse">
                  </div>
                  <span class="text-xs font-bold text-green-700"
                    >Actuellement disponible</span
                  >
                </div>

              </div>
            </div>

            <!-- Social -->
            <div class="relative">
              <div
                class="p-5 rounded-2xl bg-white border-2 border-gray-100 relative overflow-hidden"
              >
                <div class="flex items-center gap-3 mb-4">
                  <div
                    class="w-9 h-9 rounded-xl bg-gradient-to-br from-ateliya-secondary/20 to-ateliya-secondary/10 flex items-center justify-center"
                  >
                    <Icon
                      name="users"
                      size="sm"
                      class="text-ateliya-secondary"
                    />
                  </div>
                  <h3 class="font-black text-gray-900">Suivez-nous</h3>
                </div>

                <div class="flex gap-2.5">
                  {
                    socialLinks.map((social) => (
                      <a
                        href={social.href}
                        aria-label={social.label}
                        class={`w-10 h-10 rounded-xl bg-gray-50 border border-gray-100 flex items-center justify-center ${social.color}`}
                      >
                        <Icon name={social.icon} size="sm" />
                      </a>
                    ))
                  }
                </div>

              </div>
            </div>

            <!-- FAQ mini -->
            <div>
              <h3
                class="text-base font-black text-gray-900 mb-3 flex items-center gap-2"
              >
                <div
                  class="w-7 h-7 rounded-lg bg-gradient-to-br from-ateliya-primary/20 to-ateliya-primary/10 flex items-center justify-center"
                >
                  <Icon
                    name="help-circle"
                    size="xs"
                    class="text-ateliya-primary"
                  />
                </div>
                Questions frequentes
              </h3>

              <div class="space-y-2.5">
                {
                  faqContact.map((item, idx) => (
                    <div class="faq-item">
                      <div class="relative">
                        <div class="absolute -inset-0.5 bg-gradient-to-br from-ateliya-primary/10 to-teal-400/5 rounded-2xl blur-md opacity-0 faq-glow transition-all duration-700 -z-10" />

                        <div class="rounded-2xl bg-white border-2 border-gray-100 transition-all duration-500 faq-card relative overflow-hidden">
                          <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-transparent via-ateliya-primary to-transparent opacity-0 faq-accent transition-opacity duration-500" />

                          <button
                            class="w-full flex items-center justify-between gap-3 p-3.5 text-left"
                            aria-expanded="false"
                          >
                            <span class="font-bold text-gray-900 text-sm">
                              {item.question}
                            </span>
                            <div class="faq-chevron flex-shrink-0 w-6 h-6 rounded-full bg-gray-50 flex items-center justify-center transition-all duration-300">
                              <Icon
                                name="chevron-down"
                                size="xs"
                                class="text-gray-400 transition-transform duration-300"
                              />
                            </div>
                          </button>

                          <div class="faq-answer">
                            <div class="px-3.5 pb-3.5 text-gray-500 leading-relaxed text-xs">
                              {item.answer}
                            </div>
                          </div>

                          <div class="absolute bottom-0 left-0 right-0 h-0.5 bg-ateliya-primary/10 rounded-b-2xl overflow-hidden">
                            <div class="h-full w-0 bg-gradient-to-r from-ateliya-primary to-teal-400 faq-bar transition-all duration-1000" />
                          </div>
                        </div>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================
         LOCATION
         ============================================ -->
    <section
      class="relative py-12 px-8 lg:px-12 mx-6 lg:mx-12 mb-14 rounded-3xl overflow-hidden bg-gradient-to-br from-teal-50/60 via-white to-amber-50/20 border border-gray-100"
    >
      <div
        class="absolute right-0 top-0 w-[40%] h-[60%] bg-gradient-to-bl from-ateliya-primary/4 to-transparent rounded-bl-[80px]"
      >
      </div>
      <div
        class="absolute top-[10%] right-[20%] w-56 h-56 bg-ateliya-primary/5 rounded-full blur-[100px]"
      >
      </div>
      <div
        class="absolute bottom-[10%] left-[15%] w-48 h-48 bg-ateliya-secondary/4 rounded-full blur-[80px]"
      >
      </div>
      <div
        class="absolute inset-0 opacity-[0.02]"
        style="background-image: radial-gradient(circle, #34C7B8 1px, transparent 1px); background-size: 32px 32px;"
      >
      </div>

      <div class="absolute left-6 top-[10%] grid grid-cols-5 gap-2 opacity-25">
        {
          [...Array(20)].map((_, i) => (
            <div
              class={`w-1.5 h-1.5 rounded-full ${i % 3 === 0 ? "bg-ateliya-primary" : i % 3 === 1 ? "bg-ateliya-secondary/40" : "bg-gray-300"}`}
            />
          ))
        }
      </div>

      <div
        class="absolute top-[3%] right-[5%] w-[140px] h-[140px] opacity-50 hidden md:block"
      >
        <svg viewBox="0 0 200 200" class="w-full h-full">
          <defs>
            <linearGradient id="locArc" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" style="stop-color:#D4AF37;stop-opacity:0.5"
              ></stop>
              <stop offset="100%" style="stop-color:#34C7B8;stop-opacity:0.3"
              ></stop>
            </linearGradient>
          </defs>
          <path
            d="M 100,18 A 82,82 0 0,1 182,100"
            fill="none"
            stroke="url(#locArc)"
            stroke-width="25"
            stroke-linecap="round"></path>
        </svg>
      </div>

      <div class="grid md:grid-cols-2 gap-10 items-center relative z-10">
        <!-- Info -->
        <div class="space-y-5">
          <div
            class="inline-flex items-center gap-2 px-4 py-2 bg-ateliya-secondary/10 rounded-full"
          >
            <Icon name="map-pin" size="sm" class="text-ateliya-secondary" />
            <span class="text-sm font-bold text-ateliya-secondary"
              >Notre Bureau</span
            >
          </div>

          <div class="space-y-2">
            <h2
              class="text-3xl md:text-4xl font-black leading-tight text-gray-900"
            >
              Venez nous
              <span
                class="text-transparent bg-clip-text bg-gradient-to-r from-ateliya-secondary to-ateliya-primary"
              >
                rendre visite
              </span>
            </h2>
            <p class="text-base text-gray-500 leading-relaxed max-w-lg">
              Notre equipe vous accueille a Abidjan pour discuter de vos
              besoins.
            </p>
          </div>

          <div class="space-y-2.5">
            {
              [
                {
                  icon: "map-pin",
                  title: "Adresse",
                  value: "Plateau, Abidjan, Cote d'Ivoire",
                  color: "text-ateliya-primary",
                  bg: "from-ateliya-primary/20 to-ateliya-primary/10",
                },
                {
                  icon: "phone",
                  title: "Telephone",
                  value: "+225 27 XX XX XX XX",
                  color: "text-ateliya-secondary",
                  bg: "from-ateliya-secondary/20 to-ateliya-secondary/10",
                },
                {
                  icon: "mail",
                  title: "Email",
                  value: "support@ateliya.com",
                  color: "text-blue-500",
                  bg: "from-blue-500/20 to-blue-500/10",
                },
              ].map((info) => (
                <div class="flex items-start gap-3 p-3.5 bg-white/60 backdrop-blur-sm rounded-xl border border-gray-100">
                  <div
                    class={`flex-shrink-0 w-9 h-9 rounded-xl bg-gradient-to-br ${info.bg} flex items-center justify-center`}
                  >
                    <Icon name={info.icon} size="sm" class={info.color} />
                  </div>
                  <div>
                    <h4 class="text-sm font-bold text-gray-900 mb-0.5">
                      {info.title}
                    </h4>
                    <p class="text-sm text-gray-500">{info.value}</p>
                  </div>
                </div>
              ))
            }
          </div>

          <div
            class="flex items-center gap-2 text-ateliya-primary font-bold text-sm cursor-pointer"
          >
            <span>Obtenir l'itineraire</span>
            <Icon
              name="arrow-right"
              size="sm"
            />
          </div>
        </div>

        <!-- Map -->
        <div
          class="relative h-[320px] rounded-2xl overflow-hidden border-2 border-gray-100 bg-gradient-to-br from-ateliya-primary/5 to-ateliya-secondary/5"
        >
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="text-center space-y-3">
              <div
                class="w-12 h-12 rounded-2xl bg-gradient-to-br from-ateliya-primary/20 to-ateliya-primary/10 flex items-center justify-center mx-auto"
              >
                <Icon name="map-pin" size="lg" class="text-ateliya-primary" />
              </div>
              <div>
                <p class="font-bold text-gray-900 text-sm">Carte interactive</p>
                <p class="text-xs text-gray-400">Bientot disponible</p>
              </div>
            </div>
          </div>

          <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[220px] h-[220px] rounded-full border-2 border-dashed border-ateliya-primary/8 animate-spin-slow"
          >
          </div>
          <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[310px] h-[310px] rounded-full border border-dashed border-ateliya-primary/5 animate-spin-slow-reverse"
          >
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .form-input {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    border: 2px solid #f3f4f6;
    background: #fafafa;
    font-size: 0.875rem;
    color: #1a202c;
    transition: all 0.3s ease;
  }

  .form-input:focus {
    outline: none;
    border-color: #34c7b8;
    background: white;
    box-shadow: 0 0 0 4px rgba(52, 199, 184, 0.08);
  }

  .form-input::placeholder {
    color: #9ca3af;
  }

  .form-select {
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
    background-position: right 0.75rem center;
    background-repeat: no-repeat;
    background-size: 1.5em 1.5em;
    padding-right: 2.5rem;
    appearance: none;
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-item.is-open .faq-answer {
    max-height: 200px;
  }

  .faq-item.is-open .faq-card {
    border-color: rgba(52, 199, 184, 0.2);
  }

  .faq-item.is-open .faq-glow {
    opacity: 0.4;
  }

  .faq-item.is-open .faq-accent {
    opacity: 1;
  }

  .faq-item.is-open .faq-bar {
    width: 100%;
  }

  .faq-item.is-open .faq-chevron {
    background: rgba(52, 199, 184, 0.1);
  }

  .faq-item.is-open .faq-chevron :global(svg) {
    transform: rotate(180deg);
    color: #34c7b8;
  }

  @keyframes spinSlow {
    from {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  @keyframes spinSlowReverse {
    from {
      transform: translate(-50%, -50%) rotate(360deg);
    }
    to {
      transform: translate(-50%, -50%) rotate(0deg);
    }
  }

  .animate-spin-slow {
    animation: spinSlow 30s linear infinite;
  }
  .animate-spin-slow-reverse {
    animation: spinSlowReverse 40s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const msg = document.getElementById("message") as HTMLTextAreaElement;
    const charCount = document.getElementById("charCount");

    msg?.addEventListener("input", () => {
      const count = msg.value.length;
      if (charCount) {
        charCount.textContent = count.toString();
        charCount.style.color = count > 500 ? "#EF4444" : "";
      }
    });

    const form = document.getElementById("contactForm");
    const successMsg = document.getElementById("successMsg");

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const formData = new FormData(form as HTMLFormElement);
      console.log("Form data:", Object.fromEntries(formData.entries()));

      if (successMsg) {
        successMsg.classList.remove("hidden");
        (form as HTMLFormElement).reset();
        if (charCount) charCount.textContent = "0";
        setTimeout(() => successMsg.classList.add("hidden"), 5000);
        successMsg.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    });

    document.querySelectorAll(".faq-item button").forEach((btn) => {
      btn.addEventListener("click", () => {
        const item = btn.closest(".faq-item");
        if (!item) return;
        const wasOpen = item.classList.contains("is-open");

        document.querySelectorAll(".faq-item").forEach((i) => {
          i.classList.remove("is-open");
          i.querySelector("button")?.setAttribute("aria-expanded", "false");
        });

        if (!wasOpen) {
          item.classList.add("is-open");
          btn.setAttribute("aria-expanded", "true");
        }
      });
    });
  });
</script>
