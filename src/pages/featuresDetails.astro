---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { features, workflow, interactiveDemos, heroFeatures } from "../data/features";
---

<Layout title="Fonctionnalités - Ateliya | L'app des tailleurs modernes">
  <Header />

  <main class="overflow-hidden">
    
    <!-- ==================== HERO - ACCROCHE ÉMOTIONNELLE ==================== -->
    <section class="relative min-h-screen bg-white overflow-hidden">
      
      <!-- Background subtle -->
      <div class="absolute inset-0">
        <div class="absolute inset-0 bg-gradient-to-b from-ateliya-primary/5 via-transparent to-transparent"></div>
        <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-ateliya-primary/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/4"></div>
      </div>
      
      <div class="container mx-auto px-6 lg:px-12 pt-32 lg:pt-40 pb-20 relative z-10">
        
        <div class="grid lg:grid-cols-2 gap-8 lg:gap-10 items-center">
          
          <!-- Left - Emotional Content -->
          <div class="max-w-xl">
            
            <!-- Badge -->
            <div class="inline-flex items-center gap-2 px-4 py-2 bg-ateliya-primary/10 rounded-full mb-8 animate-fade-in">
              <Icon name="map-pin" size="sm" class="text-ateliya-primary" />
              <span class="text-sm font-bold text-ateliya-primary">Fait pour les tailleurs ivoiriens</span>
            </div>

            <!-- Main headline - Emotional -->
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-black text-gray-900 leading-[1.15] mb-6 animate-fade-in-up">
              Vous êtes un
              <span class="text-ateliya-primary"> excellent tailleur.</span>
              <br />
              <span class="text-gray-500">Mais gérer tout ça...</span>
            </h1>

            <!-- Pain points -->
            <div class="space-y-3 mb-8 animate-fade-in-up animation-delay-200">
              {[
                { icon: "file-text", text: "Les mesures sur des bouts de papier qui se perdent" },
                { icon: "phone-call", text: "Les clients qui appellent : « C'est prêt ? »" },
                { icon: "credit-card", text: "Les paiements qu'on oublie de réclamer" },
                { icon: "alert-circle", text: "Le stress de tout garder en tête" }
              ].map((pain) => (
                <p class="flex items-center gap-3 text-gray-600">
                  <span class="w-5 h-5 flex items-center justify-center text-red-400">
                    <Icon name={pain.icon} size="sm" class="text-red-400" />
                  </span>
                  <span>{pain.text}</span>
                </p>
              ))}
            </div>

            <!-- Solution statement -->
            <div class="p-5 bg-ateliya-primary/5 border-l-4 border-ateliya-primary rounded-r-xl mb-8 animate-fade-in-up animation-delay-300">
              <p class="text-lg font-semibold text-gray-900">
                Et si tout ça était dans votre poche ?
                <span class="text-ateliya-primary"> Organisé. Simple. Efficace.</span>
              </p>
            </div>

            <!-- CTA -->
            <div class="flex flex-col sm:flex-row gap-4 animate-fade-in-up animation-delay-400">
              <a 
                href="#demo" 
                class="group inline-flex items-center justify-center gap-3 px-7 py-4 bg-ateliya-primary text-white font-bold rounded-2xl hover:bg-ateliya-dark transition-all duration-300 shadow-lg hover:shadow-xl hover:shadow-ateliya-primary/20"
              >
                <span>Découvrir Ateliya</span>
                <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </a>
              
              <a 
                href="#how-it-works" 
                class="inline-flex items-center justify-center gap-2 px-7 py-4 text-gray-700 font-semibold hover:text-ateliya-primary transition-colors"
              >
                <span>Comment ça marche ?</span>
              </a>
            </div>
          </div>

          <!-- Right - Phone Mockup -->
          <div class="relative flex justify-center lg:justify-end animate-fade-in-up animation-delay-300">
            
            <!-- Main phone -->
            <div class="relative">
              
              <!-- Glow effect -->
              <div class="absolute inset-0 bg-gradient-to-r from-ateliya-primary/20 to-ateliya-secondary/20 rounded-[3rem] blur-3xl scale-95"></div>
              
              <!-- Phone frame -->
              <div class="relative bg-gray-900 rounded-[3rem] p-2 shadow-2xl">
                <div class="relative bg-gray-900 rounded-[2.5rem] overflow-hidden w-64 h-[520px] md:w-72 md:h-[580px]">
                  
                  <!-- Notch -->
                  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-28 h-6 bg-gray-900 rounded-b-2xl z-20"></div>
                  
                  <!-- Screen content -->
                  <img 
                    src="/blog1.jpg" 
                    alt="Interface Ateliya" 
                    class="w-full h-full object-cover"
                  />
                  
                  <!-- Screen reflection -->
                  <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/5 to-white/10 pointer-events-none"></div>
                </div>
              </div>

              <!-- Floating cards around phone -->
              <div class="absolute -left-16 top-20 p-4 bg-white rounded-2xl shadow-xl border border-gray-100 animate-float hidden md:block">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                    <Icon name="check" size="sm" class="text-green-600" />
                  </div>
                  <div>
                    <p class="text-xs text-gray-500">Mesures sauvegardées</p>
                    <p class="font-bold text-gray-900">Mme Koné</p>
                  </div>
                </div>
              </div>

              <div class="absolute -right-12 top-1/3 p-4 bg-white rounded-2xl shadow-xl border border-gray-100 animate-float animation-delay-1000 hidden md:block">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-ateliya-primary/10 rounded-full flex items-center justify-center">
                    <Icon name="dollar-sign" size="sm" class="text-ateliya-primary" />
                  </div>
                  <div>
                    <p class="text-xs text-gray-500">Paiement reçu</p>
                    <p class="font-bold text-ateliya-primary">+25 000 F</p>
                  </div>
                </div>
              </div>

              <div class="absolute -left-8 bottom-24 p-4 bg-ateliya-primary text-white rounded-2xl shadow-xl animate-float animation-delay-2000 hidden md:block">
                <div class="flex items-center gap-3">
                  <Icon name="calendar" size="md" class="text-white" />
                  <div>
                    <p class="text-xs opacity-80">Rappel</p>
                    <p class="font-bold text-sm">RDV demain 10h</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce hidden md:block">
        <svg class="w-6 h-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
        </svg>
      </div>
    </section>

    <!-- ==================== 3 PROMESSES CLÉS ==================== -->
    <section class="py-20 bg-gray-50">
      <div class="container mx-auto px-6 lg:px-12 max-w-6xl">
        
        <div class="text-center mb-16 reveal-on-scroll">
          <h2 class="text-2xl md:text-3xl font-black text-gray-900 mb-4">
            3 problèmes réglés. <span class="text-ateliya-primary">Point final.</span>
          </h2>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          
          <!-- Mesures -->
          <div class="group text-center reveal-on-scroll">
            <div class="relative inline-flex items-center justify-center w-24 h-24 mb-6">
              <div class="absolute inset-0 bg-ateliya-primary/10 rounded-3xl rotate-6 group-hover:rotate-12 transition-transform"></div>
              <div class="relative w-20 h-20 bg-white rounded-2xl shadow-lg flex items-center justify-center">
                <Icon name="ruler" size="2xl" class="text-ateliya-primary" />
              </div>
            </div>
            <h3 class="text-xl font-black text-gray-900 mb-2">Mesures</h3>
            <p class="text-2xl font-black text-ateliya-primary mb-3">Plus jamais perdues</p>
            <p class="text-gray-600">
              Tour de poitrine, longueur, hanches... Tout est enregistré pour chaque client. Accessible en 2 clics.
            </p>
          </div>

          <!-- Paiements -->
          <div class="group text-center reveal-on-scroll animation-delay-200">
            <div class="relative inline-flex items-center justify-center w-24 h-24 mb-6">
              <div class="absolute inset-0 bg-green-100 rounded-3xl rotate-6 group-hover:rotate-12 transition-transform"></div>
              <div class="relative w-20 h-20 bg-white rounded-2xl shadow-lg flex items-center justify-center">
                <Icon name="credit-card" size="2xl" class="text-green-600" />
              </div>
            </div>
            <h3 class="text-xl font-black text-gray-900 mb-2">Paiements</h3>
            <p class="text-2xl font-black text-green-600 mb-3">Fini les impayés</p>
            <p class="text-gray-600">
              Suivez qui a payé, qui doit encore. Envoyez des rappels automatiques. Récupérez votre argent.
            </p>
          </div>

          <!-- Rendez-vous -->
          <div class="group text-center reveal-on-scroll animation-delay-400">
            <div class="relative inline-flex items-center justify-center w-24 h-24 mb-6">
              <div class="absolute inset-0 bg-blue-100 rounded-3xl rotate-6 group-hover:rotate-12 transition-transform"></div>
              <div class="relative w-20 h-20 bg-white rounded-2xl shadow-lg flex items-center justify-center">
                <Icon name="calendar" size="2xl" class="text-blue-600" />
              </div>
            </div>
            <h3 class="text-xl font-black text-gray-900 mb-2">Rendez-vous</h3>
            <p class="text-2xl font-black text-blue-600 mb-3">Zéro oubli</p>
            <p class="text-gray-600">
              Calendrier intelligent avec rappels. Vous et vos clients êtes notifiés. Plus de "j'ai oublié".
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== AVANT / APRÈS ==================== -->
    <section class="py-24 bg-white overflow-hidden">
      <div class="container mx-auto px-6 lg:px-12 max-w-6xl">
        
        <div class="text-center mb-16 reveal-on-scroll">
          <span class="inline-block px-4 py-2 bg-ateliya-primary/10 text-ateliya-primary text-sm font-bold rounded-full mb-4">
            La différence Ateliya
          </span>
          <h2 class="text-3xl md:text-4xl font-black text-gray-900">
            Avant vs <span class="text-ateliya-primary">Maintenant</span>
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
          
          <!-- AVANT -->
          <div class="relative reveal-on-scroll">
            <div class="absolute -top-3 left-6 px-4 py-1 bg-red-500 text-white text-sm font-bold rounded-full z-10">
              😩 AVANT
            </div>
            <div class="p-8 bg-red-50 border-2 border-red-100 rounded-3xl h-full">
              <ul class="space-y-5">
                {[
                  { icon: "file-text", text: "Carnets et papiers partout", sub: "Mesures perdues, pages déchirées" },
                  { icon: "alert-triangle", text: "Tout dans la tête", sub: "Stress, oublis, erreurs" },
                  { icon: "phone-incoming", text: "Appels incessants", sub: "« C'est prêt mon habit ? »" },
                  { icon: "trending-down", text: "Impayés qui s'accumulent", sub: "Difficile de réclamer" },
                  { icon: "frown", text: "Journées épuisantes", sub: "Couture + gestion = fatigue" }
                ].map((item) => (
                  <li class="flex items-start gap-4">
                    <span class="w-8 h-8 rounded-lg bg-red-100 flex items-center justify-center flex-shrink-0">
                      <Icon name={item.icon} size="sm" class="text-red-500" />
                    </span>
                    <div>
                      <p class="font-bold text-gray-900">{item.text}</p>
                      <p class="text-sm text-gray-600">{item.sub}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- APRÈS -->
          <div class="relative reveal-on-scroll animation-delay-200">
            <div class="absolute -top-3 left-6 px-4 py-1 bg-ateliya-primary text-white text-sm font-bold rounded-full z-10">
              😎 AVEC ATELIYA
            </div>
            <div class="p-8 bg-ateliya-primary/5 border-2 border-ateliya-primary/20 rounded-3xl h-full">
              <ul class="space-y-5">
                {[
                  { icon: "smartphone", text: "Tout dans votre téléphone", sub: "Mesures, commandes, clients" },
                  { icon: "smile", text: "L'esprit tranquille", sub: "Ateliya se souvient pour vous" },
                  { icon: "bell", text: "Clients informés automatiquement", sub: "Notifications de suivi" },
                  { icon: "check-circle", text: "Paiements suivis", sub: "Rappels automatiques" },
                  { icon: "clock", text: "2h gagnées par jour", sub: "Concentrez-vous sur la couture" }
                ].map((item) => (
                  <li class="flex items-start gap-4">
                    <span class="w-8 h-8 rounded-lg bg-ateliya-primary/10 flex items-center justify-center flex-shrink-0">
                      <Icon name={item.icon} size="sm" class="text-ateliya-primary" />
                    </span>
                    <div>
                      <p class="font-bold text-gray-900">{item.text}</p>
                      <p class="text-sm text-ateliya-primary font-medium">{item.sub}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== COMMENT ÇA MARCHE ==================== -->
    <section id="how-it-works" class="py-24 bg-gray-50">
      <div class="container mx-auto px-6 lg:px-12 max-w-6xl">
        
        <div class="text-center mb-16 reveal-on-scroll">
          <span class="inline-block px-4 py-2 bg-ateliya-primary/10 text-ateliya-primary text-sm font-bold rounded-full mb-4">
            Simple comme bonjour
          </span>
          <h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-4">
            Comment ça marche ?
          </h2>
          <p class="text-lg text-gray-600 max-w-xl mx-auto">
            4 étapes pour transformer votre façon de travailler
          </p>
        </div>

        <!-- Steps -->
        <div class="relative">
          
          <!-- Connection line (desktop) -->
          <div class="hidden lg:block absolute top-16 left-[12%] right-[12%] h-1 bg-gradient-to-r from-ateliya-primary via-ateliya-secondary to-ateliya-primary rounded-full opacity-20"></div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
            {[
              { step: "1", icon: "download", title: "Téléchargez", desc: "Gratuit sur Play Store et App Store", color: "bg-blue-500" },
              { step: "2", icon: "user", title: "Créez votre profil", desc: "2 minutes, c'est tout", color: "bg-purple-500" },
              { step: "3", icon: "user-plus", title: "Ajoutez vos clients", desc: "Avec leurs mesures et commandes", color: "bg-ateliya-primary" },
              { step: "4", icon: "zap", title: "C'est parti !", desc: "Gérez tout depuis votre poche", color: "bg-green-500" }
            ].map((item, idx) => (
              <div class="relative reveal-on-scroll" style={`animation-delay: ${idx * 150}ms`}>
                
                <!-- Step number -->
                <div class={`relative z-10 w-12 h-12 ${item.color} text-white rounded-full flex items-center justify-center font-black text-lg mb-6 mx-auto lg:mx-0 shadow-lg`}>
                  {item.step}
                </div>

                <!-- Content -->
                <div class="text-center lg:text-left">
                  <div class="w-14 h-14 bg-gray-100 rounded-2xl flex items-center justify-center mb-4 mx-auto lg:mx-0">
                    <Icon name={item.icon} size="lg" class="text-gray-700" />
                  </div>
                  <h3 class="text-xl font-bold text-gray-900 mb-2">{item.title}</h3>
                  <p class="text-gray-600">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== FONCTIONNALITÉS COMPLÈTES ==================== -->
    <section id="features" class="py-24 bg-white">
      <div class="container mx-auto px-6 lg:px-12 max-w-6xl">
        
        <div class="text-center mb-16 reveal-on-scroll">
          <span class="inline-block px-4 py-2 bg-ateliya-secondary/10 text-ateliya-secondary text-sm font-bold rounded-full mb-4">
            Tout inclus
          </span>
          <h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-4">
            Et ce n'est pas tout...
          </h2>
          <p class="text-lg text-gray-600 max-w-xl mx-auto">
            Découvrez toutes les fonctionnalités qui font la différence
          </p>
        </div>

        <!-- Features Grid -->
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map((feature, idx) => (
            <div 
              class="group p-6 bg-gray-50 hover:bg-white rounded-2xl border border-transparent hover:border-ateliya-primary/20 hover:shadow-xl transition-all duration-300 reveal-on-scroll"
              style={`animation-delay: ${idx * 100}ms`}
            >
              <div class={`w-14 h-14 rounded-2xl bg-gradient-to-br ${feature.gradient || 'from-ateliya-primary/20 to-ateliya-secondary/20'} flex items-center justify-center mb-4 group-hover:scale-110 transition-transform`}>
                <Icon name={feature.icon} size="lg" class="text-ateliya-primary" />
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-ateliya-primary transition-colors">
                {feature.title}
              </h3>
              <p class="text-gray-600 text-sm leading-relaxed">
                {feature.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

   <!-- ==================== TÉMOIGNAGES ==================== -->
