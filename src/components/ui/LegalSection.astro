---
import type { LegalSection } from "../../data/legal";

interface Props {
  section: LegalSection;
}
const { section } = Astro.props;
---

<article id={`section-${section.number}`} class="scroll-mt-28 py-8">
  <div class="flex items-start gap-4">
    <span
      class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-light text-sm font-bold text-primary"
    >
      {section.number}
    </span>
    <div class="min-w-0 flex-1">
      <h2 class="font-serif text-xl font-bold text-text sm:text-2xl">
        {section.title}
      </h2>

      {
        section.content && (
          <p class="mt-3 text-sm leading-7 text-text-secondary">
            {section.content}
          </p>
        )
      }

      {
        section.list && (
          <ul class="mt-3 space-y-2.5">
            {section.list.map((item) => (
              <li class="flex items-start gap-2.5 text-sm leading-6 text-text-secondary">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-sm bg-gold" />
                <span>
                  {item.title && (
                    <strong class="font-semibold text-text">
                      {item.title} :{" "}
                    </strong>
                  )}
                  {item.text}
                </span>
              </li>
            ))}
          </ul>
        )
      }

      {
        section.subsections && (
          <div class="mt-4 space-y-5">
            {section.subsections.map((sub) => (
              <div>
                <p class="text-xs font-bold tracking-[0.1em] text-primary uppercase">
                  {sub.title}
                </p>
                <ul class="mt-2 space-y-2.5">
                  {sub.list.map((item) => (
                    <li class="flex items-start gap-2.5 text-sm leading-6 text-text-secondary">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-sm bg-gold" />
                      <span>{item.text}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )
      }

      {
        section.highlight && (
          <p class="mt-4 rounded-r-lg border-l-4 border-gold bg-gold-bg px-4 py-3 text-sm leading-6 font-medium text-primary-dark">
            {section.highlight}
          </p>
        )
      }

      {
        section.footer && (
          <p class="mt-4 text-sm leading-6 text-text-secondary italic">
            {section.footer}
          </p>
        )
      }
    </div>
  </div>
</article>
