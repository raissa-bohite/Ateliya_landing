---
import Icon from "../components/Icon.astro";
import accueilImg from "../assets/app_images/accueil.png";
import gestionImg from "../assets/app_images/gestion.png";
import onboardingImg from "../assets/app_images/onboarding.png";
import rapportImg from "../assets/app_images/rapport.png";

const galleryItems = [
  {
    label: "Onboarding",
    description: "Configuration rapide pour demarrer sans friction",
    image: onboardingImg,
  },
  {
    label: "Accueil",
    description: "Vue d'ensemble de l'activite et des actions du jour",
    image: accueilImg,
  },
  {
    label: "Transactions",
    description: "Suivi clair des revenus, depenses et factures",
    image: gestionImg,
  },
  {
    label: "Statistiques",
    description: "Indicateurs clairs pour suivre la performance",
    image: rapportImg,
  },
];
---

<section
  id="gallery"
  class="relative py-24 lg:py-28 overflow-hidden bg-gradient-to-br from-teal-50/60 via-white to-amber-50/20"
>
  <!-- ---- Background Decorations ---- -->

  <!-- Large shape blob -->
  <div
    class="absolute left-0 top-0 w-[45%] h-[65%] bg-gradient-to-br from-ateliya-primary/4 to-transparent rounded-br-[100px]"
  ></div>

  <!-- Gradient orbs -->
  <div
    class="absolute top-[10%] left-[20%] w-72 h-72 bg-ateliya-primary/[0.035] rounded-full blur-[120px]"
  ></div>
  <div
    class="absolute bottom-[10%] right-[15%] w-60 h-60 bg-ateliya-secondary/[0.03] rounded-full blur-[100px]"
  ></div>

  <!-- Radial dot bg -->
  <div
    class="absolute inset-0 opacity-[0.014]"
    style="background-image: radial-gradient(circle, #2FAFA4 1px, transparent 1px); background-size: 36px 36px;"
  ></div>

  <!-- Dot grid top-right -->
  <div class="absolute right-8 top-[10%] grid grid-cols-6 gap-2 opacity-[0.16]">
    {
      [...Array(24)].map((_, i) => (
        <div
          class={`w-1.5 h-1.5 rounded-full ${i % 4 === 0 ? "bg-ateliya-primary" : i % 4 === 1 ? "bg-ateliya-secondary/50" : i % 4 === 2 ? "bg-ateliya-secondary/20" : "bg-gray-300"}`}
        />
      ))
    }
  </div>

  <!-- Dot grid bottom-left -->
  <div class="absolute left-10 bottom-[8%] grid grid-cols-5 gap-3 opacity-[0.14]">
    {
      [...Array(15)].map((_, i) => (
        <div
          class={`w-2 h-2 rounded-full ${i % 2 === 0 ? "bg-ateliya-primary/40" : "bg-ateliya-secondary/25"}`}
        />
      ))
    }
  </div>

  <!-- ---- Content ---- -->
  <div class="container mx-auto px-6 lg:px-12 relative z-10">
    <!-- Header -->
    <div class="text-center mb-14">
      <div
        class="inline-flex items-center gap-2 px-4 py-2 bg-ateliya-primary/10 rounded-full mb-5"
      >
        <Icon name="image" size="sm" class="text-ateliya-primary" />
        <span class="text-sm font-bold text-ateliya-primary">Apercu</span>
      </div>

      <h2
        class="text-3xl md:text-4xl lg:text-5xl font-serif font-extrabold tracking-tighter text-gray-900 leading-tight mb-4"
      >
        Decouvrez l'
        <span
          class="text-ateliya-primary"
        >
          Application
        </span> Ateliya
      </h2>

      <p class="text-lg text-gray-500 max-w-xl mx-auto leading-relaxed">
        Interface intuitive et puissante pour gerer tous les aspects de votre
        atelier avec fluidite
      </p>
    </div>
  </div>

  <!-- Gallery Carousel -->
  <div class="container mx-auto px-6 lg:px-10 relative z-10">
    <div class="mx-auto grid max-w-[1164px] grid-cols-1 justify-items-center gap-5 sm:grid-cols-2 xl:grid-cols-4">
      {
        galleryItems.map((item, idx) => (
          <div
            class="gallery-card group relative h-[552px] w-[276px] rounded-[2.75rem] overflow-visible transition-transform duration-200 ease-out hover:-translate-y-1"
            style={`animation-delay: ${idx * 80}ms`}
          >
            <div class="relative w-full h-full bg-gray-900 rounded-[2.75rem] p-2.5 shadow-[0_18px_44px_rgba(18,63,59,0.14)]">
              <div class="relative w-full h-full bg-white rounded-[2.25rem] overflow-hidden">
                <div class="absolute top-0 left-1/2 -translate-x-1/2 w-28 h-6 bg-gray-900 rounded-b-3xl z-20"></div>

                {item.image ? (
                  <img
                    src={item.image.src}
                    alt={item.label}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    width="390"
                    height="844"
                    decoding="async"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center bg-gray-50">
                    <Icon
                      name="image"
                      size="2xl"
                      class="text-ateliya-primary/50"
                    />
                  </div>
                )}

                <div class="absolute inset-0 bg-gradient-to-t from-gray-900/90 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10"></div>

                <div class="absolute bottom-0 left-0 right-0 p-6 z-20 translate-y-4 group-hover:translate-y-0 opacity-0 group-hover:opacity-100 transition-[transform,opacity] duration-200 ease-out">
                  <p class="text-white font-bold text-xl mb-1">{item.label}</p>
                  <p class="text-white/80 text-sm leading-relaxed">
                    {item.description}
                  </p>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery-card {
    animation: galleryCardIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes galleryCardIn {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(12px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-card {
      animation: none;
    }
  }
</style>

