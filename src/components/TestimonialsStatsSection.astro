---
import Icon from "../components/Icon.astro";
import { testimonials, stats } from "../data/data";

const statsConfig = stats.slice(0, 4).map((stat, index) => ({
  ...stat,
  icon:
    index === 0
      ? "users"
      : index === 1
        ? "trending-up"
        : index === 2
          ? "star"
          : "heart",
}));
---

<section
  id="testimonials"
  class="relative py-24 lg:py-28 overflow-hidden bg-gradient-to-br from-teal-50/60 via-white to-amber-50/20"
>
  <!-- ---- Background Decorations ---- -->
  <div
    class="absolute left-0 top-0 w-[45%] h-[60%] bg-gradient-to-br from-ateliya-primary/4 to-transparent rounded-br-[100px]"
  >
  </div>

  <div
    class="absolute top-[10%] right-[20%] w-72 h-72 bg-ateliya-primary/[0.035] rounded-full blur-[120px]"
  >
  </div>
  <div
    class="absolute bottom-[10%] left-[20%] w-60 h-60 bg-ateliya-secondary/[0.025] rounded-full blur-[100px]"
  >
  </div>

  <div
    class="absolute inset-0 opacity-[0.014]"
    style="background-image: radial-gradient(circle, #2FAFA4 1px, transparent 1px); background-size: 36px 36px;"
  >
  </div>

  <!-- Dot grids -->
  <div class="absolute right-8 top-[8%] grid grid-cols-6 gap-2 opacity-[0.16]">
    {
      [...Array(24)].map((_, i) => (
        <div
          class={`w-1.5 h-1.5 rounded-full ${i % 4 === 0 ? "bg-ateliya-primary" : i % 4 === 1 ? "bg-ateliya-secondary/50" : i % 4 === 2 ? "bg-ateliya-secondary/20" : "bg-gray-300"}`}
        />
      ))
    }
  </div>
  <div class="absolute left-10 bottom-[6%] grid grid-cols-4 gap-3 opacity-[0.14]">
    {
      [...Array(12)].map((_, i) => (
        <div
          class={`w-2 h-2 rounded-full ${i % 2 === 0 ? "bg-ateliya-primary/40" : "bg-ateliya-secondary/25"}`}
        />
      ))
    }
  </div>

  <!-- ---- Content ---- -->
  <div class="container mx-auto px-6 lg:px-10 relative z-10">
    <!-- Main Grid -->
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start mb-20">
      <!-- Left: Header + Trust -->
      <div class="space-y-7">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 bg-ateliya-primary/10 rounded-full"
        >
          <Icon name="message-square" size="sm" class="text-ateliya-primary" />
          <span class="text-sm font-bold text-ateliya-primary"
            >Temoignages Clients</span
          >
        </div>

        <h2
          class="text-4xl md:text-5xl font-serif font-extrabold tracking-tighter leading-tight text-gray-900"
        >
          Ce que nos
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-ateliya-primary via-teal-400 to-ateliya-secondary"
          >
            clients
          </span>
          <span class="block mt-1">disent de nous</span>
        </h2>

        <p class="text-lg text-gray-500 leading-relaxed max-w-lg tracking-wide">
          Plus de <span class="font-bold text-ateliya-primary"
            >500 ateliers</span
          > en Afrique font confiance a Ateliya pour transformer leur gestion quotidienne.
        </p>

        <!-- Trust row -->
        <div class="flex flex-wrap items-center gap-5">
          <div
            class="flex items-center gap-2 px-4 py-2.5 bg-white/[0.94] backdrop-blur-sm rounded-xl border border-ateliya-border/[0.55] shadow-[0_6px_16px_rgba(18,63,59,0.035)]"
          >
            <div class="flex gap-0.5">
              {
                [...Array(5)].map(() => (
                  <Icon name="star" size="xs" class="text-amber-400" />
                ))
              }
            </div>
            <span class="text-sm font-bold text-gray-600"
              >4.9/5 sur 500+ avis</span
            >
          </div>

          <div class="flex -space-x-2">
            {
              [1, 2, 3, 4].map((i) => (
                <div class="w-9 h-9 rounded-full border-2 border-white bg-gradient-to-br from-ateliya-primary to-ateliya-secondary flex items-center justify-center text-white font-bold text-xs shadow-[0_6px_14px_rgba(18,63,59,0.08)] hover:-translate-y-0.5 hover:z-10 transition-transform duration-300">
                  {i}
                </div>
              ))
            }
            <div
              class="w-9 h-9 rounded-full border-2 border-white bg-gray-800 flex items-center justify-center text-white font-bold text-[10px] shadow-[0_6px_14px_rgba(18,63,59,0.08)]"
            >
              +500
            </div>
          </div>
        </div>

        <a
          href="#all-testimonials"
          class="inline-flex items-center gap-3 px-7 py-3.5 bg-gradient-to-r from-ateliya-primary to-ateliya-secondary text-white font-bold rounded-2xl shadow-[0_12px_28px_rgba(47,175,164,0.16)] hover:shadow-[0_16px_34px_rgba(47,175,164,0.2)] hover:-translate-y-0.5 transition-all duration-300 group/cta"
        >
          <span>Voir tous les temoignages</span>
          <Icon
            name="arrow-right"
            size="sm"
            class="group-hover/cta:translate-x-1 transition-transform duration-300"
          />
        </a>
      </div>

      <!-- Right: Featured Testimonial Card -->
      <div class="relative">
        <!-- Decorative arc -->
        <div
          class="absolute -top-4 -right-4 w-[220px] h-[220px] testi-arc-entrance hidden lg:block"
        >
          <svg viewBox="0 0 200 200" class="w-full h-full">
            <defs>
              <linearGradient id="testiArc" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#2FAFA4;stop-opacity:0.5"
                ></stop>
                <stop offset="100%" style="stop-color:#B99752;stop-opacity:0.3"
                ></stop>
              </linearGradient>
            </defs>
            <path
              d="M 100,22 A 78,78 0 0,1 178,100"
              fill="none"
              stroke="url(#testiArc)"
              stroke-width="22"
              stroke-linecap="round"></path>
          </svg>
        </div>

        <!-- Bouncing dots -->
        <div
          class="absolute -top-6 left-[30%] w-3 h-3 rounded-full bg-ateliya-primary/28 testi-bounce-1 hidden lg:block"
        >
        </div>
        <div
          class="absolute -bottom-4 right-[20%] w-3.5 h-3.5 rounded-full bg-ateliya-secondary/24 testi-bounce-2 hidden lg:block"
        >
        </div>

        <!-- Card -->
        <div
          class="group/card relative bg-white/[0.96] backdrop-blur-sm rounded-2xl p-7 md:p-9 border border-ateliya-border/[0.55] hover:border-ateliya-primary/25 hover:shadow-[0_14px_34px_rgba(18,63,59,0.07)] transition-all duration-500"
        >
          <!-- Top accent -->
          <div
            class="absolute top-0 left-6 right-6 h-px rounded-full bg-gradient-to-r from-ateliya-primary to-ateliya-secondary opacity-0 group-hover/card:opacity-100 transition-opacity duration-300"
          >
          </div>

          <!-- Quote icon -->
          <div
            class="absolute top-6 right-6 w-12 h-12 rounded-xl bg-ateliya-primary/[0.08] flex items-center justify-center"
          >
            <Icon name="quote" size="md" class="text-ateliya-primary/40" />
          </div>

          <!-- Stars -->
          <div class="flex gap-1 mb-5">
            {
              [...Array(5)].map(() => (
                <Icon name="star" size="sm" class="text-amber-400" />
              ))
            }
          </div>

          <!-- Quote text -->
          <blockquote
            class="text-gray-700 text-lg leading-relaxed mb-7 font-medium tracking-wide"
          >
            "{
              testimonials[0]?.text ||
                "Ateliya a completement transforme la facon dont nous gerons notre atelier. Nous avons gagne un temps precieux et nos clients sont plus satisfaits que jamais."
            }"
          </blockquote>

          <!-- Divider -->
          <div
            class="h-px bg-gradient-to-r from-ateliya-primary/30 via-ateliya-primary/10 to-transparent mb-6"
          >
          </div>

          <!-- Author -->
          <div class="flex items-center gap-4">
            <div class="relative">
              <div
                class="w-14 h-14 rounded-xl bg-gradient-to-br from-ateliya-primary to-ateliya-secondary flex items-center justify-center font-black text-white text-lg shadow-[0_10px_24px_rgba(47,175,164,0.16)] group-hover/card:-translate-y-0.5 transition-transform duration-300"
              >
                {testimonials[0]?.author.charAt(0) || "A"}{
                  testimonials[0]?.author.split(" ")[1]?.charAt(0) || "S"
                }
              </div>
              <div
                class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-green-500 border-2 border-white flex items-center justify-center"
              >
                <Icon name="check" size="xs" class="text-white" />
              </div>
            </div>

            <div class="flex-1">
              <p
                class="font-serif font-extrabold tracking-tighter text-gray-900 group-hover/card:text-ateliya-primary transition-colors duration-300"
              >
                {testimonials[0]?.author || "Artisan Ateliya"}
              </p>
              <p class="text-sm text-ateliya-primary font-semibold">
                {testimonials[0]?.role || "Proprietaire de Boutique"}
              </p>
              <div class="flex items-center gap-1 mt-0.5">
                <Icon name="map-pin" size="xs" class="text-gray-400" />
                <span class="text-xs text-gray-400 font-medium">
                  {testimonials[0]?.location || "Abidjan, Cote d'Ivoire"}
                </span>
              </div>
            </div>
          </div>

          <!-- Shine effect -->
          <div
            class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/0 to-transparent group-hover/card:via-white/10 transition-all duration-1000 -translate-x-full group-hover/card:translate-x-full pointer-events-none rounded-2xl"
          >
          </div>
        </div>

        <!-- Hatched circle decoration -->
        <div
          class="absolute -bottom-4 -left-4 w-16 h-16 opacity-20 hidden lg:block"
        >
          <div
            class="w-full h-full rounded-full"
            style="background: repeating-linear-gradient(45deg, transparent, transparent 2.5px, #2FAFA440 2.5px, #2FAFA440 5px);"
          >
          </div>
        </div>
      </div>
    </div>

    <!-- ---- Additional Testimonials Carousel ---- -->
    <div class="mb-10">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          testimonials.slice(1, 4).map((t, idx) => (
            <div
              class="group/t relative bg-white/[0.94] backdrop-blur-sm rounded-2xl p-6 border border-ateliya-border/[0.55] hover:border-ateliya-primary/25 hover:shadow-[0_10px_24px_rgba(18,63,59,0.055)] hover:-translate-y-0.5 transition-all duration-300 testi-card-reveal"
              style={`animation-delay: ${idx * 100}ms`}
            >
              <div class="absolute top-0 left-5 right-5 h-px rounded-full bg-gradient-to-r from-ateliya-primary to-ateliya-secondary opacity-0 group-hover/t:opacity-100 transition-opacity duration-300" />

              <div class="flex gap-0.5 mb-4">
                {[...Array(5)].map(() => (
                  <Icon name="star" size="xs" class="text-amber-400" />
                ))}
              </div>

              <p class="text-gray-600 text-sm leading-relaxed mb-5 line-clamp-4">
                "{t.text}"
              </p>

              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-ateliya-primary to-ateliya-secondary flex items-center justify-center text-white font-bold text-sm shadow-[0_8px_18px_rgba(47,175,164,0.14)]">
                  {t.author.charAt(0)}
                  {t.author.split(" ")[1]?.charAt(0) || ""}
                </div>
                <div>
                  <p class="text-sm font-serif font-extrabold tracking-tighter text-gray-900">
                    {t.author}
                  </p>
                  <p class="text-xs text-gray-400">{t.role}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes testiCardReveal {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes testiArcEntrance {
    from {
      opacity: 0;
      transform: scale(0.85);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes testiBounce1 {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-6px) scale(1.1);
    }
  }

  @keyframes testiBounce2 {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-4px) scale(0.9);
    }
  }

  .testi-card-reveal {
    animation: testiCardReveal 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .testi-stat-reveal {
    animation: testiCardReveal 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .testi-arc-entrance {
    animation: testiArcEntrance 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
  }

  .testi-bounce-1 {
    animation: testiBounce1 3s ease-in-out infinite;
  }

  .testi-bounce-2 {
    animation: testiBounce2 3.5s ease-in-out infinite;
  }

  .line-clamp-4 {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
