---
import { ChevronUp } from 'lucide-astro';
import { socials, navLinks, legalLinks } from "../data/footer";
---

<footer class="relative overflow-hidden bg-ateliya-dark text-white">
  <!-- Background Ultra-Subtil -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-ateliya-primary/8 rounded-full blur-3xl" />
    <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-ateliya-secondary/7 rounded-full blur-3xl" />
  </div>

  <div class="container-wide relative z-10 py-16 md:py-24">
    <!-- Main Content -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-16 mb-20 pb-20 border-b border-white/15">
      
      <!-- Brand + Description -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-flex items-center gap-4 mb-8 group">
          <div class="w-14 h-14 bg-gradient-to-br from-ateliya-primary to-ateliya-secondary rounded-2xl flex items-center justify-center text-white font-black text-2xl shadow-2xl group-hover:shadow-glow-primary-lg group-hover:scale-110 transition-all duration-300">
            A
          </div>
          <span class="text-4xl font-black bg-gradient-to-r from-ateliya-primary to-ateliya-secondary bg-clip-text text-transparent">
            Ateliya
          </span>
        </a>
        <p class="text-white/70 leading-relaxed mb-10 max-w-sm text-lg">
          La solution moderne pour gérer votre atelier de couture efficacement et professionnellement.
        </p>

        <!-- Réseaux Sociaux Ultra-Stylés -->
        <div class="flex gap-4">
          {socials.map((social) => (
            <a
              href={social.href}
              class="w-12 h-12 flex items-center justify-center rounded-xl bg-white/10 hover:bg-ateliya-primary border border-white/20 hover:border-ateliya-primary text-white/70 hover:text-white transition-all duration-300 hover:scale-125 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ateliya-primary group/social"
              aria-label={social.name}
              set:html={social.svg}
            />
          ))}
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="text-xl font-black text-white mb-8">Navigation</h3>
        <ul class="space-y-4">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-white/70 hover:text-ateliya-primary transition-colors duration-300 flex items-center gap-3 group text-lg"
              >
                <span class="w-2 h-2 rounded-full bg-ateliya-primary/60 group-hover:bg-ateliya-primary group-hover:scale-150 transition-all duration-300" />
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Liens Légaux -->
      <div>
        <h3 class="text-xl font-black text-white mb-8">Légal</h3>
        <ul class="space-y-4">
          {legalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-white/70 hover:text-ateliya-primary transition-colors duration-300 flex items-center gap-3 group text-lg"
              >
                <span class="w-2 h-2 rounded-full bg-ateliya-primary/60 group-hover:bg-ateliya-primary group-hover:scale-150 transition-all duration-300" />
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Newsletter Ultra-Stylée -->
      <div>
        <h3 class="text-xl font-black text-white mb-6">Newsletter</h3>
        <p class="text-white/70 text-base mb-8">
          Recevez nos actualités, conseils et offres exclusives.
        </p>

        <form class="space-y-4" id="newsletter-form">
          <input
            type="email"
            placeholder="Votre email"
            required
            class="w-full px-5 py-4 rounded-xl bg-white/10 border-2 border-white/25 focus:border-ateliya-primary text-white placeholder:text-white/50 text-base focus:outline-none transition-colors duration-300 backdrop-blur-md"
            aria-label="Email pour newsletter"
          />
          <button
            type="submit"
            class="w-full px-6 py-4 rounded-xl bg-gradient-to-r from-ateliya-primary to-ateliya-secondary text-white font-black text-base hover:shadow-2xl hover:shadow-ateliya-primary/50 transition-all duration-300 hover:scale-105 active:scale-95"
          >
            S'abonner
          </button>
        </form>

        <p class="text-sm text-white/50 mt-4">
          Désabonnement possible à tout moment.
        </p>
      </div>
    </div>

    <!-- Bottom Section -->
    <div class="text-center space-y-4">
      <div class="text-white/60 text-base">
        <p>&copy; {new Date().getFullYear()} Ateliya. Tous droits réservés. </p>
      </div>
    </div>
  </div>

  <!-- Scroll to Top Button Ultra-Stylé -->
  <button
    id="scroll-to-top"
    class="fixed bottom-10 right-10 w-14 h-14 flex items-center justify-center bg-gradient-to-br from-ateliya-primary to-ateliya-secondary text-white rounded-2xl shadow-2xl opacity-0 pointer-events-none translate-y-4 transition-all duration-300 hover:scale-125 z-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ateliya-primary focus-visible:ring-offset-2 group/scroll"
    aria-label="Retour en haut"
  >
    <ChevronUp class="w-7 h-7 group-hover/scroll:animate-bounce" />
  </button>
</footer>

<script>
  // Newsletter Form
  const newsletterForm = document.getElementById("newsletter-form");
  if (newsletterForm) {
    newsletterForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const form = newsletterForm as HTMLFormElement;
      const input = form.querySelector('input[type="email"]') as HTMLInputElement;
      const button = form.querySelector("button") as HTMLButtonElement;
      const originalText = button.textContent;

      button.textContent = "✓ Inscrit !";
      button.disabled = true;
      button.classList.add("opacity-75");

      setTimeout(() => {
        input.value = "";
        button.textContent = originalText;
        button.disabled = false;
        button.classList.remove("opacity-75");
      }, 2000);
    });
  }

  // Scroll to Top Button
  const scrollBtn = document.getElementById("scroll-to-top");
  if (scrollBtn) {
    const toggleButton = () => {
      if (window.scrollY > 400) {
        scrollBtn.classList.remove("opacity-0", "pointer-events-none", "translate-y-4");
      } else {
        scrollBtn.classList.add("opacity-0", "pointer-events-none", "translate-y-4");
      }
    };

    window.addEventListener("scroll", toggleButton, { passive: true });

    scrollBtn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    toggleButton();
  }
</script>