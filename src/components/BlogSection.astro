---
import Icon from "../components/Icon.astro";
import { blogPosts } from "../data/data";
---

<section
  id="blog"
  class="relative py-24 lg:py-28 overflow-hidden bg-gradient-to-br from-teal-50/60 via-white to-amber-50/20"
>
  <!-- ---- Background Decorations ---- -->
  <div
    class="absolute right-0 top-0 w-[45%] h-[65%] bg-gradient-to-bl from-ateliya-primary/4 to-transparent rounded-bl-[100px]"
  >
  </div>

  <div
    class="absolute top-[8%] left-[20%] w-72 h-72 bg-ateliya-primary/[0.035] rounded-full blur-[120px]"
  >
  </div>
  <div
    class="absolute bottom-[12%] right-[15%] w-56 h-56 bg-ateliya-secondary/[0.025] rounded-full blur-[100px]"
  >
  </div>

  <div
    class="absolute inset-0 opacity-[0.014]"
    style="background-image: radial-gradient(circle, #2FAFA4 1px, transparent 1px); background-size: 36px 36px;"
  >
  </div>

  <!-- Dot grids -->
  <div class="absolute left-8 top-[8%] grid grid-cols-5 gap-2 opacity-[0.16]">
    {
      [...Array(20)].map((_, i) => (
        <div
          class={`w-1.5 h-1.5 rounded-full ${i % 3 === 0 ? "bg-ateliya-primary" : i % 3 === 1 ? "bg-ateliya-secondary/50" : "bg-gray-300"}`}
        />
      ))
    }
  </div>
  <div class="absolute right-10 bottom-[6%] grid grid-cols-4 gap-3 opacity-[0.14]">
    {
      [...Array(12)].map((_, i) => (
        <div
          class={`w-2 h-2 rounded-full ${i % 2 === 0 ? "bg-ateliya-primary/40" : "bg-ateliya-secondary/25"}`}
        />
      ))
    }
  </div>

  <!-- ---- Content ---- -->
  <div class="container mx-auto px-6 lg:px-10 relative z-10">
    <!-- Header -->
    <div class="text-center mb-14">
      <div
        class="inline-flex items-center gap-2 px-4 py-2 bg-ateliya-primary/10 rounded-full mb-5"
      >
        <Icon name="book-open" size="sm" class="text-ateliya-primary" />
        <span class="text-sm font-bold text-ateliya-primary"
          >Ressources & Actualites</span
        >
      </div>

      <h2
        class="text-3xl md:text-4xl lg:text-5xl font-serif font-extrabold tracking-tighter text-gray-900 leading-tight mb-4"
      >
        Actualites &
        <span
          class="text-ateliya-primary"
        >
          Conseils
        </span>
      </h2>

      <p class="text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed tracking-wide">
        Restez informe des dernieres tendances et astuces pour optimiser votre
        atelier et maximiser votre rentabilite
      </p>
    </div>

    <!-- Blog Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-16">
      {
        blogPosts.map((post, i) => (
          <article
            class="group blog-card-reveal"
            style={`animation-delay: ${i * 80}ms`}
          >
            <div class="h-full bg-white/[0.94] backdrop-blur-sm rounded-2xl border border-ateliya-border/[0.55] hover:border-ateliya-primary/[0.22] hover:shadow-[0_6px_16px_rgba(18,63,59,0.04)] transition-[transform,background-color,border-color,box-shadow,color] duration-200 ease-out hover:-translate-y-px overflow-hidden flex flex-col relative">
              {/* Top accent line */}
              <div class="absolute top-0 left-0 right-0 h-px bg-ateliya-primary scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left z-10" />

              {/* Image */}
              <div class="relative h-52 overflow-hidden">
                {post.image ? (
                  <img
                    src={post.image}
                    alt={post.title}
                    class="w-full h-full object-cover group-hover:-translate-y-px transition-transform duration-500"
                    loading="lazy"
                    decoding="async"
                    width="800"
                    height="416"
                  />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-gray-50 to-ateliya-primary/[0.035] flex items-center justify-center">
                    <div class="p-5 rounded-xl bg-ateliya-primary/[0.08] border border-ateliya-primary/[0.16]">
                      <Icon
                        name={post.icon}
                        size="2xl"
                        class="text-ateliya-primary"
                      />
                    </div>
                  </div>
                )}

                {/* Gradient overlay */}
                <div class="absolute inset-0 bg-gradient-to-t from-gray-900/30 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />

                {/* Category badge */}
                <div class="absolute top-3 right-3 px-3 py-1 rounded-full text-[11px] font-bold bg-white/90 backdrop-blur-sm text-ateliya-primary border border-ateliya-primary/20 opacity-0 group-hover:opacity-100 translate-y-2 group-hover:translate-y-0 transition-[transform,background-color,border-color,box-shadow,color] duration-200 ease-out">
                  {post.category}
                </div>
              </div>

              {/* Content */}
              <div class="flex-1 p-5 flex flex-col">
                {/* Date */}
                <div class="flex items-center gap-2 mb-3 pb-3 border-b border-gray-100">
                  <Icon name="calendar" size="xs" class="text-gray-400" />
                  <span class="text-xs text-gray-400 font-medium">
                    {post.date}
                  </span>
                </div>

                {/* Title */}
                <h3 class="text-base font-serif font-extrabold tracking-tighter text-gray-900 mb-2 line-clamp-2 group-hover:text-ateliya-primary transition-colors duration-300 leading-snug">
                  {post.title}
                </h3>

                {/* Description */}
                <p class="text-sm text-gray-500 leading-relaxed mb-5 line-clamp-2 flex-1 tracking-wide">
                  {post.description}
                </p>

                {/* Read more */}
                <a
                  href="#"
                  class="inline-flex items-center gap-2 text-ateliya-primary font-semibold text-sm group-hover:gap-3 transition-[transform,background-color,border-color,box-shadow,color] duration-200 ease-out"
                >
                  <span>Lire plus</span>
                  <Icon
                    name="arrow-right"
                    size="xs"
                    class="group-hover:translate-x-1 transition-transform duration-300"
                  />
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- CTA Banner -->
    <div
      class="relative rounded-2xl overflow-hidden border-ateliya-light p-[1px]"
    >
      <div
        class="relative rounded-2xl bg-gradient-to-br from-teal-50 via-white to-amber-50/30 overflow-hidden"
      >
        <!-- Banner bg decorations -->
        <div
          class="absolute right-0 top-0 w-1/3 h-full bg-gradient-to-l from-ateliya-primary/[0.035] to-transparent"
        >
        </div>
        <div
          class="absolute left-[15%] top-1/2 -translate-y-1/2 w-40 h-40 bg-ateliya-primary/[0.03] rounded-full blur-[80px]"
        >
        </div>

        <!-- Dot pattern -->
        <div
          class="absolute right-8 top-1/2 -translate-y-1/2 grid grid-cols-4 gap-2 opacity-[0.12]"
        >
          {
            [...Array(16)].map((_, i) => (
              <div
                class={`w-1.5 h-1.5 rounded-full ${i % 2 === 0 ? "bg-ateliya-primary" : "bg-ateliya-secondary/50"}`}
              />
            ))
          }
        </div>

        <div
          class="relative z-10 p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-6"
        >
          <div class="flex-1">
            <h3
              class="text-2xl md:text-3xl font-serif font-extrabold tracking-tighter text-gray-900 mb-2 leading-tight"
            >
              Explorez notre
              <span
                class="text-ateliya-primary"
              >
                Blog Complet
              </span>
            </h3>
            <p class="text-gray-500 tracking-wide">
              Decouvrez des centaines d'articles, tutoriels et guides pour
              maitriser Ateliya
            </p>
          </div>

          <a
            href="/blog/blog"
            class="btn-action flex-shrink-0 group/btn whitespace-nowrap"
          >
            <span>Voir tous les articles</span>
            <Icon
              name="arrow-right"
              size="sm"
              class="group-hover/btn:translate-x-1 transition-transform duration-300"
            />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes blogCardReveal {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .blog-card-reveal {
    animation: blogCardReveal 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

