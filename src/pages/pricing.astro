---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const plans = [
  {
    name: "Starter",
    description: "Pour debuter et tester Ateliya",
    price: { monthly: 5000, annual: 50000 },
    popular: false,
    icon: "zap",
    iconColor: "text-ateliya-primary",
    iconBg: "from-ateliya-primary/20 to-ateliya-primary/10",
    glowBg: "from-ateliya-primary/15 to-teal-400/10",
    barGradient: "from-ateliya-primary to-teal-400",
    number: "01",
    features: [
      { text: "Jusqu'a 50 commandes/mois", included: true },
      { text: "Gestion clients & stock", included: true },
      { text: "Notifications SMS (50/mois)", included: true },
      { text: "1 utilisateur", included: true },
      { text: "Support email", included: true },
      { text: "Rapports basiques", included: true },
      { text: "Paiements mobile money", included: true },
      { text: "Mode hors ligne", included: false },
      { text: "API & integrations", included: false },
      { text: "Formation personnalisee", included: false },
    ],
    cta: "Commencer gratuitement",
  },
  {
    name: "Professionnel",
    description: "Pour les ateliers etablis",
    price: { monthly: 15000, annual: 150000 },
    popular: true,
    icon: "star",
    iconColor: "text-ateliya-secondary",
    iconBg: "from-ateliya-secondary/20 to-ateliya-secondary/10",
    glowBg: "from-ateliya-secondary/15 to-amber-400/10",
    barGradient: "from-ateliya-secondary to-amber-400",
    number: "02",
    features: [
      { text: "Commandes illimitees", included: true },
      { text: "Gestion clients & stock", included: true },
      { text: "Notifications SMS illimitees", included: true },
      { text: "Jusqu'a 3 utilisateurs", included: true },
      { text: "Support prioritaire 24/7", included: true },
      { text: "Rapports avances", included: true },
      { text: "Paiements mobile money", included: true },
      { text: "Mode hors ligne", included: true },
      { text: "API & integrations", included: true },
      { text: "Formation personnalisee", included: false },
    ],
    cta: "Essayer 14 jours gratuit",
  },
  {
    name: "Enterprise",
    description: "Pour les grandes structures",
    price: { monthly: 35000, annual: 350000 },
    popular: false,
    icon: "shield",
    iconColor: "text-blue-500",
    iconBg: "from-blue-500/20 to-blue-500/10",
    glowBg: "from-blue-500/15 to-indigo-400/10",
    barGradient: "from-blue-500 to-indigo-400",
    number: "03",
    features: [
      { text: "Commandes illimitees", included: true },
      { text: "Gestion clients & stock", included: true },
      { text: "Notifications SMS illimitees", included: true },
      { text: "Utilisateurs illimites", included: true },
      { text: "Support dedie 24/7", included: true },
      { text: "Rapports personnalises", included: true },
      { text: "Paiements mobile money", included: true },
      { text: "Mode hors ligne", included: true },
      { text: "API & integrations avancees", included: true },
      { text: "Formation personnalisee", included: true },
    ],
    cta: "Nous contacter",
  },
];

const featureComparison = [
  {
    category: "Gestion",
    icon: "scissors",
    color: "text-ateliya-primary",
    bg: "from-ateliya-primary/20 to-ateliya-primary/10",
    features: [
      { name: "Commandes par mois", starter: "50", pro: "Illimite", enterprise: "Illimite" },
      { name: "Clients", starter: "Illimite", pro: "Illimite", enterprise: "Illimite" },
      { name: "Produits/Tissus", starter: "Illimite", pro: "Illimite", enterprise: "Illimite" },
      { name: "Gestion stock", starter: true, pro: true, enterprise: true },
    ],
  },
  {
    category: "Communication",
    icon: "mail",
    color: "text-ateliya-secondary",
    bg: "from-ateliya-secondary/20 to-ateliya-secondary/10",
    features: [
      { name: "SMS par mois", starter: "50", pro: "Illimite", enterprise: "Illimite" },
      { name: "Email notifications", starter: true, pro: true, enterprise: true },
      { name: "WhatsApp (bientot)", starter: false, pro: true, enterprise: true },
    ],
  },
  {
    category: "Support & extras",
    icon: "headphones",
    color: "text-blue-500",
    bg: "from-blue-500/20 to-blue-500/10",
    features: [
      { name: "Support email", starter: true, pro: true, enterprise: true },
      { name: "Support telephone", starter: false, pro: true, enterprise: true },
      { name: "Support dedie", starter: false, pro: false, enterprise: true },
      { name: "Formation", starter: false, pro: false, enterprise: true },
    ],
  },
];

const faqPricing = [
  { question: "Puis-je essayer gratuitement ?", answer: "Oui ! Tous les plans incluent 14 jours d'essai gratuit, sans carte bancaire requise." },
  { question: "Comment puis-je payer ?", answer: "Nous acceptons Orange Money, MTN Money, Moov Money, Wave et cartes bancaires via notre plateforme securisee." },
  { question: "Puis-je changer de plan ?", answer: "Oui, vous pouvez upgrader ou downgrader a tout moment. Les changements prennent effet immediatement." },
  { question: "Y a-t-il des frais caches ?", answer: "Non, aucun frais cache. Le prix affiche est tout compris : app, support, mises a jour et hebergement." },
  { question: "Que se passe-t-il si je depasse ma limite ?", answer: "Vous recevrez une notification et pourrez upgrader votre plan. Vos donnees restent accessibles." },
  { question: "Puis-je annuler a tout moment ?", answer: "Oui, sans preavis ni penalites. Vos donnees sont exportables pendant 30 jours apres l'annulation." },
];
---

<Layout title="Tarification - Ateliya">
  <Header />

  <main class="bg-white overflow-hidden">

    <!-- ============================================
         HERO
         ============================================ -->
    <section class="relative py-12 lg:py-16 overflow-hidden bg-gradient-to-b from-white via-gray-50/30 to-white">

      <div class="absolute top-[5%] right-[20%] w-80 h-80 bg-ateliya-primary/5 rounded-full blur-[120px]"></div>
      <div class="absolute bottom-[15%] left-[15%] w-64 h-64 bg-ateliya-secondary/4 rounded-full blur-[100px]"></div>
      <div class="absolute inset-0 opacity-[0.02]" style="background-image: radial-gradient(circle, #34C7B8 1px, transparent 1px); background-size: 36px 36px;"></div>

      <div class="absolute right-8 top-[6%] grid grid-cols-5 gap-2 opacity-25">
        {[...Array(20)].map((_, i) => (
          <div class={`w-1.5 h-1.5 rounded-full ${i % 3 === 0 ? "bg-ateliya-primary" : i % 3 === 1 ? "bg-ateliya-secondary/50" : "bg-gray-300"}`} />
        ))}
      </div>
      <div class="absolute left-8 bottom-[10%] grid grid-cols-4 gap-2.5 opacity-20">
        {[...Array(12)].map((_, i) => (
          <div class={`w-1.5 h-1.5 rounded-full ${i % 2 === 0 ? "bg-ateliya-primary/50" : "bg-gray-300"}`} />
        ))}
      </div>

      <div class="container mx-auto px-6 lg:px-12 relative z-10">
        <div class="text-center mb-8 space-y-4">

          <div class="inline-flex items-center gap-2 px-4 py-2 bg-ateliya-primary/10 rounded-full">
            <Icon name="tag" size="sm" class="text-ateliya-primary" />
            <span class="text-sm font-bold text-ateliya-primary">Tarifs Transparents</span>
          </div>

          <h1 class="text-3xl md:text-4xl lg:text-5xl font-black leading-tight text-gray-900">
            <span class="block">Un prix juste</span>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-ateliya-secondary to-ateliya-primary">
              pour chaque atelier
            </span>
          </h1>

          <p class="text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">
            Commencez avec <span class="font-bold text-ateliya-primary">14 jours gratuits</span>.
            Aucune carte requise. Annulation en 1 clic.
          </p>

          <!-- Toggle -->
          <div class="flex items-center justify-center gap-4 pt-2">
            <span class="text-sm font-bold text-gray-900 toggle-label" data-period="monthly">Mensuel</span>
            <button
              id="billingToggle"
              class="pricing-toggle"
              role="switch"
              aria-checked="false"
              aria-label="Basculer entre mensuel et annuel"
            >
              <span class="pricing-toggle__thumb"></span>
            </button>
            <span class="text-sm font-bold text-gray-400 toggle-label" data-period="annual">
              Annuel
              <span class="ml-1.5 px-2 py-0.5 text-[10px] font-black bg-ateliya-primary/10 text-ateliya-primary rounded-full uppercase tracking-wide">-17%</span>
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================
         PRICING CARDS
         ============================================ -->
    <section class="relative py-4 -mt-6">
      <div class="container mx-auto px-6 lg:px-12 max-w-7xl">

        <div class="grid md:grid-cols-3 gap-5 md:gap-6">
          {plans.map((plan, idx) => (
            <div class={`group/plan h-full ${plan.popular ? "md:-mt-4" : ""}`}>
              <div class="h-full relative">

                <div class={`absolute -inset-1 bg-gradient-to-br ${plan.glowBg} rounded-2xl blur-lg opacity-0 group-hover/plan:opacity-60 transition-all duration-700 -z-10`} />

                <div class={`h-full p-5 md:p-6 rounded-2xl bg-white border-2 transition-all duration-500 hover:shadow-lg hover:-translate-y-0.5 relative overflow-hidden ${
                  plan.popular
                    ? "border-ateliya-primary/30 shadow-none"
                    : "border-gray-100 group-hover/plan:border-ateliya-primary/30"
                }`}>

                  <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-ateliya-primary to-transparent opacity-0 group-hover/plan:opacity-100 transition-opacity duration-500"></div>

                  {plan.popular && (
                    <div class="absolute -top-px left-0 right-0 flex justify-center">
                      <div class="px-5 py-1.5 rounded-b-xl bg-gradient-to-r from-ateliya-primary to-ateliya-secondary text-white text-[11px] font-black tracking-wide uppercase shadow-sm shadow-ateliya-primary/15">
                        Le plus populaire
                      </div>
                    </div>
                  )}

                  <div class={`relative z-10 flex flex-col h-full ${plan.popular ? "pt-5" : ""}`}>

                    {/* Header : icon + number */}
                    <div class="flex items-start justify-between mb-4">
                      <div class={`relative flex items-center justify-center w-12 h-12 rounded-2xl bg-gradient-to-br ${plan.iconBg} group-hover/plan:scale-110 transition-all duration-500 shadow-sm`}>
                        <Icon name={plan.icon} size="md" class={plan.iconColor} />
                      </div>
                      <div class="text-5xl md:text-6xl font-black text-ateliya-primary/8 leading-none select-none">
                        {plan.number}
                      </div>
                    </div>

                    {/* Title */}
                    <div class="space-y-1 mb-4">
                      <h3 class="text-xl md:text-2xl font-black text-gray-900 leading-tight">{plan.name}</h3>
                      <div class={`w-12 h-1 bg-gradient-to-r ${plan.barGradient} rounded-full group-hover/plan:w-20 transition-all duration-500`}></div>
                      <p class="text-sm text-gray-500 pt-0.5">{plan.description}</p>
                    </div>

                    {/* Price */}
                    <div class="mb-4">
                      <div class="flex items-baseline gap-1.5">
                        <span
                          class="text-4xl md:text-5xl font-black text-gray-900 tabular-nums price-value"
                          data-monthly={plan.price.monthly}
                          data-annual={plan.price.annual}
                        >
                          {plan.price.monthly.toLocaleString()}
                        </span>
                        <span class="text-base text-gray-400 font-bold">FCFA</span>
                      </div>
                      <p class="text-sm text-gray-400 mt-0.5 price-period">par mois</p>
                      <p class="text-xs text-ateliya-primary font-bold mt-1 annual-savings hidden">
                        Economisez {(plan.price.monthly * 12 - plan.price.annual).toLocaleString()} FCFA/an
                      </p>
                    </div>

                    {/* CTA */}
                    <div class="mb-4">
                      <button class={`w-full py-3 rounded-xl font-bold text-sm transition-all duration-300 active:scale-[0.97] ${
                        plan.popular
                          ? "bg-gradient-to-r from-ateliya-primary to-ateliya-secondary text-white shadow-sm shadow-ateliya-primary/15 hover:shadow-md hover:shadow-ateliya-primary/20"
                          : "bg-gray-50 text-gray-800 border border-gray-200 hover:bg-ateliya-primary/5 hover:border-ateliya-primary/30 hover:text-ateliya-dark"
                      }`}>
                        {plan.cta}
                      </button>
                    </div>

                    {/* Features */}
                    <div class="space-y-2.5 flex-grow">
                      {plan.features.map((feature) => (
                        <div class={`flex items-start gap-2.5 ${!feature.included ? "opacity-40" : ""}`}>
                          <div class={`flex-shrink-0 w-5 h-5 rounded-full flex items-center justify-center mt-0.5 ${
                            feature.included
                              ? "bg-ateliya-primary/10"
                              : "bg-gray-100"
                          }`}>
                            <Icon
                              name={feature.included ? "check" : "x"}
                              size="xs"
                              class={feature.included ? "text-ateliya-primary" : "text-gray-300"}
                            />
                          </div>
                          <span class="text-sm text-gray-600 leading-snug">{feature.text}</span>
                        </div>
                      ))}
                    </div>

                    {/* Link */}
                    <div class="flex items-center gap-2 text-ateliya-primary font-bold text-sm group/link cursor-pointer mt-4 pt-3 border-t border-gray-100">
                      <span>En savoir plus</span>
                      <Icon name="arrow-right" size="sm" class="group-hover/link:translate-x-2 transition-transform duration-300" />
                    </div>

                    <div class="absolute bottom-0 left-0 right-0 h-1 bg-ateliya-primary/10 rounded-b-2xl overflow-hidden">
                      <div class={`h-full w-0 bg-gradient-to-r ${plan.barGradient} group-hover/plan:w-full transition-all duration-1000`}></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        {/* Trust badges */}
        <div class="flex flex-wrap items-center justify-center gap-3 mt-10">
          {[
            { icon: "shield", text: "Paiement securise" },
            { icon: "check", text: "Sans engagement" },
            { icon: "zap", text: "Activation instantanee" },
            { icon: "refresh", text: "Changement facile" },
          ].map((badge) => (
            <div class="flex items-center gap-2 px-4 py-2 bg-white/80 backdrop-blur-sm rounded-xl border border-gray-100">
              <div class="w-7 h-7 rounded-lg bg-ateliya-primary/8 flex items-center justify-center">
                <Icon name={badge.icon} size="sm" class="text-ateliya-primary" />
              </div>
              <span class="text-sm font-bold text-gray-600">{badge.text}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================
         COMPARISON TABLE
         ============================================ -->
    <section class="relative py-14 lg:py-18 overflow-hidden bg-gradient-to-b from-white via-gray-50/30 to-white">

      <div class="absolute top-[10%] left-[10%] w-72 h-72 bg-ateliya-primary/4 rounded-full blur-[120px]"></div>
      <div class="absolute bottom-[10%] right-[15%] w-64 h-64 bg-ateliya-secondary/3 rounded-full blur-[100px]"></div>
      <div class="absolute inset-0 opacity-[0.02]" style="background-image: radial-gradient(circle, #34C7B8 1px, transparent 1px); background-size: 36px 36px;"></div>

      <div class="container mx-auto px-6 lg:px-12 max-w-6xl relative z-10">

        <div class="text-center mb-10 md:mb-12 space-y-4">
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-ateliya-secondary/10 rounded-full">
            <Icon name="list" size="sm" class="text-ateliya-secondary" />
            <span class="text-sm font-bold text-ateliya-secondary">Comparaison Complete</span>
          </div>

          <h2 class="text-3xl md:text-4xl lg:text-5xl font-black leading-tight text-gray-900">
            <span class="block">Tout ce qui est inclus</span>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-ateliya-secondary to-ateliya-primary">
              dans chaque plan
            </span>
          </h2>
        </div>

        {/* Table header - sticky */}
        <div class="comparison-head sticky top-0 z-20 mb-3">
          <div class="grid grid-cols-4 gap-4 p-4 rounded-2xl bg-white/80 backdrop-blur-md border border-gray-100 shadow-none">
            <div class="text-sm font-bold text-gray-400 uppercase tracking-wider">Fonctionnalite</div>
            <div class="text-center text-sm font-black text-gray-900">Starter</div>
            <div class="text-center">
              <span class="text-sm font-black text-ateliya-primary">Pro</span>
              <div class="w-6 h-0.5 bg-gradient-to-r from-ateliya-primary to-ateliya-secondary rounded-full mx-auto mt-1"></div>
            </div>
            <div class="text-center text-sm font-black text-gray-900">Enterprise</div>
          </div>
        </div>

        {/* Category groups */}
        <div class="space-y-4">
          {featureComparison.map((category) => (
            <div class="group/cat">
              <div class="relative">
                <div class={`absolute -inset-1 bg-gradient-to-br ${category.bg} rounded-2xl blur-lg opacity-0 group-hover/cat:opacity-40 transition-all duration-700 -z-10`} />

                <div class="p-5 md:p-6 rounded-2xl bg-white border-2 border-gray-100 group-hover/cat:border-ateliya-primary/20 transition-all duration-500 hover:shadow-lg overflow-hidden relative">

                  <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-ateliya-primary to-transparent opacity-0 group-hover/cat:opacity-100 transition-opacity duration-500"></div>

                  {/* Category header */}
                  <div class="flex items-center gap-3 mb-4">
                    <div class={`flex items-center justify-center w-9 h-9 rounded-xl bg-gradient-to-br ${category.bg} shadow-sm`}>
                      <Icon name={category.icon} size="sm" class={category.color} />
                    </div>
                    <h3 class="text-base font-black text-gray-900">{category.category}</h3>
                  </div>

                  {/* Rows */}
                  <div class="space-y-0">
                    {category.features.map((feature, idx) => (
                      <div class={`grid grid-cols-4 gap-4 py-3 ${idx > 0 ? "border-t border-gray-50" : ""} hover:bg-ateliya-primary/[0.02] -mx-2 px-2 rounded-lg transition-colors duration-200`}>
                        <div class="text-sm font-medium text-gray-600">{feature.name}</div>
                        {["starter", "pro", "enterprise"].map((tier) => {
                          const val = feature[tier as keyof typeof feature];
                          return (
                            <div class="text-center flex items-center justify-center">
                              {typeof val === "boolean" ? (
                                val ? (
                                  <div class="w-6 h-6 rounded-full bg-ateliya-primary/10 flex items-center justify-center">
                                    <Icon name="check" size="xs" class="text-ateliya-primary" />
                                  </div>
                                ) : (
                                  <span class="text-gray-200 font-bold">-</span>
                                )
                              ) : (
                                <span class="text-sm font-bold text-gray-900 px-3 py-1 bg-gray-50 rounded-lg">{val}</span>
                              )}
                            </div>
                          );
                        })}
                      </div>
                    ))}
                  </div>

                  <div class="absolute bottom-0 left-0 right-0 h-1 bg-ateliya-primary/10 rounded-b-2xl overflow-hidden">
                    <div class={`h-full w-0 bg-gradient-to-r ${category.bg.replace("/20", "").replace("/10", "")} group-hover/cat:w-full transition-all duration-1000`}></div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================
         FAQ
         ============================================ -->
    <section class="relative py-14 lg:py-18 overflow-hidden bg-gradient-to-b from-white via-gray-50/30 to-white">

      <div class="absolute top-[10%] right-[10%] w-72 h-72 bg-ateliya-primary/4 rounded-full blur-[120px]"></div>
      <div class="absolute inset-0 opacity-[0.02]" style="background-image: radial-gradient(circle, #34C7B8 1px, transparent 1px); background-size: 36px 36px;"></div>

      <div class="absolute right-8 top-[8%] grid grid-cols-5 gap-2 opacity-25">
        {[...Array(15)].map((_, i) => (
          <div class={`w-1.5 h-1.5 rounded-full ${i % 3 === 0 ? "bg-ateliya-primary" : "bg-gray-300"}`} />
        ))}
      </div>

      <div class="container mx-auto px-6 lg:px-12 max-w-3xl relative z-10">

        <div class="text-center mb-10 md:mb-12 space-y-4">
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-ateliya-primary/10 rounded-full">
            <Icon name="help-circle" size="sm" class="text-ateliya-primary" />
            <span class="text-sm font-bold text-ateliya-primary">FAQ</span>
          </div>

          <h2 class="text-3xl md:text-4xl lg:text-5xl font-black leading-tight text-gray-900">
            <span class="block">Questions</span>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-ateliya-secondary to-ateliya-primary">
              frequentes
            </span>
          </h2>
        </div>

        <div class="space-y-3">
          {faqPricing.map((item, idx) => (
            <div class="group/faq faq-item">
              <div class="relative">
                <div class="absolute -inset-1 bg-gradient-to-br from-ateliya-primary/10 to-teal-400/5 rounded-2xl blur-lg opacity-0 faq-item-glow transition-all duration-700 -z-10"></div>

                <div class="p-5 rounded-2xl bg-white border-2 border-gray-100 transition-all duration-500 faq-item-card relative overflow-hidden">

                  <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-ateliya-primary to-transparent opacity-0 faq-item-accent transition-opacity duration-500"></div>

                  <button
                    class="w-full flex items-center justify-between gap-4 text-left"
                    aria-expanded="false"
                  >
                    <div class="flex items-center gap-3">
                      <div class="flex-shrink-0 w-9 h-9 rounded-xl bg-gradient-to-br from-ateliya-primary/15 to-ateliya-primary/5 flex items-center justify-center faq-item-icon transition-all duration-500">
                        <span class="text-sm font-black text-ateliya-primary">{String(idx + 1).padStart(2, "0")}</span>
                      </div>
                      <span class="font-bold text-gray-900 text-base">{item.question}</span>
                    </div>
                    <div class="faq-chevron flex-shrink-0 w-8 h-8 rounded-full bg-gray-50 flex items-center justify-center transition-all duration-300">
                      <Icon name="chevron-down" size="sm" class="text-gray-400 transition-transform duration-300" />
                    </div>
                  </button>

                  <div class="faq-answer">
                    <div class="pt-3 pl-12 text-gray-500 leading-relaxed text-sm">
                      {item.answer}
                    </div>
                  </div>

                  <div class="absolute bottom-0 left-0 right-0 h-1 bg-ateliya-primary/10 rounded-b-2xl overflow-hidden">
                    <div class="h-full w-0 bg-gradient-to-r from-ateliya-primary to-teal-400 faq-item-bar transition-all duration-1000"></div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================
         CTA FINAL
         ============================================ -->
    <section class="relative py-12 px-8 lg:px-12 mx-6 lg:mx-12 mb-14 rounded-3xl overflow-hidden bg-gradient-to-br from-teal-50/60 via-white to-amber-50/20 border border-gray-100">

