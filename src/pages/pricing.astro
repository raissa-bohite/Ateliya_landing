---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PricingSection from "../components/abonnement/PricingSection.tsx";
import {
  getModulesDisponibles,
  getPaysDisponibles,
} from "../lib/services/abonnementService";

const faqPricing = [
  { question: "Puis-je essayer gratuitement ?", answer: "Oui ! Tous les plans incluent 14 jours d'essai gratuit, sans carte bancaire requise." },
  { question: "Comment puis-je payer ?", answer: "Nous acceptons Orange Money, MTN Money, Moov Money, Wave et cartes bancaires via notre plateforme securisee." },
  { question: "Puis-je changer de plan ?", answer: "Oui, vous pouvez upgrader ou downgrader a tout moment. Les changements prennent effet immediatement." },
  { question: "Y a-t-il des frais caches ?", answer: "Non, aucun frais cache. Le prix affiche est tout compris : app, support, mises a jour et hebergement." },
  { question: "Que se passe-t-il si je depasse ma limite ?", answer: "Vous recevrez une notification et pourrez upgrader votre plan. Vos donnees restent accessibles." },
  { question: "Puis-je annuler a tout moment ?", answer: "Oui, sans preavis ni penalites. Vos donnees sont exportables pendant 30 jours apres l'annulation." },
];

const paysResponse = await getPaysDisponibles();
const initialPays = paysResponse.success ? paysResponse.data : [];
const initialPaysChoisi = initialPays[0] ?? null;
const modulesResponse = initialPaysChoisi
  ? await getModulesDisponibles(initialPaysChoisi.id)
  : { success: false, data: [] };
const initialModules = modulesResponse.success ? modulesResponse.data : [];
---

<Layout title="Tarification - Ateliya">
  <Header />

  <div class="bg-white overflow-hidden">

    <!-- ============================================
         HERO
         ============================================ -->
    <section class="relative pt-24 lg:pt-28 pb-10 lg:pb-14 overflow-hidden bg-gradient-to-b from-white via-gray-50/30 to-white">

      <div class="absolute top-[5%] right-[20%] w-80 h-80 bg-ateliya-primary/[0.035] rounded-full blur-[120px]"></div>
      <div class="absolute bottom-[15%] left-[15%] w-64 h-64 bg-ateliya-secondary/[0.025] rounded-full blur-[100px]"></div>
      <div class="absolute inset-0 opacity-[0.014]" style="background-image: radial-gradient(circle, #2FAFA4 1px, transparent 1px); background-size: 36px 36px;"></div>

      <div class="absolute right-8 top-[6%] grid grid-cols-5 gap-2 opacity-[0.16]">
        {[...Array(20)].map((_, i) => (
          <div class={`w-1.5 h-1.5 rounded-full ${i % 3 === 0 ? "bg-ateliya-primary" : i % 3 === 1 ? "bg-ateliya-secondary/50" : "bg-gray-300"}`} />
        ))}
      </div>
      <div class="absolute left-8 bottom-[10%] grid grid-cols-4 gap-2.5 opacity-[0.14]">
        {[...Array(12)].map((_, i) => (
          <div class={`w-1.5 h-1.5 rounded-full ${i % 2 === 0 ? "bg-ateliya-primary/50" : "bg-gray-300"}`} />
        ))}
      </div>

      <div class="container mx-auto px-6 lg:px-10 relative z-10">
        <div class="text-center space-y-4">

          <div class="inline-flex items-center gap-2 px-4 py-2 bg-ateliya-primary/10 rounded-full">
            <Icon name="tag" size="sm" class="text-ateliya-primary" />
            <span class="text-sm font-bold text-ateliya-primary">Tarifs Transparents</span>
          </div>

          <h1 class="text-3xl md:text-4xl lg:text-5xl font-serif font-extrabold tracking-tighter leading-tight text-gray-900">
            <span class="block">Un prix juste</span>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-ateliya-secondary to-ateliya-primary">
              pour chaque atelier
            </span>
          </h1>

          <p class="text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed tracking-wide">
            Choisissez l'offre qui vous correspond. <span class="font-bold text-ateliya-primary">Activation instantanée</span> après paiement.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================
         FORFAITS (dynamiques depuis l'API)
         ============================================ -->
    <section class="relative pb-8 lg:pb-10">
      <div class="container mx-auto px-6 lg:px-10 max-w-6xl">
        <PricingSection
          client:load
          initialPays={initialPays}
          initialPaysChoisiId={initialPaysChoisi?.id}
          initialModules={initialModules}
        />
      </div>
    </section>

    <!-- ============================================
         TRUST BADGES
         ============================================ -->
    <section class="relative pb-14">
      <div class="container mx-auto px-6 lg:px-10 max-w-6xl">
        <div class="flex flex-wrap items-center justify-center gap-3">
          {[
            { icon: "shield", text: "Paiement securise" },
            { icon: "check", text: "Sans engagement" },
            { icon: "zap", text: "Activation instantanee" },
            { icon: "refresh", text: "Changement facile" },
          ].map((badge) => (
            <div class="flex items-center gap-2 px-4 py-2 bg-white/[0.94] backdrop-blur-sm rounded-xl border border-ateliya-border/[0.55] shadow-[0_6px_16px_rgba(18,63,59,0.035)]">
              <div class="w-7 h-7 rounded-lg bg-ateliya-primary/[0.08] flex items-center justify-center">
                <Icon name={badge.icon} size="sm" class="text-ateliya-primary" />
              </div>
              <span class="text-sm font-bold text-gray-600">{badge.text}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================
         FAQ
         ============================================ -->
    <section class="relative py-14 lg:py-18 overflow-hidden bg-gradient-to-b from-white via-gray-50/30 to-white">

      <div class="absolute top-[10%] right-[10%] w-72 h-72 bg-ateliya-primary/[0.03] rounded-full blur-[120px]"></div>
      <div class="absolute inset-0 opacity-[0.014]" style="background-image: radial-gradient(circle, #2FAFA4 1px, transparent 1px); background-size: 36px 36px;"></div>

      <div class="absolute right-8 top-[8%] grid grid-cols-5 gap-2 opacity-[0.16]">
        {[...Array(15)].map((_, i) => (
          <div class={`w-1.5 h-1.5 rounded-full ${i % 3 === 0 ? "bg-ateliya-primary" : "bg-gray-300"}`} />
        ))}
      </div>

      <div class="container mx-auto px-6 lg:px-10 max-w-6xl relative z-10">

        <div class="text-center mb-10 md:mb-12 space-y-4">
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-ateliya-primary/10 rounded-full">
            <Icon name="help-circle" size="sm" class="text-ateliya-primary" />
            <span class="text-sm font-bold text-ateliya-primary">FAQ</span>
          </div>

          <h2 class="text-3xl md:text-4xl lg:text-5xl font-serif font-extrabold tracking-tighter leading-tight text-gray-900">
            <span class="block">Questions</span>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-ateliya-secondary to-ateliya-primary">
              frequentes
            </span>
          </h2>
        </div>

        <div class="space-y-3 max-w-3xl mx-auto">
          {faqPricing.map((item, idx) => (
            <div class="faq-item">
              <div class="relative">
                <div class="p-5 rounded-2xl bg-white/[0.96] border border-ateliya-border/[0.55] shadow-[0_8px_20px_rgba(18,63,59,0.04)] faq-item-card relative overflow-hidden">

                  <button
                    class="w-full flex items-center justify-between gap-4 text-left"
                    aria-expanded="false"
                  >
                    <div class="flex items-center gap-3">
                      <div class="flex-shrink-0 w-9 h-9 rounded-xl bg-gradient-to-br from-ateliya-primary/15 to-ateliya-primary/5 flex items-center justify-center">
                        <span class="text-sm font-black text-ateliya-primary">{String(idx + 1).padStart(2, "0")}</span>
                      </div>
                      <span class="font-bold text-gray-900 text-base">{item.question}</span>
                    </div>
                    <div class="faq-chevron flex-shrink-0 w-8 h-8 rounded-full bg-gray-50 flex items-center justify-center transition-all duration-300">
                      <Icon name="chevron-down" size="sm" class="text-gray-400 transition-transform duration-300" />
                    </div>
                  </button>

                  <div class="faq-answer">
                    <div class="pt-3 pl-12 text-gray-500 leading-relaxed text-sm">
                      {item.answer}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================
         CTA FINAL
         ============================================ -->
    <section class="relative py-12 px-8 lg:px-12 mx-6 lg:mx-12 mb-14 rounded-3xl overflow-hidden bg-gradient-to-br from-teal-50/55 via-white to-amber-50/[0.18] border border-ateliya-border/[0.55] shadow-[0_16px_44px_rgba(18,63,59,0.045)]">

      <div class="absolute right-0 top-0 w-[40%] h-[60%] bg-gradient-to-bl from-ateliya-primary/[0.03] to-transparent rounded-bl-[80px]"></div>
      <div class="absolute top-[10%] right-[20%] w-56 h-56 bg-ateliya-primary/[0.035] rounded-full blur-[100px]"></div>
      <div class="absolute bottom-[10%] left-[15%] w-48 h-48 bg-ateliya-secondary/[0.025] rounded-full blur-[80px]"></div>
      <div class="absolute inset-0 opacity-[0.014]" style="background-image: radial-gradient(circle, #2FAFA4 1px, transparent 1px); background-size: 32px 32px;"></div>

      <div class="relative z-10 text-center max-w-2xl mx-auto space-y-5">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-ateliya-primary/10 rounded-full">
          <Icon name="rocket" size="sm" class="text-ateliya-primary" />
          <span class="text-sm font-bold text-ateliya-primary">Besoin d'aide ?</span>
        </div>

        <h2 class="text-3xl md:text-4xl lg:text-5xl font-serif font-extrabold tracking-tighter leading-tight text-gray-900">
          <span class="block">Une question</span>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-ateliya-secondary to-ateliya-primary">
            avant de vous lancer ?
          </span>
        </h2>

        <p class="text-lg text-gray-500 leading-relaxed max-w-lg mx-auto tracking-wide">
          Notre equipe est disponible pour vous accompagner dans le choix de votre formule.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-1">
          <a href="/contact" class="group relative overflow-hidden inline-flex items-center justify-center gap-3 px-7 py-3.5 rounded-2xl bg-gradient-to-r from-ateliya-primary to-ateliya-secondary text-white font-bold shadow-[0_12px_28px_rgba(47,175,164,0.16)] hover:shadow-[0_16px_34px_rgba(47,175,164,0.2)] transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98]">
            <span class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/15 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700"></span>
            <Icon name="mail" size="md" class="relative z-10" />
            <span class="relative z-10">Nous contacter</span>
          </a>
        </div>
      </div>
    </section>

  </div>

  <Footer />
</Layout>

<style>
  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-item.is-open .faq-answer {
    max-height: 300px;
  }

  .faq-item.is-open .faq-item-card {
    border-color: rgba(52, 199, 184, 0.25);
  }

  .faq-item.is-open .faq-chevron {
    background: rgba(52, 199, 184, 0.1);
  }

  .faq-item.is-open .faq-chevron :global(svg) {
    transform: rotate(180deg);
    color: #2FAFA4;
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".faq-item button").forEach((btn) => {
      btn.addEventListener("click", () => {
        const item = btn.closest(".faq-item");
        if (!item) return;

        const wasOpen = item.classList.contains("is-open");

        document.querySelectorAll(".faq-item").forEach((i) => {
          i.classList.remove("is-open");
          i.querySelector("button")?.setAttribute("aria-expanded", "false");
        });

        if (!wasOpen) {
          item.classList.add("is-open");
          btn.setAttribute("aria-expanded", "true");
        }
      });
    });
  });
</script>
