---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import StitchDivider from "../components/ui/StitchDivider.astro";
import Icon from "../components/ui/Icon.astro";
import PricingSection from "../components/islands/PricingSection";

const TRUST_BADGES = [
  { icon: "check" as const, text: "Forfaits selon votre pays" },
  { icon: "receipt" as const, text: "Paiement mobile disponible" },
  { icon: "shield" as const, text: "Paiement sécurisé" },
];

const FAQ = [
  {
    question: "Les tarifs sont-ils les mêmes dans tous les pays ?",
    answer:
      "Les forfaits affichés dépendent du pays sélectionné. Choisissez votre pays au-dessus des offres pour consulter les tarifs correspondants.",
  },
  {
    question: "Quels moyens de paiement sont disponibles ?",
    answer:
      "Les moyens proposés comprennent Orange Money, MTN Mobile Money, Moov Money et Wave. Les options disponibles peuvent varier selon le pays.",
  },
  {
    question: "Puis-je changer de forfait ?",
    answer:
      "Les forfaits disponibles sont présentés dans l'application. Pour vous aider à choisir, contactez l'équipe Ateliya.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<BaseLayout
  title="Tarifs — Ateliya"
  description="Consultez les forfaits Ateliya pour votre atelier de couture et choisissez l'offre adaptée à vos besoins. Paiement sécurisé via Mobile Money."
>
  <Header />
  <main class="flex-1">
    {/* ---------------------------- Intro ----------------------------
        Bandeau vert foncé (comme le CTA final et les cartes de tarifs) :
        donne du poids à la page sans animation ni photo — on reste sobre
        et crédible, c'est une page transactionnelle. */}
    <section class="relative overflow-hidden bg-primary-dark px-5 pt-32 pb-14 text-center sm:pt-40 sm:pb-20">
      <div
        class="pointer-events-none absolute top-0 left-1/2 h-[28rem] w-[28rem] -translate-x-1/2 -translate-y-1/3 rounded-full bg-gold/10 blur-[110px]"
        aria-hidden="true"
      >
      </div>

      <div class="relative mx-auto max-w-3xl">
        <div class="mb-6 flex justify-center">
          <span
            class="flex h-14 w-14 items-center justify-center rounded-full bg-gold text-primary-dark"
          >
            <Icon name="receipt" class="h-7 w-7" />
          </span>
        </div>
        <StitchDivider class="mb-7" />
        <p class="text-xs font-bold tracking-[0.2em] text-gold-light uppercase">
          Tarifs Ateliya
        </p>
        <h1 class="mt-5 font-serif text-4xl leading-tight tracking-tight text-white sm:text-6xl">
          Une formule adaptée à votre atelier.
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-7 text-white/80 sm:text-lg">
          Comparez les offres disponibles pour votre pays et choisissez les
          outils qui correspondent à votre activité.
        </p>
      </div>
    </section>

    {/* ------------------------ Forfaits (îlot) ------------------------ */}
    <section class="bg-card px-5 py-8 sm:py-12">
      <div class="mx-auto max-w-6xl">
        <PricingSection client:load initialPays={[]} initialModules={[]} />
      </div>
    </section>

    {/* --------------------------- Confiance --------------------------- */}
    <section class="border-y border-border/70 bg-background px-5 py-8 sm:py-10">
      <div class="mx-auto grid max-w-5xl gap-5 sm:grid-cols-3">
        {
          TRUST_BADGES.map((badge) => (
            <div class="flex items-center justify-center gap-3 text-sm font-medium text-text-secondary">
              <Icon name={badge.icon} class="h-[18px] w-[18px] text-primary" />
              {badge.text}
            </div>
          ))
        }
      </div>
    </section>

    {/* ------------------------------ FAQ ------------------------------ */}
    <section class="bg-card px-5 py-16 sm:py-20">
      <div class="mx-auto max-w-3xl">
        <header class="mb-10 text-center">
          <p class="text-xs font-bold tracking-[0.2em] text-primary uppercase">
            Questions fréquentes
          </p>
          <h2 class="mt-3 font-serif text-3xl text-text sm:text-4xl">
            Questions sur les tarifs ?
          </h2>
        </header>

        <div class="space-y-3">
          {
            FAQ.map((item) => (
              <details class="group rounded-2xl border border-border/70 bg-background px-5 open:shadow-[0_20px_50px_-40px_rgba(7,31,20,0.4)]">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium text-text [&::-webkit-details-marker]:hidden">
                  {item.question}
                  <Icon
                    name="plus"
                    class="h-[18px] w-[18px] shrink-0 text-primary transition-transform duration-200 group-[[open]]:rotate-45"
                    strokeWidth={2.2}
                  />
                </summary>
                <p class="pb-5 text-sm leading-7 text-text-secondary">
                  {item.answer}
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</BaseLayout>
