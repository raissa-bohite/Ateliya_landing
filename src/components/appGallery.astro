---
import Icon from "../components/Icon.astro";
import { galleryItems } from "../data/data";
---

<section
  id="gallery"
  class="relative py-24 lg:py-28 overflow-hidden bg-gradient-to-br from-teal-50/60 via-white to-amber-50/20"
>
  <!-- ---- Background Decorations ---- -->

  <!-- Large shape blob -->
  <div
    class="absolute left-0 top-0 w-[45%] h-[65%] bg-gradient-to-br from-ateliya-primary/4 to-transparent rounded-br-[100px]"
  ></div>

  <!-- Gradient orbs -->
  <div
    class="absolute top-[10%] left-[20%] w-72 h-72 bg-ateliya-primary/6 rounded-full blur-[120px]"
  ></div>
  <div
    class="absolute bottom-[10%] right-[15%] w-60 h-60 bg-ateliya-secondary/5 rounded-full blur-[100px]"
  ></div>

  <!-- Radial dot bg -->
  <div
    class="absolute inset-0 opacity-[0.025]"
    style="background-image: radial-gradient(circle, #2FAFA4 1px, transparent 1px); background-size: 36px 36px;"
  ></div>

  <!-- Dot grid top-right -->
  <div class="absolute right-8 top-[10%] grid grid-cols-6 gap-2 opacity-30">
    {
      [...Array(24)].map((_, i) => (
        <div
          class={`w-1.5 h-1.5 rounded-full ${i % 4 === 0 ? "bg-ateliya-primary" : i % 4 === 1 ? "bg-ateliya-secondary/50" : i % 4 === 2 ? "bg-ateliya-secondary/20" : "bg-gray-300"}`}
        />
      ))
    }
  </div>

  <!-- Dot grid bottom-left -->
  <div class="absolute left-10 bottom-[8%] grid grid-cols-5 gap-3 opacity-20">
    {
      [...Array(15)].map((_, i) => (
        <div
          class={`w-2 h-2 rounded-full ${i % 2 === 0 ? "bg-ateliya-primary/40" : "bg-ateliya-secondary/25"}`}
        />
      ))
    }
  </div>

  <!-- ---- Content ---- -->
  <div class="container mx-auto px-6 lg:px-12 relative z-10">
    <!-- Header -->
    <div class="text-center mb-14">
      <div
        class="inline-flex items-center gap-2 px-4 py-2 bg-ateliya-primary/10 rounded-full mb-5"
      >
        <Icon name="image" size="sm" class="text-ateliya-primary" />
        <span class="text-sm font-bold text-ateliya-primary">Apercu</span>
      </div>

      <h2
        class="text-3xl md:text-4xl lg:text-5xl font-black text-gray-900 leading-tight mb-4"
      >
        Decouvrez l'
        <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-ateliya-primary via-teal-400 to-ateliya-secondary"
        >
          Application
        </span> Ateliya
      </h2>

      <p class="text-lg text-gray-500 max-w-xl mx-auto leading-relaxed">
        Interface intuitive et puissante pour gerer tous les aspects de votre
        atelier avec fluidite
      </p>
    </div>
  </div>

  <!-- Gallery Carousel (constrained width) -->
  <div class="max-w-6xl mx-auto px-6 lg:px-10">
    <div class="relative">
      <!-- Fade edges -->
      <div
        class="absolute left-0 top-0 bottom-0 w-20 lg:w-32 bg-gradient-to-r from-teal-50/80 via-teal-50/40 to-transparent z-10 pointer-events-none"
      ></div>
      <div
        class="absolute right-0 top-0 bottom-0 w-20 lg:w-32 bg-gradient-to-l from-white/80 via-white/40 to-transparent z-10 pointer-events-none"
      ></div>

      <!-- Scrollable track -->
      <div
        id="gallery-scroll"
        class="overflow-x-auto scrollbar-hide py-4"
      >
        <div
          id="gallery-track"
          class="flex gap-5"
          style="width: fit-content;"
        >
        {
          galleryItems.slice(0, 6).map((item, idx) => (
            <div
              class="gallery-card group relative flex-shrink-0 w-[276px] h-[552px] rounded-[2.75rem] overflow-visible transition-all duration-300 hover:-translate-y-2"
              style={`animation-delay: ${idx * 80}ms`}
            >
              {/* Phone Mockup Structure (Matches Hero) */}
              <div class="relative w-full h-full bg-gray-900 rounded-[2.75rem] p-2.5 shadow-2xl">
                {/* Screen Container */}
                <div class="relative w-full h-full bg-white rounded-[2.25rem] overflow-hidden">
                  {/* Notch */}
                  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-28 h-6 bg-gray-900 rounded-b-3xl z-20"></div>
                  
                  {item.image ? (
                    <img
                      src={item.image}
                      alt={item.label}
                      class="w-full h-full object-cover"
                      loading="lazy"
                      width="390"
                      height="844"
                      decoding="async"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center bg-gray-50">
                      <Icon
                        name={item.icon || "image"}
                        size="2xl"
                        class="text-ateliya-primary/50"
                      />
                    </div>
                  )}

                  {/* Text Overlay - keeping it subtle at the bottom or hidden? 
                      The user wants it like the hero, hero has no text overlay on the phone itself.
                      But the gallery cardHAD text. I will keep the text overlay but make it respect the rounded corners.
                  */}
                  <div class="absolute inset-0 bg-gradient-to-t from-gray-900/90 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10"></div>
                  
                  <div class="absolute bottom-0 left-0 right-0 p-6 z-20 translate-y-4 group-hover:translate-y-0 opacity-0 group-hover:opacity-100 transition-all duration-300">
                    <p class="text-white font-bold text-xl mb-1">{item.label}</p>
                    <p class="text-white/80 text-sm leading-relaxed">
                      {item.description}
                    </p>
                  </div>
                </div>
              </div>
            </div>
          ))
        }

        {/* Duplicate for infinite scroll illusion */}
          {
          galleryItems.slice(0, 6).map((item, idx) => (
            <div
              class="gallery-card group relative flex-shrink-0 w-[276px] h-[552px] rounded-[2.75rem] overflow-visible transition-all duration-300 hover:-translate-y-2"
              aria-hidden="true"
            >
              <div class="relative w-full h-full bg-gray-900 rounded-[2.75rem] p-2.5 shadow-2xl">
                <div class="relative w-full h-full bg-white rounded-[2.25rem] overflow-hidden">
                  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-28 h-6 bg-gray-900 rounded-b-3xl z-20"></div>
                  
                  {item.image ? (
                    <img
                      src={item.image}
                      alt=""
                      class="w-full h-full object-cover"
                      loading="lazy"
                      width="390"
                      height="844"
                      decoding="async"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center bg-gray-50">
                      <Icon
                        name={item.icon || "image"}
                        size="2xl"
                        class="text-ateliya-primary/50"
                      />
                    </div>
                  )}

                  <div class="absolute inset-0 bg-gradient-to-t from-gray-900/90 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10"></div>
                  
                  <div class="absolute bottom-0 left-0 right-0 p-6 z-20 translate-y-4 group-hover:translate-y-0 opacity-0 group-hover:opacity-100 transition-all duration-300">
                    <p class="text-white font-bold text-xl mb-1">{item.label}</p>
                    <p class="text-white/80 text-sm leading-relaxed">
                      {item.description}
                    </p>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Navigation arrows -->
    <div class="container mx-auto px-6 lg:px-12 relative z-20">
      <div class="flex items-center justify-center gap-3 mt-8">
        <button
          id="gallery-prev"
          class="w-11 h-11 rounded-full bg-white border border-gray-200 flex items-center justify-center hover:border-ateliya-primary/40 hover:shadow-md transition-all duration-300 hover:scale-105"
          aria-label="Precedent"
        >
          <Icon name="chevron-left" size="sm" class="text-gray-600" />
        </button>

        <!-- Progress dots -->
        <div class="flex items-center gap-1.5 px-3" id="gallery-dots">
          {
            galleryItems.slice(0, 6).map((_, i) => (
              <div
                class={`gallery-dot rounded-full transition-all duration-300 ${i === 0 ? "w-6 h-2 bg-ateliya-primary" : "w-2 h-2 bg-gray-300"}`}
              />
            ))
          }
        </div>

        <button
          id="gallery-next"
          class="w-11 h-11 rounded-full bg-gradient-to-r from-ateliya-primary to-ateliya-secondary text-white flex items-center justify-center hover:shadow-lg hover:shadow-ateliya-primary/25 transition-all duration-300 hover:scale-105"
          aria-label="Suivant"
        >
          <Icon name="chevron-right" size="sm" class="text-white" />
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  function initGallery() {
    const scrollContainer = document.getElementById("gallery-scroll");
    const track = document.getElementById("gallery-track");
    const prevBtn = document.getElementById("gallery-prev");
    const nextBtn = document.getElementById("gallery-next");
    const dots = document.querySelectorAll(".gallery-dot");

    if (!scrollContainer || !track) return;

    const cards = track.querySelectorAll(".gallery-card");
    const totalOriginal = cards.length / 2;
    const getCardWidth = () => {
      const card = cards[0];
      if (!card) return 296; // 276 width + 20 gap
      return card.offsetWidth + 20;
    };

    let autoScrollId: number | null = null;
    let isHovering = false;

    const updateDots = () => {
      const cardWidth = getCardWidth();
      const currentIndex =
        Math.round(scrollContainer.scrollLeft / cardWidth) % totalOriginal;

      dots.forEach((dot, i) => {
        if (i === currentIndex) {
          dot.classList.remove("w-2", "h-2", "bg-gray-300");
          dot.classList.add("w-6", "h-2", "bg-ateliya-primary");
        } else {
          dot.classList.remove("w-6", "bg-ateliya-primary");
          dot.classList.add("w-2", "h-2", "bg-gray-300");
        }
      });
    };

    const scrollByCard = (direction: number) => {
      const cardWidth = getCardWidth();
      scrollContainer.scrollBy({
        left: cardWidth * direction,
        behavior: "smooth",
      });
    };

    const resetScrollIfNeeded = () => {
      const cardWidth = getCardWidth();
      const halfPoint = cardWidth * totalOriginal;

      if (scrollContainer.scrollLeft >= halfPoint) {
        scrollContainer.scrollLeft -= halfPoint;
      }
      if (scrollContainer.scrollLeft <= 0 && totalOriginal > 0) {
        scrollContainer.scrollLeft += halfPoint;
      }
    };

    const startAutoScroll = () => {
      if (autoScrollId) return;
      autoScrollId = window.setInterval(() => {
        if (isHovering) return;
        scrollContainer.scrollLeft += 1;
        resetScrollIfNeeded();
        updateDots();
      }, 30);
    };

    const stopAutoScroll = () => {
      if (autoScrollId) {
        clearInterval(autoScrollId);
        autoScrollId = null;
      }
    };

    scrollContainer.addEventListener("mouseenter", () => {
      isHovering = true;
    });
    scrollContainer.addEventListener("mouseleave", () => {
      isHovering = false;
    });

    prevBtn?.addEventListener("click", () => {
      stopAutoScroll();
      scrollByCard(-1);
      setTimeout(() => {
        resetScrollIfNeeded();
        updateDots();
        startAutoScroll();
      }, 400);
    });

    nextBtn?.addEventListener("click", () => {
      stopAutoScroll();
      scrollByCard(1);
      setTimeout(() => {
        resetScrollIfNeeded();
        updateDots();
        startAutoScroll();
      }, 400);
    });

    scrollContainer.addEventListener("scroll", () => {
      updateDots();
    }, { passive: true });

    startAutoScroll();
  }

  document.addEventListener("DOMContentLoaded", initGallery);
  document.addEventListener("astro:page-load", initGallery);
</script>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
    scroll-behavior: auto;
  }

  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }

  .gallery-card {
    animation: galleryCardIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes galleryCardIn {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(12px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-card {
      animation: none;
    }
  }
</style>
