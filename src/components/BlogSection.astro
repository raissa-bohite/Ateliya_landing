---
import Icon from "../components/Icon.astro";
import Button from "../components/Button.astro";
import { blogPosts } from "../data/data";
import "../styles/global.css";
---

<section class="section-padding-xl bg-[#D4F1F0] relative overflow-hidden">
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-ateliya-primary/8 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/3 -right-32 w-80 h-80 bg-ateliya-light/6 rounded-full blur-3xl"></div>
  </div>

   <div class="absolute inset-0 pointer-events-none opacity-[0.02]" style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 1200 600%22><defs><pattern id=%22features-pattern%22 patternUnits=%22userSpaceOnUse%22 width=%22120%22 height=%22120%22><circle cx=%2260%22 cy=%2260%22 r=%222%22 fill=%22%230D6B5F%22/><circle cx=%2290%22 cy=%2290%22 r=%221%22 fill=%22%23D4AF37%22/><line x1=%2260%22 y1=%2260%22 x2=%2290%22 y2=%2290%22 stroke=%22%2334C7B8%22 stroke-width=%220.5%22/></pattern></defs><rect width=%221200%22 height=%22600%22 fill=%22url(%23features-pattern)%22/></svg>');"></div>
<div
    class="absolute inset-0 pointer-events-none opacity-[0.03]"
    style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 1200 600%22><defs><pattern id=%22etapes-pattern%22 patternUnits=%22userSpaceOnUse%22 width=%22100%22 height=%22100%22><path d=%22M50,0 Q75,25 50,50 Q25,75 0,50 Q25,25 50,0%22 fill=%22none%22 stroke=%22%230D6B5F%22 stroke-width=%220.5%22/></pattern></defs><rect width=%221200%22 height=%22600%22 fill=%22url(%23etapes-pattern)%22/></svg>');"
  >
  </div>

  <div class="absolute inset-0 pointer-events-none opacity-50" style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 1200 600%22><defs><pattern id=%22blog-pattern%22 patternUnits=%22userSpaceOnUse%22 width=%22100%22 height=%22100%22><circle cx=%2250%22 cy=%2250%22 r=%222%22 fill=%22rgba(52,199,184,0.03)%22/><path d=%22M50,0 L100,50 L50,100 L0,50 Z%22 fill=%22none%22 stroke=%22rgba(52,199,184,0.02)%22 stroke-width=%220.5%22/></pattern></defs><rect width=%221200%22 height=%22600%22 fill=%22url(%23blog-pattern)%22/></svg>');"></div>

  <div class="container-wide relative z-10">
    <!-- Header Section -->
    <div class="text-center mb-16 md:mb-24 animate-fade-in">
      <div class="inline-block mb-4 px-4 py-2 rounded-full bg-ateliya-primary/10 backdrop-blur-md border border-ateliya-primary/30 animate-slide-down" style="animation-delay: 100ms;">
        <span class="text-sm font-semibold text-ateliya-primary">Ressources & Actualités</span>
      </div>
      
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-black mb-6 leading-tight text-ateliya-dark">
        Actualités & <span class="text-ateliya-primary">Conseils</span> 
      </h2>
      <p class="text-lg md:text-xl text-ateliya-text-light max-w-3xl mx-auto leading-relaxed">
        Restez informé des dernières tendances et astuces pour optimiser votre atelier et maximiser votre rentabilité
      </p>
    </div>

    <!-- Blog Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
      {
        blogPosts.map((post, i) => (
          <article
            class="animate-scale-in group"
            style={{ animationDelay: `${i * 100}ms` }}
          >
            <div class="h-full rounded-2xl overflow-hidden bg-white/50 backdrop-blur-xl border border-ateliya-primary/15 hover:border-ateliya-primary/40 transition-all duration-300 hover:shadow-medium hover:bg-white/70 flex flex-col relative">
              
              <!-- Featured Image Container -->
              <div class="relative h-56 bg-gradient-to-br from-ateliya-bg-light to-white overflow-hidden group-hover:scale-110 transition-transform duration-300">
                <!-- Image -->
                {post.image ? (
                  <img 
                    src={post.image} 
                    alt={post.title}
                    class="w-full h-full object-cover group-hover:brightness-110 transition-all duration-300"
                  />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-ateliya-primary/20 to-ateliya-secondary/10 flex items-center justify-center">
                    <div class="p-6 rounded-xl bg-ateliya-primary/12 backdrop-blur-md border border-ateliya-primary/25 group-hover:bg-ateliya-primary/20 group-hover:border-ateliya-primary/40 transition-all duration-300">
                      <Icon 
                        name={post.icon} 
                        size="2xl" 
                        color="currentColor" 
                        class="text-ateliya-primary" 
                      />
                    </div>
                  </div>
                )}

                <!-- Overlay Gradient au Hover -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>

                <!-- Shine Effect -->
                <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/0 to-transparent group-hover:via-white/20 transition-all duration-300 pointer-events-none opacity-0 group-hover:opacity-100"></div>

                <!-- Category Badge Overlay -->
                <div class="absolute top-3 right-3 px-3 py-1 rounded-full text-xs font-bold bg-ateliya-primary/90 backdrop-blur-md text-white opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
                  {post.category}
                </div>
              </div>

              <!-- Content -->
              <div class="flex-1 p-6 md:p-8 flex flex-col">
                <!-- Meta Info -->
                <div class="flex items-center gap-2 mb-4 pb-4 border-b border-ateliya-primary/10">
                  <span class="text-xs text-ateliya-text-light font-medium">{post.date}</span>
                </div>

                <!-- Title -->
                <h3 class="text-lg md:text-xl font-bold text-ateliya-text mb-3 line-clamp-2 group-hover:text-ateliya-primary transition-colors duration-300 leading-tight">
                  {post.title}
                </h3>

                <!-- Description -->
                <p class="text-ateliya-text-light text-sm leading-relaxed mb-6 line-clamp-2 flex-1">
                  {post.description}
                </p>

                <!-- Read More Link -->
                <a
                  href="#"
                  class="inline-flex items-center gap-2 text-ateliya-primary font-semibold text-sm group-hover:gap-3 transition-all duration-300 hover:text-ateliya-light"
                >
                  <span>Lire Plus</span>
                  <Icon name="arrowRight" size="sm" color="currentColor" class="group-hover:translate-x-1 transition-transform duration-300" />
                </a>

                <!-- Bottom Accent Line -->
                <div class="absolute bottom-0 left-0 h-1 w-0 bg-gradient-to-r from-ateliya-primary via-ateliya-light to-transparent group-hover:w-full transition-all duration-500 rounded-full"></div>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- CTA Section -->
    <div class="mt-20 relative rounded-2xl overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-r from-ateliya-primary/5 to-ateliya-light/3 group-hover:from-ateliya-primary/10 group-hover:to-ateliya-light/5 transition-all duration-300"></div>
      
      <div class="absolute inset-0 backdrop-blur-lg" style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 200%22><defs><pattern id=%22blog-banner-pattern%22 patternUnits=%22userSpaceOnUse%22 width=%22100%22 height=%22100%22><circle cx=%2250%22 cy=%2250%22 r=%222%22 fill=%22rgba(52,199,184,0.03)%22/><line x1=%220%22 y1=%2250%22 x2=%22100%22 y2=%2250%22 stroke=%22rgba(52,199,184,0.02)%22 stroke-width=%220.5%22/></pattern></defs><rect width=%22400%22 height=%22200%22 fill=%22url(%23blog-banner-pattern)%22/></svg>');"></div>

      <div class="relative z-10 p-8 md:p-16 bg-white/40 backdrop-blur-xl border border-white/20 flex flex-col md:flex-row items-center justify-between gap-8 md:gap-12 rounded-2xl group">
        <div class="flex-1">
          <h3 class="text-2xl md:text-3xl lg:text-4xl font-black text-ateliya-text mb-4 leading-tight">
            Explorez notre <span class="text-gradient-primary">Blog Complet</span>
          </h3>
          <p class="text-lg text-ateliya-text-light mb-6 md:mb-0">
            Découvrez des centaines d'articles, tutoriels et guides pour maîtriser Ateliya
          </p>
        </div>
        <div class="flex-shrink-0">
          <Button variant="primary" size="lg" href="#blog" class="inline-flex items-center gap-3 group whitespace-nowrap">
            <span class="text-base md:text-lg">Voir Tous les Articles</span>
            <Icon name="arrowRight" size="md" class="group-hover:translate-x-1 transition-transform duration-300" />
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 768px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>